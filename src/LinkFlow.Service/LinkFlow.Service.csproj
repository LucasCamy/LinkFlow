<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OutputType>Exe</OutputType>
    <AssemblyName>LinkFlow.Service</AssemblyName>
    <RootNamespace>LinkFlow.Service</RootNamespace>
    <Product>LinkFlow</Product>
    <Version>2.0.0</Version>
    <Description>LinkFlow - serviço do Windows que controla ventoinhas, RGB e LCD</Description>
    <ApplicationIcon>..\LinkFlow.App\Assets\linkflow.ico</ApplicationIcon>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.1" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LinkFlow.Core\LinkFlow.Core.csproj" />
  </ItemGroup>

</Project>
