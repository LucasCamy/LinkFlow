<Window x:Class="LinkFlow.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:LinkFlow.App.Views"
        Title="LinkFlow"
        Width="1180" Height="820" MinWidth="720" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource UiFont}"
        UseLayoutRounding="True"
        Icon="pack://application:,,,/Assets/linkflow.ico">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.InputBindings>
        <KeyBinding Key="D1" Modifiers="Control" Command="{Binding NavigateCommand}" CommandParameter="0"/>
        <KeyBinding Key="D2" Modifiers="Control" Command="{Binding NavigateCommand}" CommandParameter="1"/>
        <KeyBinding Key="D3" Modifiers="Control" Command="{Binding NavigateCommand}" CommandParameter="2"/>
        <KeyBinding Key="D4" Modifiers="Control" Command="{Binding NavigateCommand}" CommandParameter="3"/>
        <KeyBinding Key="D5" Modifiers="Control" Command="{Binding NavigateCommand}" CommandParameter="4"/>
        <KeyBinding Key="D6" Modifiers="Control" Command="{Binding NavigateCommand}" CommandParameter="5"/>
        <KeyBinding Key="D7" Modifiers="Control" Command="{Binding NavigateCommand}" CommandParameter="6"/>
        <KeyBinding Key="D8" Modifiers="Control" Command="{Binding NavigateCommand}" CommandParameter="7"/>
        <KeyBinding Key="D9" Modifiers="Control" Command="{Binding NavigateCommand}" CommandParameter="8"/>
        <KeyBinding Key="OemComma" Modifiers="Control" Command="{Binding NavigateCommand}" CommandParameter="5"/>
        <KeyBinding Key="F1" Command="{Binding ApplyPresetCommand}" CommandParameter="1"/>
        <KeyBinding Key="F2" Command="{Binding ApplyPresetCommand}" CommandParameter="2"/>
        <KeyBinding Key="F3" Command="{Binding ApplyPresetCommand}" CommandParameter="3"/>
        <KeyBinding Key="F4" Command="{Binding ApplyPresetCommand}" CommandParameter="4"/>
        <KeyBinding Key="F5" Command="{Binding ApplyPresetCommand}" CommandParameter="5"/>
        <KeyBinding Key="Up" Modifiers="Control" Command="{Binding GlobalStepCommand}" CommandParameter="5"/>
        <KeyBinding Key="Down" Modifiers="Control" Command="{Binding GlobalStepCommand}" CommandParameter="-5"/>
        <KeyBinding Key="Z" Modifiers="Control" Command="{Binding UndoCommand}"/>
        <KeyBinding Key="L" Modifiers="Control" Command="{Binding TransmitLcdCommand}"/>
    </Window.InputBindings>

    <Border x:Name="RootBorder" BorderBrush="{StaticResource BorderBrush}" Background="{StaticResource BgBrush}">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="0"/>
                <Style.Triggers>
                    <!-- Maximizada com WindowChrome: compensa a borda que fica fora da tela -->
                    <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Padding" Value="7"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ======================================================== Barra de título -->
            <Grid Grid.Row="0" Background="{StaticResource BgBrush}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
                    <Image Source="pack://application:,,,/Assets/linkflow.png" Width="20" Height="20" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text="LinkFlow" FontWeight="SemiBold" FontSize="13.5" Margin="10,0,0,0" VerticalAlignment="Center"/>
                    <TextBlock Text="/" Foreground="{StaticResource TextSubtleBrush}" Margin="10,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding PageTitle}" Foreground="{StaticResource TextMutedBrush}" FontSize="13" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource GhostButton}" Content="Atualização disponível" Click="ShowAppUpdates_Click"
                            Visibility="{Binding Updates.HasUpdate, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}"
                            Foreground="{StaticResource AccentBrush}" Margin="0,0,6,0"/>
                    <Button Style="{StaticResource GhostButton}" Click="OpenAlertHistory_Click"
                            Visibility="{Binding AlertCenter.HasHistory, Converter={StaticResource BoolToVis}}" Margin="0,0,6,0"
                            ToolTip="Histórico de alertas" AutomationProperties.Name="Histórico de alertas">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE81C;" FontSize="14" Foreground="{StaticResource TextMutedBrush}"/>
                            <TextBlock Text="{Binding AlertCenter.PendingCount}" Margin="6,0,0,0" FontWeight="SemiBold"
                                       Foreground="{Binding AlertCenter.Top.Severity, Converter={StaticResource SeverityToBrush}}"
                                       Visibility="{Binding AlertCenter.HasPending, Converter={StaticResource BoolToVis}}"/>
                        </StackPanel>
                    </Button>

                    <Border Background="{StaticResource SurfaceAltBrush}" CornerRadius="10" Padding="10,3" Margin="0,0,8,0" VerticalAlignment="Center"
                            ToolTip="Onde o controle do hardware está rodando">
                        <TextBlock Text="{Binding EngineModeLabel}" FontSize="11.5" Foreground="{StaticResource TextMutedBrush}"/>
                    </Border>

                    <Button Style="{StaticResource CaptionButton}" Content="&#xE8A7;" Click="ToggleMiniWidget_Click"
                            ToolTip="Mini widget sempre visível (Ctrl+M)" AutomationProperties.Name="Mini widget"/>
                    <Button Style="{StaticResource CaptionButton}" Content="&#xE921;" Click="MinimizeButton_Click"
                            ToolTip="Minimizar" AutomationProperties.Name="Minimizar"/>
                    <Button x:Name="MaxButton" Style="{StaticResource CaptionButton}" Content="&#xE922;" Click="MaximizeButton_Click"
                            ToolTip="Maximizar" AutomationProperties.Name="Maximizar"/>
                    <Button Style="{StaticResource CloseCaptionButton}" Content="&#xE8BB;" Click="CloseButton_Click" Margin="0,0,4,0"
                            ToolTip="Fechar (continua na bandeja)" AutomationProperties.Name="Fechar"/>
                </StackPanel>
            </Grid>

            <!-- ======================================================== Corpo -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Navegação -->
                <Border x:Name="Sidebar" Padding="10,8,10,10">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Width" Value="210"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsCompact}" Value="True">
                                    <Setter Property="Width" Value="64"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <DockPanel LastChildFill="False">
                        <DockPanel.Resources>
                            <Style x:Key="NavLabel" TargetType="TextBlock">
                                <Setter Property="Margin" Value="14,0,0,0"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="FontSize" Value="13.5"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCompact}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DockPanel.Resources>

                        <StackPanel DockPanel.Dock="Top">
                            <RadioButton Style="{StaticResource NavItem}" ToolTip="Painel (Ctrl+1)" AutomationProperties.Name="Painel"
                                         IsChecked="{Binding SelectedPage, Converter={StaticResource EqualsConverter}, ConverterParameter=0}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE80F;"/>
                                    <TextBlock Style="{StaticResource NavLabel}" Text="Painel"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton Style="{StaticResource NavItem}" ToolTip="Ventoinhas (Ctrl+2)" AutomationProperties.Name="Ventoinhas"
                                         IsChecked="{Binding SelectedPage, Converter={StaticResource EqualsConverter}, ConverterParameter=1}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xEC4A;"/>
                                    <TextBlock Style="{StaticResource NavLabel}" Text="Ventoinhas"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton Style="{StaticResource NavItem}" ToolTip="Iluminação RGB (Ctrl+3)" AutomationProperties.Name="Iluminação"
                                         IsChecked="{Binding SelectedPage, Converter={StaticResource EqualsConverter}, ConverterParameter=2}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE790;"/>
                                    <TextBlock Style="{StaticResource NavLabel}" Text="Iluminação"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton Style="{StaticResource NavItem}" ToolTip="Tela LCD (Ctrl+4)" AutomationProperties.Name="Tela LCD"
                                         IsChecked="{Binding SelectedPage, Converter={StaticResource EqualsConverter}, ConverterParameter=3}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE7F4;"/>
                                    <TextBlock Style="{StaticResource NavLabel}" Text="Tela LCD"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton Style="{StaticResource NavItem}" ToolTip="Widget flutuante (Ctrl+5)" AutomationProperties.Name="Widget"
                                         IsChecked="{Binding SelectedPage, Converter={StaticResource EqualsConverter}, ConverterParameter=4}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE8A7;"/>
                                    <TextBlock Style="{StaticResource NavLabel}" Text="Widget"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton Style="{StaticResource NavItem}" ToolTip="Hardware (Ctrl+7)" AutomationProperties.Name="Hardware"
                                         IsChecked="{Binding SelectedPage, Converter={StaticResource EqualsConverter}, ConverterParameter=6}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE950;"/>
                                    <TextBlock Style="{StaticResource NavLabel}" Text="Hardware"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton Style="{StaticResource NavItem}" ToolTip="Desempenho do Windows (Ctrl+8)" AutomationProperties.Name="Windows"
                                         IsChecked="{Binding SelectedPage, Converter={StaticResource EqualsConverter}, ConverterParameter=7}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xECAA;"/>
                                    <TextBlock Style="{StaticResource NavLabel}" Text="Windows"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton Style="{StaticResource NavItem}" ToolTip="Drivers (Ctrl+9)" AutomationProperties.Name="Drivers"
                                         IsChecked="{Binding SelectedPage, Converter={StaticResource EqualsConverter}, ConverterParameter=8}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE896;"/>
                                    <TextBlock Style="{StaticResource NavLabel}" Text="Drivers"/>
                                </StackPanel>
                            </RadioButton>
                        </StackPanel>

                        <RadioButton DockPanel.Dock="Bottom" Style="{StaticResource NavItem}" ToolTip="Configurações (Ctrl+6)" AutomationProperties.Name="Configurações"
                                     IsChecked="{Binding SelectedPage, Converter={StaticResource EqualsConverter}, ConverterParameter=5}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE713;"/>
                                <TextBlock Style="{StaticResource NavLabel}" Text="Configurações"/>
                            </StackPanel>
                        </RadioButton>

                        <!-- Resumo do perfil ativo -->
                        <Border DockPanel.Dock="Bottom" Background="{StaticResource SurfaceBrush}" CornerRadius="10" Padding="12,10" Margin="0,0,0,10"
                                Visibility="{Binding IsCompact, Converter={StaticResource BoolToVisInverse}}">
                            <StackPanel>
                                <TextBlock Text="PERFIL ATIVO" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextSubtleBrush}"/>
                                <TextBlock Text="{Binding ActivePresetLabel}" FontWeight="SemiBold" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding CurveStatus}" Style="{StaticResource Caption}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>
                    </DockPanel>
                </Border>

                <!-- Páginas -->
                <Grid x:Name="PageHost" Grid.Column="1">
                    <views:DashboardPage x:Name="DashboardView" Visibility="{Binding SelectedPage, Converter={StaticResource EqualsToVis}, ConverterParameter=0}"/>
                    <views:FansPage x:Name="FansView" Visibility="{Binding SelectedPage, Converter={StaticResource EqualsToVis}, ConverterParameter=1}"/>
                    <views:LightingPage Visibility="{Binding SelectedPage, Converter={StaticResource EqualsToVis}, ConverterParameter=2}"/>
                    <views:LcdPage Visibility="{Binding SelectedPage, Converter={StaticResource EqualsToVis}, ConverterParameter=3}"/>
                    <views:WidgetPage Visibility="{Binding SelectedPage, Converter={StaticResource EqualsToVis}, ConverterParameter=4}"/>
                    <views:SettingsPage x:Name="AppSettingsPage" Visibility="{Binding SelectedPage, Converter={StaticResource EqualsToVis}, ConverterParameter=5}"/>
                    <views:HardwarePage Visibility="{Binding SelectedPage, Converter={StaticResource EqualsToVis}, ConverterParameter=6}"/>
                    <views:WindowsPage Visibility="{Binding SelectedPage, Converter={StaticResource EqualsToVis}, ConverterParameter=7}"/>
                    <views:DriversPage Visibility="{Binding SelectedPage, Converter={StaticResource EqualsToVis}, ConverterParameter=8}"/>
                </Grid>

                <!-- Detalhes de um cartão do painel -->
                <views:DetailPanel x:Name="Detail" Grid.Column="1" Visibility="{Binding IsDetailOpen, Converter={StaticResource BoolToVis}}"/>

                <!-- Aviso com "Desfazer" -->
                <Border x:Name="Toast" Grid.Column="1" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="16,0,16,18"
                        Background="{StaticResource SurfaceAltBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                        CornerRadius="10" Padding="16,6,6,6"
                        Visibility="{Binding ToastVisible, Converter={StaticResource BoolToVis}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding ToastText}" VerticalAlignment="Center" MaxWidth="460" TextTrimming="CharacterEllipsis"/>
                        <Button Style="{StaticResource GhostButton}" Content="Desfazer (Ctrl+Z)" Command="{Binding UndoCommand}" Margin="12,0,0,0"
                                Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold"
                                Visibility="{Binding ToastCanUndo, Converter={StaticResource BoolToVis}}"/>
                        <Button Style="{StaticResource IconButton}" Content="&#xE711;" FontSize="10" Command="{Binding DismissToastCommand}"
                                Margin="4,0,0,0" ToolTip="Fechar aviso" AutomationProperties.Name="Fechar aviso"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ======================================================== Barra de status -->
            <Border Grid.Row="2" Background="#080D19" Padding="14,5" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="7" Height="7" Fill="{Binding HubStatusColor, Converter={StaticResource HexToBrush}}" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding ConnectionStatus}" Foreground="{StaticResource TextMutedBrush}" FontSize="11.5" Margin="8,0,0,0"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <TextBlock Grid.Column="1" Foreground="{StaticResource TextSubtleBrush}" FontSize="11.5" VerticalAlignment="Center"
                               Text="{Binding ShortcutHint, RelativeSource={RelativeSource AncestorType=Window}}"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
