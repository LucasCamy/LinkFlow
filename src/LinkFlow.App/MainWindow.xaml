<Window x:Class="LinkFlow.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:LinkFlow.App.ViewModels"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="LinkFlow - Corsair iCUE LINK Hardware Suite" 
        Height="820" Width="1120" MinHeight="680" MinWidth="980"
        WindowStartupLocation="CenterScreen"
        Background="#0F172A" Foreground="#F8FAFC">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="64" ResizeBorderThickness="8" GlassFrameThickness="0" CornerRadius="0"/>
    </WindowChrome.WindowChrome>

    <Window.DataContext>
        <vm:MainViewModel x:Name="ViewModel"/>
    </Window.DataContext>

    <Window.Resources>
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="6"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Track x:Name="PART_Track" IsDirectionReversed="true">
                            <Track.Thumb>
                                <Thumb Background="#475569">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="3"/>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Slider">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="#00F0FF"/>
        </Style>
    </Window.Resources>

    <Border Background="#0F172A" BorderBrush="#334155" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Titlebar -->
                <RowDefinition Height="Auto"/> <!-- Metrics Bar -->
                <RowDefinition Height="*"/>    <!-- Tabs & Content -->
                <RowDefinition Height="Auto"/> <!-- Statusbar -->
            </Grid.RowDefinitions>

            <!-- 1. TITLEBAR (Native drag across multi-screens via WindowChrome + MouseLeftButtonDown) -->
            <Grid Grid.Row="0" Margin="16,12,16,8" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Logo & Name -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#1E293B" CornerRadius="8" Padding="8,4" Margin="0,0,10,0">
                        <TextBlock Text="⚡" FontSize="18" Foreground="#00F0FF"/>
                    </Border>
                    <StackPanel>
                        <TextBlock Text="LinkFlow" FontSize="18" FontWeight="Bold" Foreground="#F8FAFC"/>
                        <TextBlock Text="Hardware Suite para Corsair iCUE LINK + AMD Ryzen + RTX 4080" FontSize="10" Foreground="#64748B"/>
                    </StackPanel>
                </StackPanel>

                <!-- Actions / Controls -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Content="🔄" ToolTip="Atualizar e Sincronizar Todo o Hardware" Click="ApplyRgbSync_Click"
                            Width="34" Height="32" Margin="0,0,10,0"
                            Background="#1E293B" Foreground="#00F0FF" BorderThickness="0" Cursor="Hand" FontSize="14">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="8"/>
                            </Style>
                        </Button.Resources>
                    </Button>

                    <Button Content="🪟 Mini Widget" Click="ToggleMiniWidget_Click"
                            Background="#1E293B" Foreground="#38BDF8" BorderBrush="#334155" BorderThickness="1"
                            Padding="12,6" Margin="0,0,12,0" Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="8"/>
                            </Style>
                        </Button.Resources>
                    </Button>

                    <Button Content="—" Click="MinimizeButton_Click" Width="34" Height="32" Margin="0,0,6,0"
                            Background="#1E293B" Foreground="#94A3B8" BorderThickness="0" Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="8"/>
                            </Style>
                        </Button.Resources>
                    </Button>

                    <Button Content="✕" Click="CloseButton_Click" Width="34" Height="32"
                            Background="#1E293B" Foreground="#EF4444" BorderThickness="0" Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="8"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- 2. HARDWARE METRICS BANNER -->
            <Grid Grid.Row="1" Margin="16,4,16,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- CPU Card -->
                <Border Grid.Column="0" Background="#1E293B" CornerRadius="12" Margin="0,0,8,0" Padding="14,10" BorderBrush="#334155" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="AMD Ryzen 9 7900X3D" Foreground="#94A3B8" FontSize="11" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding CpuTempFormatted}" Foreground="#38BDF8" FontSize="22" FontWeight="Bold"/>
                            <TextBlock Text="{Binding CpuLoadFormatted, StringFormat='{}Carga: {0}'}" Foreground="#64748B" FontSize="11"/>
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="CPU" Foreground="#334155" FontSize="26" FontWeight="Black" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- GPU Card -->
                <Border Grid.Column="1" Background="#1E293B" CornerRadius="12" Margin="4,0,4,0" Padding="14,10" BorderBrush="#334155" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="NVIDIA GeForce RTX 4080" Foreground="#94A3B8" FontSize="11" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding GpuTempFormatted}" Foreground="#34D399" FontSize="22" FontWeight="Bold"/>
                            <TextBlock Text="{Binding GpuLoadFormatted, StringFormat='{}Carga: {0}'}" Foreground="#64748B" FontSize="11"/>
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="GPU" Foreground="#334155" FontSize="26" FontWeight="Black" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- RAM Card -->
                <Border Grid.Column="2" Background="#1E293B" CornerRadius="12" Margin="4,0,4,0" Padding="14,10" BorderBrush="#334155" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Corsair DDR5 6000MHz" Foreground="#94A3B8" FontSize="11" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding RamUsageFormatted}" Foreground="#A78BFA" FontSize="22" FontWeight="Bold"/>
                            <TextBlock Text="Capacidade: 64 GB" Foreground="#64748B" FontSize="11"/>
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="RAM" Foreground="#334155" FontSize="26" FontWeight="Black" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- Fans Card -->
                <Border Grid.Column="3" Background="#1E293B" CornerRadius="12" Margin="8,0,0,0" Padding="14,10" BorderBrush="#334155" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Velocidade Média Fans" Foreground="#94A3B8" FontSize="11" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding AverageFanRpm, StringFormat='{}{0} RPM'}" Foreground="#00F0FF" FontSize="22" FontWeight="Bold"/>
                            <TextBlock Text="{Binding GlobalSpeedFormatted, StringFormat='{}Potência: {0}'}" Foreground="#64748B" FontSize="11"/>
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="FAN" Foreground="#334155" FontSize="26" FontWeight="Black" VerticalAlignment="Center"/>
                    </Grid>
                </Border>
            </Grid>

            <!-- 3. TABS AND MAIN CONTENT -->
            <TabControl Grid.Row="2" Background="Transparent" BorderThickness="0" Margin="16,0,16,12">
                <TabControl.Resources>
                    <Style TargetType="TabItem">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="TabItem">
                                    <Border x:Name="tabBorder" Background="Transparent" CornerRadius="8" Padding="16,8" Margin="0,0,8,8">
                                        <ContentPresenter ContentSource="Header"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                             <Setter TargetName="tabBorder" Property="Background" Value="#1E293B"/>
                                            <Setter TargetName="tabBorder" Property="BorderBrush" Value="#00F0FF"/>
                                            <Setter TargetName="tabBorder" Property="BorderThickness" Value="1"/>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="tabBorder" Property="Background" Value="#334155"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </TabControl.Resources>

                <!-- TAB 1: CONTROLE DE VENTOINHAS & GPU -->
                <TabItem>
                    <TabItem.Header>
                        <TextBlock Text="🌀 Controle de Ventoinhas &amp; GPU" Foreground="#F8FAFC" FontWeight="SemiBold" FontSize="13"/>
                    </TabItem.Header>

                    <Grid Margin="0,8,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/> <!-- Master Controls -->
                            <RowDefinition Height="Auto"/> <!-- Dedicated GPU Fan Card -->
                            <RowDefinition Height="*"/>    <!-- Fans Grid -->
                        </Grid.RowDefinitions>

                        <!-- Presets & Master Slider -->
                        <Border Grid.Row="0" Background="#1E293B" CornerRadius="12" Padding="16,12" Margin="0,0,0,10" BorderBrush="#334155" BorderThickness="1">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Presets -->
                                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                                    <TextBlock Text="Perfis:" Foreground="#94A3B8" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,16,0"/>

                                    <Button Content="🔇 Silencioso (40%)" Click="PresetSilent_Click"
                                            Background="#0F172A" Foreground="#38BDF8" BorderBrush="#334155" BorderThickness="1"
                                            Padding="12,6" Margin="0,0,8,0" Cursor="Hand"/>

                                    <Button Content="⚖️ Equilibrado (55%)" Click="PresetBalanced_Click"
                                            Background="#0F172A" Foreground="#34D399" BorderBrush="#334155" BorderThickness="1"
                                            Padding="12,6" Margin="0,0,8,0" Cursor="Hand"/>

                                    <Button Content="⚡ Desempenho (75%)" Click="PresetPerformance_Click"
                                            Background="#0F172A" Foreground="#FBBF24" BorderBrush="#334155" BorderThickness="1"
                                            Padding="12,6" Margin="0,0,8,0" Cursor="Hand"/>

                                    <Button Content="🌪️ Máximo (100%)" Click="PresetMax_Click"
                                            Background="#0F172A" Foreground="#F43F5E" BorderBrush="#334155" BorderThickness="1"
                                            Padding="12,6" Margin="0,0,8,0" Cursor="Hand"/>

                                    <Button Content="🤖 Curva Inteligente (Auto)" Click="PresetAuto_Click"
                                            Background="#0F172A" Foreground="#00F0FF" BorderBrush="#00F0FF" BorderThickness="1"
                                            Padding="12,6" Cursor="Hand"/>
                                </StackPanel>

                                <!-- Master Slider -->
                                <Grid Grid.Row="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="Potência Global do Hub iCUE LINK:" Foreground="#F8FAFC" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,16,0"/>
                                    <Slider Grid.Column="1" Minimum="25" Maximum="100" Value="{Binding GlobalSpeedPercent, Mode=TwoWay}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="{Binding GlobalSpeedFormatted}" Foreground="#00F0FF" FontWeight="Bold" FontSize="16" Width="50" TextAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- DEDICATED GPU FAN CARD (ASUS GeForce RTX 4080) -->
                        <Border Grid.Row="1" Background="#1E293B" CornerRadius="12" Padding="16,12" Margin="0,0,0,10" BorderBrush="#34D399" BorderThickness="1">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- GPU Header & Telemetry -->
                                <Grid Grid.Row="0" Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Background="#064E3B" CornerRadius="8" Width="36" Height="36" Margin="0,0,12,0">
                                        <TextBlock Text="🎮" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="ASUS GeForce RTX 4080" Foreground="#F8FAFC" FontWeight="Bold" FontSize="14"/>
                                            <Border Background="#065F46" CornerRadius="4" Padding="6,1" Margin="8,0,0,0">
                                                <TextBlock Text="GPU Ativa" Foreground="#34D399" FontSize="10" FontWeight="SemiBold"/>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{Binding GpuFanRpmFormatted}" Foreground="#94A3B8" FontSize="11" Margin="0,2,0,0"/>
                                    </StackPanel>

                                    <!-- Mode Toggle Buttons -->
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <CheckBox Content="Modo Automático (vBIOS)" IsChecked="{Binding IsGpuFanAuto, Mode=TwoWay}" 
                                                  Foreground="#F8FAFC" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>

                                <!-- GPU Fan Manual Slider (Enabled only when Auto is unchecked) -->
                                <Grid Grid.Row="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="Controle Manual da GPU:" Foreground="#94A3B8" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,16,0"/>
                                    <Slider Grid.Column="1" Minimum="30" Maximum="100" Value="{Binding GpuFanPercent, Mode=TwoWay}" 
                                            IsEnabled="{Binding IsGpuFanAuto, Converter={x:Null}}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="{Binding GpuFanPercentFormatted}" Foreground="#34D399" FontWeight="Bold" FontSize="16" Width="50" TextAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- Fans Scrollable Grid -->
                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Fans}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="2"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#1E293B" CornerRadius="12" Margin="4,4,4,4" Padding="14,12" BorderBrush="#334155" BorderThickness="1">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

                                                <Grid Grid.Row="0" Margin="0,0,0,8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <Border Grid.Column="0" Background="#0F172A" CornerRadius="8" Width="36" Height="36" Margin="0,0,10,0">
                                                        <TextBlock Text="🌀" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>

                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Name}" Foreground="#F8FAFC" FontWeight="Bold" FontSize="13"/>
                                                        <TextBlock Text="{Binding Channel, StringFormat='{}Canal iCUE LINK #{0:D2}'}" Foreground="#64748B" FontSize="10"/>
                                                    </StackPanel>

                                                    <TextBlock Grid.Column="2" Text="{Binding RpmFormatted}" Foreground="{Binding StatusColor}" FontWeight="Bold" FontSize="15" VerticalAlignment="Center"/>
                                                </Grid>

                                                <Grid Grid.Row="1">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <Slider Grid.Column="0" Minimum="25" Maximum="100" Value="{Binding TargetPowerPercent, Mode=TwoWay}" 
                                                            ValueChanged="IndividualSlider_ValueChanged" Tag="{Binding}"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding PowerFormatted}" Foreground="#94A3B8" Width="40" TextAlignment="Right" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                                </Grid>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </TabItem>

                <!-- TAB 2: ILUMINAÇÃO & SINCRONIZAÇÃO RGB -->
                <TabItem>
                    <TabItem.Header>
                        <TextBlock Text="🌈 Iluminação &amp; Sincronização RGB" Foreground="#F8FAFC" FontWeight="SemiBold" FontSize="13"/>
                    </TabItem.Header>

                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="380"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left: Live Color Swatch & Presets -->
                        <Border Grid.Column="0" Background="#1E293B" CornerRadius="16" Margin="0,0,12,0" Padding="20" BorderBrush="#334155" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="Cor Ativa do Setup" Foreground="#94A3B8" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,12"/>

                                <!-- Color Preview Circle -->
                                <Border Width="160" Height="160" CornerRadius="80" Background="{Binding CurrentRgbHex}" BorderBrush="#334155" BorderThickness="4" HorizontalAlignment="Center">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="28" Color="#000000" Opacity="0.5"/>
                                    </Border.Effect>
                                </Border>

                                <TextBlock Text="{Binding CurrentRgbHex}" Foreground="#F8FAFC" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,12,0,4"/>
                                <TextBlock Text="{Binding RgbSyncStatus}" Foreground="#38BDF8" FontSize="11" HorizontalAlignment="Center" Margin="0,0,0,16"/>

                                <TextBlock Text="Cores Rápidas de 1-Clique:" Foreground="#94A3B8" FontWeight="SemiBold" Margin="0,0,0,10"/>

                                <!-- Quick Color Buttons Grid -->
                                <UniformGrid Columns="4" Rows="2" Margin="0,0,0,16">
                                    <Button Content="💎 Cyan" Click="ColorCyan_Click" Background="#00F0FF" Foreground="#0F172A" FontWeight="Bold" Height="36" Margin="3" Cursor="Hand"/>
                                    <Button Content="🟣 Roxo" Click="ColorPurple_Click" Background="#A855F7" Foreground="#F8FAFC" FontWeight="Bold" Height="36" Margin="3" Cursor="Hand"/>
                                    <Button Content="🟢 Verde" Click="ColorGreen_Click" Background="#10B981" Foreground="#0F172A" FontWeight="Bold" Height="36" Margin="3" Cursor="Hand"/>
                                    <Button Content="🔴 Red" Click="ColorRed_Click" Background="#EF4444" Foreground="#F8FAFC" FontWeight="Bold" Height="36" Margin="3" Cursor="Hand"/>
                                    <Button Content="⚪ White" Click="ColorWhite_Click" Background="#F8FAFC" Foreground="#0F172A" FontWeight="Bold" Height="36" Margin="3" Cursor="Hand"/>
                                    <Button Content="🟠 Laranja" Click="ColorOrange_Click" Background="#F97316" Foreground="#F8FAFC" FontWeight="Bold" Height="36" Margin="3" Cursor="Hand"/>
                                    <Button Content="🟡 Amarelo" Click="ColorYellow_Click" Background="#FACC15" Foreground="#0F172A" FontWeight="Bold" Height="36" Margin="3" Cursor="Hand"/>
                                    <Button Content="🖤 Blackout" Click="ColorOff_Click" Background="#0A0F1D" Foreground="#94A3B8" FontWeight="Bold" Height="36" Margin="3" BorderBrush="#334155" BorderThickness="1" Cursor="Hand"/>
                                </UniformGrid>
                            </StackPanel>
                        </Border>

                        <!-- Right: RGB Sliders, Brightness & Sync Targets -->
                        <Border Grid.Column="1" Background="#1E293B" CornerRadius="16" Padding="20" BorderBrush="#334155" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="Ajuste Fino de Cor &amp; Sincronização" Foreground="#F8FAFC" FontWeight="Bold" FontSize="16" Margin="0,0,0,16"/>

                                <!-- Red Slider -->
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="60"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="40"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Vermelho:" Foreground="#EF4444" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <Slider Grid.Column="1" Minimum="0" Maximum="255" Value="{Binding RgbR, Mode=TwoWay}" Foreground="#EF4444"/>
                                    <TextBlock Grid.Column="2" Text="{Binding RgbR}" Foreground="#94A3B8" TextAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>

                                <!-- Green Slider -->
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="60"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="40"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Verde:" Foreground="#10B981" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <Slider Grid.Column="1" Minimum="0" Maximum="255" Value="{Binding RgbG, Mode=TwoWay}" Foreground="#10B981"/>
                                    <TextBlock Grid.Column="2" Text="{Binding RgbG}" Foreground="#94A3B8" TextAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>

                                <!-- Blue Slider -->
                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="60"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="40"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Azul:" Foreground="#38BDF8" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <Slider Grid.Column="1" Minimum="0" Maximum="255" Value="{Binding RgbB, Mode=TwoWay}" Foreground="#38BDF8"/>
                                    <TextBlock Grid.Column="2" Text="{Binding RgbB}" Foreground="#94A3B8" TextAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>

                                <!-- Brightness -->
                                <Grid Margin="0,0,0,20">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="60"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="40"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Brilho:" Foreground="#FBBF24" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <Slider Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding RgbBrightness, Mode=TwoWay}" Foreground="#FBBF24"/>
                                    <TextBlock Grid.Column="2" Text="{Binding RgbBrightnessFormatted}" Foreground="#94A3B8" TextAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>

                                <Border Height="1" Background="#334155" Margin="0,0,0,16"/>

                                <TextBlock Text="Dispositivos Sincronizados:" Foreground="#94A3B8" FontWeight="SemiBold" Margin="0,0,0,10"/>

                                <WrapPanel Margin="0,0,0,12">
                                    <CheckBox Content="10x Fans Corsair RX" IsChecked="{Binding SyncFans}" Foreground="#F8FAFC" Margin="0,0,16,8"/>
                                    <CheckBox Content="Bomba Titan AIO" IsChecked="{Binding SyncPump}" Foreground="#F8FAFC" Margin="0,0,16,8"/>
                                    <CheckBox Content="Display &amp; Anel LCD (0x0C4E)" IsChecked="{Binding SyncLcd}" Foreground="#F8FAFC" Margin="0,0,16,8"/>
                                    <CheckBox Content="Placa de Vídeo (ASUS RTX 4080)" IsChecked="{Binding SyncGpu}" Foreground="#F8FAFC" Margin="0,0,16,8"/>
                                    <CheckBox Content="Placa-Mãe &amp; Saídas ARGB/RGB (MSI X670E)" IsChecked="{Binding SyncMotherboard}" Foreground="#F8FAFC" Margin="0,0,16,8"/>
                                    <CheckBox Content="Memórias Corsair DDR5" IsChecked="{Binding SyncRam}" Foreground="#F8FAFC" Margin="0,0,16,8"/>
                                </WrapPanel>

                                <StackPanel Margin="0,0,0,16">
                                    <TextBlock Text="{Binding GpuRgbStatus}" Foreground="#38BDF8" FontSize="11" Margin="0,0,0,4" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding MotherboardRgbStatus}" Foreground="#38BDF8" FontSize="11" Margin="0,0,0,4" FontWeight="SemiBold"/>
                                    <TextBlock Text="ℹ️ Nota DDR5: Pentes DDR5 compartilham o barramento de alimentação PMIC/SPD; para proteger os módulos contra corrupção no AM5, utilize o perfil de iluminação gravado em hardware." Foreground="#94A3B8" FontSize="10" TextWrapping="Wrap"/>
                                </StackPanel>

                                <Button Content="✨ Aplicar e Sincronizar Tudo Agora" Click="ApplyRgbSync_Click"
                                        Background="#00F0FF" Foreground="#0F172A" FontWeight="Bold" FontSize="14" Padding="16,12" Cursor="Hand">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="8"/>
                                        </Style>
                                    </Button.Resources>
                                </Button>
                            </StackPanel>
                        </Border>
                    </Grid>
                </TabItem>

                <!-- TAB 3: TELA LCD DA BOMBA -->
                <TabItem>
                    <TabItem.Header>
                        <TextBlock Text="📺 Tela LCD da Bomba (480x480)" Foreground="#F8FAFC" FontWeight="SemiBold" FontSize="13"/>
                    </TabItem.Header>

                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="420"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Circular LCD Preview -->
                        <Border Grid.Column="0" Background="#1E293B" CornerRadius="16" Margin="0,0,12,0" Padding="20" BorderBrush="#334155" BorderThickness="1">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="Módulo LCD Corsair Titan (IPS 480x480)" Foreground="#94A3B8" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,16"/>

                                <Border Width="280" Height="280" CornerRadius="140" Background="#0B0F19" BorderBrush="{Binding CurrentRgbHex}" BorderThickness="4">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="24" Color="#00F0FF" Opacity="0.4"/>
                                    </Border.Effect>
                                    <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="⚡ LINKFLOW TITAN" Foreground="#94A3B8" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center"/>
                                            <TextBlock Text="{Binding CpuTempFormatted}" Foreground="#F8FAFC" FontSize="42" FontWeight="Black" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                            <TextBlock Text="CPU TEMPERATURE" Foreground="{Binding CurrentRgbHex}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center"/>

                                            <Border Height="1" Background="#334155" Width="140" Margin="0,10"/>

                                            <Grid Width="200">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                                    <TextBlock Text="GPU CORE" Foreground="#64748B" FontSize="9" FontWeight="Bold"/>
                                                    <TextBlock Text="{Binding GpuTempFormatted}" Foreground="#34D399" FontSize="14" FontWeight="Bold"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                                    <TextBlock Text="BOMBA AIO" Foreground="#64748B" FontSize="9" FontWeight="Bold"/>
                                                    <TextBlock Text="{Binding PumpRpm, StringFormat='{}{0} RPM'}" Foreground="#F8FAFC" FontSize="14" FontWeight="Bold"/>
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <TextBlock Text="{Binding LcdStatus}" Foreground="#10B981" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,16,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- LCD Controls & Themes -->
                        <Border Grid.Column="1" Background="#1E293B" CornerRadius="16" Padding="20" BorderBrush="#334155" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="Gerenciamento do Display IPS" Foreground="#F8FAFC" FontWeight="Bold" FontSize="16" Margin="0,0,0,16"/>

                                <TextBlock Text="Transmissão em Tempo Real:" Foreground="#94A3B8" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                
                                <CheckBox Content="Transmissão Contínua de Métricas (1 FPS / Sem Carga de CPU)" 
                                          IsChecked="{Binding IsLcdAutoStream, Mode=TwoWay}" Foreground="#F8FAFC" FontWeight="SemiBold" Margin="0,0,0,16"/>

                                <TextBlock Text="Informações do Protocolo:" Foreground="#94A3B8" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                <Border Background="#0F172A" CornerRadius="8" Padding="12" Margin="0,0,0,20">
                                    <StackPanel>
                                        <TextBlock Text="• Resolução: 480x480 pixels 24-bit IPS" Foreground="#64748B" FontSize="11"/>
                                        <TextBlock Text="• Encodificação: JPEG nativa em chunks de 1016 bytes via Report ID 0x02" Foreground="#64748B" FontSize="11" Margin="0,2,0,0"/>
                                        <TextBlock Text="• Temperatura da Água / Fluido: Acompanhamento contínuo" Foreground="#64748B" FontSize="11" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>

                                <Button Content="🚀 Transmitir Quadro Agora para o Display" Click="SyncLcd_Click"
                                        Background="#00F0FF" Foreground="#0F172A" FontWeight="Bold" Padding="16,12" Cursor="Hand">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="8"/>
                                        </Style>
                                    </Button.Resources>
                                </Button>
                            </StackPanel>
                        </Border>
                    </Grid>
                </TabItem>
            </TabControl>

            <!-- 4. STATUSBAR -->
            <Border Grid.Row="3" Background="#0A0F1D" Padding="16,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="{Binding ConnectionStatus}" Foreground="#94A3B8" FontSize="11" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="LinkFlow v1.2.0 • Multi-Monitor Ready • 0% CPU" Foreground="#10B981" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
