<UserControl x:Class="LinkFlow.App.Views.WindowsMaintenancePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:LinkFlow.App.Controls">
    <ScrollViewer Style="{StaticResource SystemScroll}">
        <Border Style="{StaticResource SystemPanel}" Margin="0,0,0,24" VerticalAlignment="Top">
            <StackPanel>
                <DockPanel>
                    <Border DockPanel.Dock="Left" Style="{StaticResource SystemIconTile}" Margin="0,0,12,0">
                        <TextBlock Text="&#xE90F;" Style="{StaticResource SystemIcon}"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Ferramentas de manutenção" Style="{StaticResource SystemSectionTitle}"/>
                        <TextBlock Text="Confira o comando e o impacto antes de abrir a ferramenta." Style="{StaticResource SystemDetail}"/>
                    </StackPanel>
                </DockPanel>

                <StackPanel x:Name="MaintenanceForm" Margin="0,16,0,0">
                    <c:AdaptiveUniformGrid MinItemWidth="224" MaxColumns="2" Margin="0,0,-12,0">
                        <StackPanel Margin="0,0,12,10">
                            <TextBlock Text="Ferramenta" Style="{StaticResource Label}" Margin="0,0,0,6"/>
                            <ComboBox x:Name="Tools" SelectionChanged="Tool_SelectionChanged" AutomationProperties.Name="Ferramenta de manutenção"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,12,10">
                            <TextBlock Text="Operação" Style="{StaticResource Label}" Margin="0,0,0,6"/>
                            <ComboBox x:Name="Operations" SelectionChanged="Operation_SelectionChanged" AutomationProperties.Name="Operação de manutenção"/>
                        </StackPanel>
                    </c:AdaptiveUniformGrid>

                    <StackPanel x:Name="VolumeControls" Visibility="Collapsed" Margin="0,0,0,10">
                        <TextBlock Text="Volume local" Style="{StaticResource Label}" Margin="0,0,0,6"/>
                        <DockPanel>
                            <Button x:Name="RefreshVolumesButton" DockPanel.Dock="Right" Content="Atualizar lista"
                                    Style="{StaticResource SecondaryButton}" Click="RefreshVolumes_Click" Margin="8,0,0,0"/>
                            <ComboBox x:Name="Volumes" SelectionChanged="Volume_SelectionChanged" AutomationProperties.Name="Volume local para CHKDSK"/>
                        </DockPanel>
                        <TextBlock x:Name="VolumeStatus" Style="{StaticResource SystemDetail}" AutomationProperties.LiveSetting="Polite"/>
                    </StackPanel>

                    <Border Background="{StaticResource SurfaceAltBrush}" CornerRadius="10" Padding="14" Margin="0,6,0,0">
                        <StackPanel>
                            <TextBlock Text="Comando" Style="{StaticResource SystemItemTitle}"/>
                            <TextBlock x:Name="CommandPreview" FontFamily="Consolas" FontSize="13" TextWrapping="Wrap" Margin="0,6,0,0"/>
                            <TextBlock x:Name="ImpactPreview" Style="{StaticResource SystemDetail}" Margin="0,10,0,0"/>
                            <TextBlock x:Name="ExecutionHint" Style="{StaticResource SystemDetail}" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>

                    <Button x:Name="RunButton" Content="Abrir verificação" Click="Run_Click" Style="{StaticResource PrimaryButton}"
                            HorizontalAlignment="Left" Margin="0,14,0,0"/>
                </StackPanel>

                <TextBlock x:Name="RunStatus" Style="{StaticResource SystemDetail}" Margin="0,12,0,0"
                           AutomationProperties.LiveSetting="Polite" Visibility="Collapsed"/>
                <TextBlock x:Name="ResultsLocation" Style="{StaticResource SystemDetail}" Margin="0,6,0,0"
                           Visibility="Collapsed"/>
            </StackPanel>
        </Border>
    </ScrollViewer>
</UserControl>
