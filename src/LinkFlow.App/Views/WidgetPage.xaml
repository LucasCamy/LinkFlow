<UserControl x:Class="LinkFlow.App.Views.WidgetPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:r="clr-namespace:LinkFlow.App.Resources"
             xmlns:views="clr-namespace:LinkFlow.App.Views"
             xmlns:vm="clr-namespace:LinkFlow.App.ViewModels">
    <UserControl.Resources>
        <Style x:Key="WidgetSwatch" TargetType="Button">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Swatch" CornerRadius="8" BorderThickness="2"
                                BorderBrush="{StaticResource BorderBrush}" Background="{TemplateBinding Background}"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Swatch" Property="BorderBrush" Value="{StaticResource TextBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="WidgetSliderValue" TargetType="TextBlock">
            <Setter Property="TextAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
        </Style>
    </UserControl.Resources>

    <Grid MaxWidth="1160" Margin="24,20,24,0"
          DataContext="{Binding Widget, RelativeSource={RelativeSource AncestorType=Window}}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,0,16">
            <ToggleButton DockPanel.Dock="Right" VerticalAlignment="Center" Margin="12,0,0,0"
                          IsChecked="{Binding IsWidgetEnabled, Mode=OneWay}" Click="ToggleWidget_Click"
                          ToolTip="{x:Static r:Strings.Wid_AlternarWidgetFlutuanteCtrl}">
                <ToggleButton.Style>
                    <Style TargetType="ToggleButton" BasedOn="{StaticResource Chip}">
                        <Setter Property="Content" Value="{x:Static r:Strings.Wid_MostrarWidget}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsWidgetEnabled}" Value="True">
                                <Setter Property="Content" Value="{x:Static r:Strings.Mini_Hide}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ToggleButton.Style>
            </ToggleButton>
            <StackPanel>
                <TextBlock Text="{x:Static r:Strings.Nav_Widget}" Style="{StaticResource SystemPageTitle}"/>
                <TextBlock Text="{x:Static r:Strings.Wid_PersonalizeMonitorFlutuanteArea}" Style="{StaticResource SystemDetail}"/>
            </StackPanel>
        </DockPanel>

        <DockPanel Grid.Row="1" SizeChanged="Workspace_SizeChanged">
            <Border x:Name="PreviewCard" DockPanel.Dock="Top" Style="{StaticResource SystemPanel}"
                    Padding="12" Margin="0,0,0,12" VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Text="{x:Static r:Strings.Wid_PreviaVivo}" Style="{StaticResource SystemSectionTitle}"/>
                    <Border x:Name="PreviewStage" Margin="0,8,0,0" Padding="10" MinHeight="72" MaxHeight="84"
                            CornerRadius="10" ClipToBounds="True"
                            ToolTip="{x:Static r:Strings.Wid_PreviaAjustaEspacoUse}">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#1E3A5F" Offset="0"/>
                                <GradientStop Color="#3B1F4F" Offset="0.55"/>
                                <GradientStop Color="#0F2A2E" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Viewbox Stretch="Uniform" StretchDirection="DownOnly">
                            <views:WidgetView x:Name="LivePreview" Opacity="{Binding Opacity}"/>
                        </Viewbox>
                    </Border>
                </StackPanel>
            </Border>

            <TabControl x:Name="WidgetTabs" Style="{StaticResource SystemTabs}" SelectedIndex="0">
                <TabItem Header="{x:Static r:Strings.Det_Info}" Style="{StaticResource SystemTab}">
                    <ScrollViewer Style="{StaticResource SystemScroll}">
                        <StackPanel Margin="0,0,0,24">
                            <Border Style="{StaticResource SystemPanel}" Margin="0,0,0,12">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,12">
                                        <Button DockPanel.Dock="Right" Content="{x:Static r:Strings.Lcd_Adicionar}" Style="{StaticResource SystemLinkButton}"
                                                VerticalAlignment="Center" Click="GoToPicker_Click" Margin="8,0,0,0"/>
                                        <StackPanel>
                                            <TextBlock Text="{x:Static r:Strings.Wid_Widget}" Style="{StaticResource SystemSectionTitle}"/>
                                            <TextBlock Text="{x:Static r:Strings.Wid_UseSetasMudarOrdem}" Style="{StaticResource SystemDetail}"
                                                       Visibility="{Binding HasItems, Converter={StaticResource BoolToVis}}"/>
                                        </StackPanel>
                                    </DockPanel>
                                    <TextBlock Text="{x:Static r:Strings.Wid_EscolhaAbaixoInformacoesDeseja}" Style="{StaticResource SystemDetail}"
                                               Visibility="{Binding HasItems, Converter={StaticResource BoolToVisInverse}}"/>
                                    <ItemsControl ItemsSource="{Binding Items}" Focusable="False">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource SystemRow}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Ellipse Width="8" Height="8" Fill="{Binding Color, Converter={StaticResource HexToBrush}}"
                                                                 Margin="0,0,10,0" VerticalAlignment="Center"/>
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding FullLabel}" Style="{StaticResource SystemItemTitle}"/>
                                                            <TextBlock Style="{StaticResource SystemDetail}">
                                                                <Run Text="{Binding Group, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding Text, Mode=OneWay}"/>
                                                            </TextBlock>
                                                        </StackPanel>
                                                        <Button Grid.Column="2" Style="{StaticResource ChipButton}" Margin="8,0,4,0" MinWidth="54"
                                                                Content="{Binding DisplayLabel}" ToolTip="{x:Static r:Strings.Wid_AlternarEntrePorcentagemValor}"
                                                                Command="{Binding DataContext.ToggleDisplayCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                CommandParameter="{Binding}" Visibility="{Binding CanToggleDisplay, Converter={StaticResource BoolToVis}}"/>
                                                        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                                            <Button Style="{StaticResource IconButton}" Width="28" Height="28" FontSize="11" Content="&#xE70E;"
                                                                    ToolTip="{x:Static r:Strings.Lcd_MoverCima}" AutomationProperties.Name="{Binding FullLabel, StringFormat={x:Static r:Strings.Wid_MoverCima}}"
                                                                    Command="{Binding DataContext.MoveUpCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                    CommandParameter="{Binding}"/>
                                                            <Button Style="{StaticResource IconButton}" Width="28" Height="28" FontSize="11" Content="&#xE70D;"
                                                                    ToolTip="{x:Static r:Strings.Lcd_MoverBaixo}" AutomationProperties.Name="{Binding FullLabel, StringFormat={x:Static r:Strings.Wid_MoverBaixo}}"
                                                                    Command="{Binding DataContext.MoveDownCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                    CommandParameter="{Binding}"/>
                                                            <Button Style="{StaticResource IconButton}" Width="28" Height="28" FontSize="11" Content="&#xE711;"
                                                                    ToolTip="{x:Static r:Strings.Lcd_Remover}" AutomationProperties.Name="{Binding FullLabel, StringFormat={x:Static r:Strings.Wid_Remover}}" Foreground="{StaticResource DangerBrush}"
                                                                    Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                    CommandParameter="{Binding}"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <Border x:Name="PickerPanel" Style="{StaticResource SystemPanel}">
                                <StackPanel>
                                    <TextBlock Text="{x:Static r:Strings.Wid_AdicionarInformacoes}" Style="{StaticResource SystemSectionTitle}"/>
                                    <TextBlock Text="{x:Static r:Strings.Wid_MarqueDesejaAcompanharDiscos}"
                                               Style="{StaticResource SystemDetail}" Margin="0,2,0,12"/>
                                    <ItemsControl ItemsSource="{Binding Picker}" Focusable="False">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource SystemRow}">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Name}" Style="{StaticResource SystemItemTitle}" Margin="0,0,0,8"/>
                                                        <ItemsControl ItemsSource="{Binding Items}" Focusable="False">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <ToggleButton Style="{StaticResource Chip}" IsChecked="{Binding IsAdded, Mode=OneWay}" Padding="10,5"
                                                                                  Command="{Binding DataContext.AddCommand, RelativeSource={RelativeSource AncestorType=ScrollViewer}}"
                                                                                  CommandParameter="{Binding Id}" AutomationProperties.Name="{Binding Label}">
                                                                        <StackPanel Orientation="Horizontal">
                                                                            <Ellipse Width="7" Height="7" Fill="{Binding Color, Converter={StaticResource HexToBrush}}" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                                                            <TextBlock Text="{Binding Label}" MaxWidth="260" TextTrimming="CharacterEllipsis" ToolTip="{Binding Label}"/>
                                                                        </StackPanel>
                                                                    </ToggleButton>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="{x:Static r:Strings.Wid_Aparencia}" Style="{StaticResource SystemTab}">
                    <ScrollViewer Style="{StaticResource SystemScroll}">
                        <StackPanel Margin="0,0,0,24">
                            <Border Style="{StaticResource SystemPanel}" Margin="0,0,0,12">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,12">
                                        <Button DockPanel.Dock="Right" Style="{StaticResource SystemLinkButton}" Content="{x:Static r:Strings.Fan_RestaurarPadrao}"
                                                Command="{Binding ResetCommand}" Margin="8,0,0,0" VerticalAlignment="Center"
                                                ToolTip="{x:Static r:Strings.Wid_RedefineInformacoesAparenciaWidget}"/>
                                        <TextBlock Text="{x:Static r:Strings.Wid_FormatoTamanho}" Style="{StaticResource SystemSectionTitle}" VerticalAlignment="Center"/>
                                    </DockPanel>
                                    <WrapPanel>
                                        <RadioButton GroupName="WidgetLayout" Style="{StaticResource Chip}" Content="{x:Static r:Strings.Wid_Linha}"
                                                     IsChecked="{Binding IsHorizontal, Mode=OneWay}" Command="{Binding SetLayoutCommand}" CommandParameter="Horizontal"/>
                                        <RadioButton GroupName="WidgetLayout" Style="{StaticResource Chip}" Content="{x:Static r:Strings.Wid_Coluna}"
                                                     IsChecked="{Binding IsVertical, Mode=OneWay}" Command="{Binding SetLayoutCommand}" CommandParameter="Vertical"/>
                                        <RadioButton GroupName="WidgetLayout" Style="{StaticResource Chip}" Content="{x:Static r:Strings.Wid_Grade}"
                                                     IsChecked="{Binding IsGrid, Mode=OneWay}" Command="{Binding SetLayoutCommand}" CommandParameter="Grid"/>
                                    </WrapPanel>
                                    <Grid Margin="0,4,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="104"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="52"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="34"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="{x:Static r:Strings.Wid_Tamanho}" Style="{StaticResource SystemItemTitle}" VerticalAlignment="Center"/>
                                        <Slider Grid.Column="1" Minimum="0.7" Maximum="2" SmallChange="0.05" LargeChange="0.1"
                                                IsSnapToTickEnabled="True" TickFrequency="0.05" Value="{Binding Scale}" AutomationProperties.Name="{x:Static r:Strings.Wid_TamanhoWidget}"/>
                                        <TextBlock Grid.Column="2" Text="{Binding ScaleText}" Style="{StaticResource WidgetSliderValue}"/>
                                        <Grid Grid.Row="1" Grid.ColumnSpan="3" Height="34" Visibility="{Binding IsGrid, Converter={StaticResource BoolToVis}}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="104"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="52"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{x:Static r:Strings.Wid_Colunas}" Style="{StaticResource SystemItemTitle}" VerticalAlignment="Center"/>
                                            <Slider Grid.Column="1" Minimum="1" Maximum="6" IsSnapToTickEnabled="True" TickFrequency="1"
                                                    Value="{Binding GridColumns}" AutomationProperties.Name="{x:Static r:Strings.Wid_ColunasGrade}"/>
                                            <TextBlock Grid.Column="2" Text="{Binding GridColumns}" Style="{StaticResource WidgetSliderValue}"/>
                                        </Grid>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource SystemPanel}" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="{x:Static r:Strings.Wid_CoresTransparencia}" Style="{StaticResource SystemSectionTitle}"/>
                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="52"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="34"/><RowDefinition Height="34"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="{x:Static r:Strings.Wid_Opacidade}" Style="{StaticResource SystemItemTitle}" VerticalAlignment="Center"/>
                                        <Slider Grid.Column="1" Minimum="0.3" Maximum="1" IsSnapToTickEnabled="True" TickFrequency="0.05"
                                                Value="{Binding Opacity}" AutomationProperties.Name="{x:Static r:Strings.Wid_OpacidadeWidget}"/>
                                        <TextBlock Grid.Column="2" Text="{Binding OpacityText}" Style="{StaticResource WidgetSliderValue}"/>

                                        <TextBlock Grid.Row="1" Text="{x:Static r:Strings.Wid_Fundo}" Style="{StaticResource SystemItemTitle}" VerticalAlignment="Center"
                                                   ToolTip="{x:Static r:Strings.Wid_TransparenciaSomenteFundo}"/>
                                        <Slider Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="1" IsSnapToTickEnabled="True" TickFrequency="0.05"
                                                Value="{Binding BackgroundOpacity}" AutomationProperties.Name="{x:Static r:Strings.Wid_OpacidadeFundo}"/>
                                        <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding BackgroundOpacityText}" Style="{StaticResource WidgetSliderValue}"/>
                                    </Grid>

                                    <Border Style="{StaticResource SystemRow}" Margin="0,10,0,0">
                                        <StackPanel>
                                            <TextBlock Text="{x:Static r:Strings.Wid_CorFundo}" Style="{StaticResource SystemItemTitle}" Margin="0,0,0,8"/>
                                            <ItemsControl ItemsSource="{x:Static vm:WidgetViewModel.BackgroundOptions}" Focusable="False">
                                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Button Style="{StaticResource WidgetSwatch}" ToolTip="{Binding}"
                                                                Background="{Binding Converter={StaticResource HexToBrush}}" AutomationProperties.Name="{Binding StringFormat={x:Static r:Strings.Wid_CorFundo2}}"
                                                                Command="{Binding DataContext.SetBackgroundCommand, RelativeSource={RelativeSource AncestorType=ScrollViewer}}" CommandParameter="{Binding}"/>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <TextBlock Text="{x:Static r:Strings.Wid_CorValores}" Style="{StaticResource SystemItemTitle}" Margin="0,4,0,6"/>
                                            <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding UseSensorColors}"
                                                      Content="{x:Static r:Strings.Wid_CadaInformacaoSuaCor}" Margin="0,0,0,10"/>
                                            <ItemsControl ItemsSource="{x:Static vm:WidgetViewModel.AccentOptions}" Focusable="False">
                                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Button Style="{StaticResource WidgetSwatch}" Width="26" Height="26" ToolTip="{Binding StringFormat={x:Static r:Strings.Wid_CorUnica}}"
                                                                Background="{Binding Converter={StaticResource HexToBrush}}" AutomationProperties.Name="{Binding StringFormat={x:Static r:Strings.Wid_CorUnica}}"
                                                                Command="{Binding DataContext.SetAccentCommand, RelativeSource={RelativeSource AncestorType=ScrollViewer}}" CommandParameter="{Binding}"/>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource SystemPanel}">
                                <StackPanel>
                                    <TextBlock Text="{x:Static r:Strings.Wid_FonteDetalhes}" Style="{StaticResource SystemSectionTitle}"/>
                                    <ItemsControl ItemsSource="{x:Static vm:WidgetViewModel.FontOptions}" Focusable="False" Margin="0,10,0,0">
                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <RadioButton GroupName="WidgetFont" Style="{StaticResource Chip}" Content="{Binding}" FontFamily="{Binding}"
                                                             Command="{Binding DataContext.SetFontCommand, RelativeSource={RelativeSource AncestorType=ScrollViewer}}" CommandParameter="{Binding}">
                                                    <RadioButton.IsChecked>
                                                        <MultiBinding Converter="{StaticResource StringsEqual}" Mode="OneWay">
                                                            <Binding/>
                                                            <Binding Path="DataContext.FontFamily" RelativeSource="{RelativeSource AncestorType=ScrollViewer}"/>
                                                        </MultiBinding>
                                                    </RadioButton.IsChecked>
                                                </RadioButton>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Grid Margin="0,2,0,8" Height="34">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="104"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="52"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{x:Static r:Strings.Wid_Cantos}" Style="{StaticResource SystemItemTitle}" VerticalAlignment="Center"/>
                                        <Slider Grid.Column="1" Minimum="0" Maximum="24" IsSnapToTickEnabled="True" TickFrequency="1"
                                                Value="{Binding CornerRadius}" AutomationProperties.Name="{x:Static r:Strings.Wid_ArredondamentoCantos}"/>
                                        <TextBlock Grid.Column="2" Text="{Binding CornerRadius}" Style="{StaticResource WidgetSliderValue}"/>
                                    </Grid>
                                    <WrapPanel>
                                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding ShowLabels}" Content="{x:Static r:Strings.Wid_Nomes}" Margin="0,4,16,4"/>
                                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding ShowBars}" Content="{x:Static r:Strings.Wid_Barras}" Margin="0,4,16,4"/>
                                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding ShowBorder}" Content="{x:Static r:Strings.Wid_Borda}"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="{x:Static r:Strings.Wid_Comportamento}" Style="{StaticResource SystemTab}">
                    <ScrollViewer Style="{StaticResource SystemScroll}">
                        <StackPanel Margin="0,0,0,24">
                            <Border Style="{StaticResource SystemPanel}" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="{x:Static r:Strings.Wid_JanelaFlutuante}" Style="{StaticResource SystemSectionTitle}" Margin="0,0,0,12"/>
                                    <Border Style="{StaticResource SystemRow}">
                                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding AlwaysOnTop}">
                                            <StackPanel>
                                                <TextBlock Text="{x:Static r:Strings.Mini_AlwaysOnTop}" Style="{StaticResource SystemItemTitle}"/>
                                                <TextBlock Text="{x:Static r:Strings.Wid_MantemWidgetAcimaJanelas}" Style="{StaticResource SystemDetail}"/>
                                            </StackPanel>
                                        </CheckBox>
                                    </Border>
                                    <Border Style="{StaticResource SystemRow}">
                                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding HideInFullscreen}">
                                            <StackPanel>
                                                <TextBlock Text="{x:Static r:Strings.Wid_OcultarTelaCheia}" Style="{StaticResource SystemItemTitle}"/>
                                                <TextBlock Text="{x:Static r:Strings.Wid_OcultaSoQuandoTela}" Style="{StaticResource SystemDetail}" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </CheckBox>
                                    </Border>
                                    <Border Style="{StaticResource SystemRow}">
                                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding ClickThrough}">
                                            <StackPanel>
                                                <TextBlock Text="{x:Static r:Strings.Wid_DeixarCliquesPassarem}" Style="{StaticResource SystemItemTitle}"/>
                                                <TextBlock Text="{x:Static r:Strings.Wid_MouseInterageJanelaAtras}"
                                                           Style="{StaticResource SystemDetail}"/>
                                            </StackPanel>
                                        </CheckBox>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource SystemPanel}" Margin="0,0,0,12">
                                <StackPanel>
                                    <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding ShowInGames}">
                                        <StackPanel>
                                            <TextBlock Text="{x:Static r:Strings.Wid_OverlayJogosRTSS}" Style="{StaticResource SystemItemTitle}"/>
                                            <TextBlock Text="{x:Static r:Strings.Wid_MostraLeiturasWidgetJogos}"
                                                       Style="{StaticResource SystemDetail}" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </CheckBox>
                                    <TextBlock Text="{Binding GameOverlayStatus}" Style="{StaticResource SystemDetail}"
                                               Margin="44,8,0,0" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"
                                               Visibility="{Binding ShowInGames, Converter={StaticResource BoolToVis}}"/>
                                    <Button Style="{StaticResource SystemLinkButton}" Content="{x:Static r:Strings.Wid_BaixarRTSS}" Click="OpenRtssDownload_Click"
                                            HorizontalAlignment="Left" Margin="44,4,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource SystemPanel}">
                                <StackPanel>
                                    <TextBlock Text="{x:Static r:Strings.Wid_Posicao}" Style="{StaticResource SystemSectionTitle}"/>
                                    <TextBlock Text="{x:Static r:Strings.Wid_UseAtalhosAbaixoOu}" Style="{StaticResource SystemDetail}" Margin="0,2,0,10"/>
                                    <WrapPanel>
                                        <Button Style="{StaticResource ChipButton}" Content="{x:Static r:Strings.Wid_SuperiorEsquerdo}" Tag="TopLeft" Click="Corner_Click"/>
                                        <Button Style="{StaticResource ChipButton}" Content="{x:Static r:Strings.Wid_TopoCentral}" Tag="TopCenter" Click="Corner_Click"/>
                                        <Button Style="{StaticResource ChipButton}" Content="{x:Static r:Strings.Wid_SuperiorDireito}" Tag="TopRight" Click="Corner_Click"/>
                                        <Button Style="{StaticResource ChipButton}" Content="{x:Static r:Strings.Wid_InferiorEsquerdo}" Tag="BottomLeft" Click="Corner_Click"/>
                                        <Button Style="{StaticResource ChipButton}" Content="{x:Static r:Strings.Wid_InferiorDireito}" Tag="BottomRight" Click="Corner_Click"/>
                                    </WrapPanel>
                                    <Border Style="{StaticResource SystemRow}" Margin="0,4,0,0">
                                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding SnapToEdges}" Content="{x:Static r:Strings.Wid_EncaixarBordas}"/>
                                    </Border>
                                    <Border Style="{StaticResource SystemRow}">
                                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding LockPosition}" Content="{x:Static r:Strings.Mini_LockPosition}"/>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </DockPanel>
    </Grid>
</UserControl>
