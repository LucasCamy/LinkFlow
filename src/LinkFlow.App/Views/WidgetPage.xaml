<UserControl x:Class="LinkFlow.App.Views.WidgetPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:LinkFlow.App.Controls"
             xmlns:views="clr-namespace:LinkFlow.App.Views"
             xmlns:vm="clr-namespace:LinkFlow.App.ViewModels">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                  DataContext="{Binding Widget, RelativeSource={RelativeSource AncestorType=Window}}">
        <StackPanel Margin="8,8,20,24">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Widget" Style="{StaticResource PageTitle}"/>
                    <TextBlock Text="Um painel pequeno sempre à vista: escolha as informações, o visual e como ele se comporta." Style="{StaticResource PageSubtitle}"/>
                </StackPanel>
                <ToggleButton Grid.Column="1" Style="{StaticResource Chip}" Margin="0" VerticalAlignment="Center" IsChecked="{Binding IsWidgetVisible, Mode=OneWay}"
                              Click="ToggleWidget_Click" ToolTip="Ctrl+Alt+M de qualquer lugar">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE8A7;" FontSize="13" Margin="0,0,8,0"/>
                        <TextBlock Text="Mostrar widget"/>
                    </StackPanel>
                </ToggleButton>
            </Grid>

            <c:AdaptiveUniformGrid MinItemWidth="400" MaxColumns="2" Margin="0,16,-12,0">
                <StackPanel>
                    <!-- ================================================= Prévia -->
                    <Border Style="{StaticResource GridCard}">
                        <StackPanel>
                            <TextBlock Text="Prévia" Style="{StaticResource SectionTitle}"/>
                            <Border Margin="0,12,0,0" CornerRadius="10" MinHeight="170" Padding="16" ClipToBounds="True">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#1E3A5F" Offset="0"/>
                                        <GradientStop Color="#3B1F4F" Offset="0.55"/>
                                        <GradientStop Color="#0F2A2E" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <views:WidgetView HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="{Binding Opacity}"/>
                            </Border>
                            <TextBlock Text="Fundo de exemplo simulando a área de trabalho." Style="{StaticResource Caption}" Margin="0,6,0,0"/>

                            <TextBlock Text="Posição" Style="{StaticResource Label}" Margin="0,14,0,6"/>
                            <WrapPanel>
                                <Button Style="{StaticResource ChipButton}" Content="↖ Superior esquerdo" Tag="TopLeft" Click="Corner_Click"/>
                                <Button Style="{StaticResource ChipButton}" Content="↑ Topo central" Tag="TopCenter" Click="Corner_Click"/>
                                <Button Style="{StaticResource ChipButton}" Content="↗ Superior direito" Tag="TopRight" Click="Corner_Click"/>
                                <Button Style="{StaticResource ChipButton}" Content="↙ Inferior esquerdo" Tag="BottomLeft" Click="Corner_Click"/>
                                <Button Style="{StaticResource ChipButton}" Content="↘ Inferior direito" Tag="BottomRight" Click="Corner_Click"/>
                            </WrapPanel>
                            <TextBlock Text="Ou arraste o widget; perto da borda ele gruda sozinho." Style="{StaticResource Caption}"/>
                        </StackPanel>
                    </Border>

                    <!-- ================================================= Itens -->
                    <Border Style="{StaticResource GridCard}">
                        <StackPanel>
                            <TextBlock Text="Informações no widget" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Text="A ordem aqui é a ordem no widget. Onde houver as duas formas, escolha % ou valor real." Style="{StaticResource Caption}" Margin="0,2,0,10"/>
                            <TextBlock Text="Nenhuma informação ainda: adicione ao lado." Style="{StaticResource Caption}" FontSize="13"
                                       Visibility="{Binding HasItems, Converter={StaticResource BoolToVisInverse}}"/>
                            <ItemsControl ItemsSource="{Binding Items}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource BgBrush}" CornerRadius="10" Padding="12,8,6,8" Margin="0,0,0,6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Ellipse Width="9" Height="9" Fill="{Binding Color, Converter={StaticResource HexToBrush}}" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding FullLabel}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Style="{StaticResource Caption}">
                                                        <Run Text="{Binding Group, Mode=OneWay}"/><Run Text=" • agora "/><Run Text="{Binding Text, Mode=OneWay}"/>
                                                    </TextBlock>
                                                </StackPanel>
                                                <Button Grid.Column="2" Style="{StaticResource ChipButton}" Margin="8,0,6,0" MinWidth="58" Content="{Binding DisplayLabel}"
                                                        ToolTip="Alternar entre % e valor real"
                                                        Command="{Binding DataContext.ToggleDisplayCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"
                                                        Visibility="{Binding CanToggleDisplay, Converter={StaticResource BoolToVis}}"/>
                                                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Button Style="{StaticResource IconButton}" Width="28" Height="28" FontSize="11" Content="&#xE70E;" ToolTip="Mover para cima"
                                                            Command="{Binding DataContext.MoveUpCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"/>
                                                    <Button Style="{StaticResource IconButton}" Width="28" Height="28" FontSize="11" Content="&#xE70D;" ToolTip="Mover para baixo"
                                                            Command="{Binding DataContext.MoveDownCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"/>
                                                    <Button Style="{StaticResource IconButton}" Width="28" Height="28" FontSize="11" Content="&#xE711;" ToolTip="Remover"
                                                            Foreground="{StaticResource DangerBrush}"
                                                            Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- ================================================= Comportamento -->
                    <Border Style="{StaticResource GridCard}">
                        <StackPanel>
                            <TextBlock Text="Comportamento" Style="{StaticResource SectionTitle}" Margin="0,0,0,8"/>
                            <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding AlwaysOnTop}">
                                <StackPanel>
                                    <TextBlock Text="Sempre no topo"/>
                                    <TextBlock Text="Fica por cima das outras janelas" Style="{StaticResource Caption}"/>
                                </StackPanel>
                            </CheckBox>
                            <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding HideInFullscreen}">
                                <StackPanel>
                                    <TextBlock Text="Esconder em jogos e tela cheia"/>
                                    <TextBlock Text="Some durante jogos, vídeos em tela cheia e apresentações; volta sozinho" Style="{StaticResource Caption}"/>
                                </StackPanel>
                            </CheckBox>
                            <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding ClickThrough}">
                                <StackPanel>
                                    <TextBlock Text="Clique atravessa o widget"/>
                                    <TextBlock Text="O mouse passa por ele (não atrapalha o que está atrás). Para mexer de novo, desligue aqui" Style="{StaticResource Caption}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </CheckBox>
                            <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding SnapToEdges}">
                                <StackPanel>
                                    <TextBlock Text="Grudar nas bordas"/>
                                    <TextBlock Text="Ao soltar perto da borda da tela, encaixa certinho" Style="{StaticResource Caption}"/>
                                </StackPanel>
                            </CheckBox>
                            <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding LockPosition}">
                                <StackPanel>
                                    <TextBlock Text="Travar posição"/>
                                    <TextBlock Text="Evita arrastar sem querer" Style="{StaticResource Caption}"/>
                                </StackPanel>
                            </CheckBox>
                            <TextBlock Text="Consumo: o widget atualiza 1x por segundo só enquanto está visível; escondido em jogos, não gasta nada." Style="{StaticResource Caption}"
                                       TextWrapping="Wrap" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel>
                    <!-- ================================================= Adicionar -->
                    <Border Style="{StaticResource GridCard}">
                        <StackPanel>
                            <TextBlock Text="Adicionar informação" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Text="Clique para adicionar ou tirar. Discos físicos aparecem depois de alguns segundos com esta aba aberta." Style="{StaticResource Caption}"
                                       TextWrapping="Wrap" Margin="0,2,0,8"/>
                            <ItemsControl ItemsSource="{Binding Picker}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,4,0,4">
                                            <TextBlock Text="{Binding Name}" Style="{StaticResource Label}" Margin="0,0,0,6"/>
                                            <ItemsControl ItemsSource="{Binding Items}" Focusable="False">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <ToggleButton Style="{StaticResource Chip}" IsChecked="{Binding IsAdded, Mode=OneWay}" Padding="10,5"
                                                                      Command="{Binding DataContext.AddCommand, RelativeSource={RelativeSource AncestorType=ScrollViewer}}"
                                                                      CommandParameter="{Binding Id}">
                                                            <StackPanel Orientation="Horizontal">
                                                                <Ellipse Width="7" Height="7" Fill="{Binding Color, Converter={StaticResource HexToBrush}}" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                                                <TextBlock Text="{Binding Label}" MaxWidth="260" TextTrimming="CharacterEllipsis"/>
                                                            </StackPanel>
                                                        </ToggleButton>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- ================================================= Aparência -->
                    <Border Style="{StaticResource GridCard}">
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="Aparência" Style="{StaticResource SectionTitle}" VerticalAlignment="Center"/>
                                <Button Style="{StaticResource GhostButton}" Content="Restaurar padrão" HorizontalAlignment="Right" Command="{Binding ResetCommand}"/>
                            </Grid>

                            <TextBlock Text="Formato" Style="{StaticResource Label}" Margin="0,8,0,6"/>
                            <WrapPanel>
                                <ToggleButton Style="{StaticResource Chip}" Content="Em linha" IsChecked="{Binding IsHorizontal, Mode=OneWay}"
                                              Command="{Binding SetLayoutCommand}" CommandParameter="Horizontal"/>
                                <ToggleButton Style="{StaticResource Chip}" Content="Em coluna" IsChecked="{Binding IsVertical, Mode=OneWay}"
                                              Command="{Binding SetLayoutCommand}" CommandParameter="Vertical"/>
                                <ToggleButton Style="{StaticResource Chip}" Content="Grade" IsChecked="{Binding IsGrid, Mode=OneWay}"
                                              Command="{Binding SetLayoutCommand}" CommandParameter="Grid"/>
                                <StackPanel Orientation="Horizontal" Margin="4,0,0,8" VerticalAlignment="Center" Visibility="{Binding IsGrid, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="Colunas" VerticalAlignment="Center" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,8,0"/>
                                    <Slider Width="110" Minimum="1" Maximum="6" IsSnapToTickEnabled="True" TickFrequency="1" Value="{Binding GridColumns}"/>
                                    <TextBlock Text="{Binding GridColumns}" Width="20" TextAlignment="Right" VerticalAlignment="Center"/>
                                </StackPanel>
                            </WrapPanel>

                            <Grid Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="50"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="34"/><RowDefinition Height="34"/><RowDefinition Height="34"/><RowDefinition Height="34"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="Tamanho" VerticalAlignment="Center"/>
                                <Slider Grid.Column="1" Minimum="0.7" Maximum="2" SmallChange="0.05" LargeChange="0.1" IsSnapToTickEnabled="True" TickFrequency="0.05" Value="{Binding Scale}"/>
                                <TextBlock Grid.Column="2" Text="{Binding ScaleText}" TextAlignment="Right" VerticalAlignment="Center" Foreground="{StaticResource TextMutedBrush}"/>

                                <TextBlock Grid.Row="1" Text="Opacidade" VerticalAlignment="Center"/>
                                <Slider Grid.Row="1" Grid.Column="1" Minimum="0.3" Maximum="1" IsSnapToTickEnabled="True" TickFrequency="0.05" Value="{Binding Opacity}"/>
                                <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding OpacityText}" TextAlignment="Right" VerticalAlignment="Center" Foreground="{StaticResource TextMutedBrush}"/>

                                <TextBlock Grid.Row="2" Text="Fundo" VerticalAlignment="Center" ToolTip="Transparência só do fundo (o texto continua nítido)"/>
                                <Slider Grid.Row="2" Grid.Column="1" Minimum="0" Maximum="1" IsSnapToTickEnabled="True" TickFrequency="0.05" Value="{Binding BackgroundOpacity}"/>
                                <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding BackgroundOpacityText}" TextAlignment="Right" VerticalAlignment="Center" Foreground="{StaticResource TextMutedBrush}"/>

                                <TextBlock Grid.Row="3" Text="Cantos" VerticalAlignment="Center"/>
                                <Slider Grid.Row="3" Grid.Column="1" Minimum="0" Maximum="24" IsSnapToTickEnabled="True" TickFrequency="1" Value="{Binding CornerRadius}"/>
                                <TextBlock Grid.Row="3" Grid.Column="2" Text="{Binding CornerRadius}" TextAlignment="Right" VerticalAlignment="Center" Foreground="{StaticResource TextMutedBrush}"/>
                            </Grid>

                            <TextBlock Text="Cor do fundo" Style="{StaticResource Label}" Margin="0,10,0,6"/>
                            <ItemsControl ItemsSource="{x:Static vm:WidgetViewModel.BackgroundOptions}" Focusable="False">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Width="30" Height="30" Margin="0,0,8,8" Cursor="Hand" ToolTip="{Binding}"
                                                Command="{Binding DataContext.SetBackgroundCommand, RelativeSource={RelativeSource AncestorType=ScrollViewer}}" CommandParameter="{Binding}">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="Sw" CornerRadius="8" BorderThickness="2" BorderBrush="{StaticResource BorderBrush}" Background="{Binding Converter={StaticResource HexToBrush}}"/>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Sw" Property="BorderBrush" Value="{StaticResource TextBrush}"/></Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="Cor dos valores" Style="{StaticResource Label}" Margin="0,6,0,6"/>
                            <WrapPanel>
                                <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding UseSensorColors}" Content="Cada informação com sua cor" Margin="0,0,14,8"/>
                                <ItemsControl ItemsSource="{x:Static vm:WidgetViewModel.AccentOptions}" Focusable="False" VerticalAlignment="Center">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Width="24" Height="24" Margin="0,0,6,8" Cursor="Hand" ToolTip="Cor única"
                                                    Command="{Binding DataContext.SetAccentCommand, RelativeSource={RelativeSource AncestorType=ScrollViewer}}" CommandParameter="{Binding}">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="Sw" CornerRadius="12" BorderThickness="2" BorderBrush="{StaticResource BorderBrush}" Background="{Binding Converter={StaticResource HexToBrush}}"/>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Sw" Property="BorderBrush" Value="{StaticResource TextBrush}"/></Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </WrapPanel>

                            <TextBlock Text="Fonte" Style="{StaticResource Label}" Margin="0,6,0,6"/>
                            <ItemsControl ItemsSource="{x:Static vm:WidgetViewModel.FontOptions}" Focusable="False">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <ToggleButton Style="{StaticResource Chip}" Content="{Binding}" FontFamily="{Binding}"
                                                      Command="{Binding DataContext.SetFontCommand, RelativeSource={RelativeSource AncestorType=ScrollViewer}}" CommandParameter="{Binding}">
                                            <ToggleButton.IsChecked>
                                                <MultiBinding Converter="{StaticResource StringsEqual}" Mode="OneWay">
                                                    <Binding/>
                                                    <Binding Path="DataContext.FontFamily" RelativeSource="{RelativeSource AncestorType=ScrollViewer}"/>
                                                </MultiBinding>
                                            </ToggleButton.IsChecked>
                                        </ToggleButton>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <WrapPanel Margin="0,4,0,0">
                                <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding ShowLabels}" Content="Nomes" Margin="0,0,16,0"/>
                                <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding ShowBars}" Content="Barras" Margin="0,0,16,0"/>
                                <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding ShowBorder}" Content="Borda"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </c:AdaptiveUniformGrid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
