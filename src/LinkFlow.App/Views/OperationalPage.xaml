<UserControl x:Class="LinkFlow.App.Views.OperationalPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:LinkFlow.App.Controls"
             xmlns:t="clr-namespace:LinkFlow.App.Services"
             IsVisibleChanged="Page_IsVisibleChanged" Loaded="Page_Loaded" Unloaded="Page_Unloaded">
    <UserControl.Resources>
        <Style x:Key="OperationalCell" TargetType="TextBlock" BasedOn="{StaticResource SystemDetail}">
            <Setter Property="Margin" Value="0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="OperationalHeader" TargetType="TextBlock" BasedOn="{StaticResource OperationalCell}">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource TextSubtleBrush}"/>
        </Style>
    </UserControl.Resources>
    <ScrollViewer Style="{StaticResource SystemScroll}">
        <StackPanel Margin="0,0,0,24">
            <DockPanel Margin="0,0,0,16">
                <Button DockPanel.Dock="Right" Content="{x:Static t:OperationalText.Refresh}" Command="{Binding RefreshCommand}"
                        Style="{StaticResource SecondaryButton}" Margin="12,0,0,0" VerticalAlignment="Center"/>
                <StackPanel>
                    <TextBlock Text="{x:Static t:OperationalText.Title}" Style="{StaticResource SystemSectionTitle}" FontSize="21"/>
                    <TextBlock Text="{x:Static t:OperationalText.Subtitle}" Style="{StaticResource SystemDetail}"/>
                </StackPanel>
            </DockPanel>

            <c:AdaptiveUniformGrid MinItemWidth="215" MaxColumns="4" Margin="0,0,-12,0">
                <Border Style="{StaticResource SystemPanel}" Margin="0,0,12,12" BorderBrush="{Binding ProtectionColor, Converter={StaticResource HexToBrush}}">
                    <StackPanel>
                        <TextBlock Text="{x:Static t:OperationalText.Protection}" Style="{StaticResource Label}"/>
                        <TextBlock Text="{Binding ProtectionTitle}" Foreground="{Binding ProtectionColor, Converter={StaticResource HexToBrush}}"
                                   FontSize="19" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,8,0,4"/>
                        <TextBlock Text="{Binding ProtectionDetail}" Style="{StaticResource SystemDetail}" FontSize="11"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource SystemPanel}" Margin="0,0,12,12">
                    <StackPanel>
                        <TextBlock Text="{x:Static t:OperationalText.ReadingQuality}" Style="{StaticResource Label}"/>
                        <TextBlock Text="{Binding QualityTitle}" FontSize="25" FontWeight="SemiBold" Foreground="{StaticResource CpuBrush}" Margin="0,8,0,4"/>
                        <TextBlock Text="{Binding QualityDetail}" Style="{StaticResource SystemDetail}" FontSize="11"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource SystemPanel}" Margin="0,0,12,12">
                    <StackPanel>
                        <TextBlock Text="{x:Static t:OperationalText.Configuration}" Style="{StaticResource Label}"/>
                        <TextBlock Text="{Binding PersistenceTitle}" FontSize="19" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,8,0,4"/>
                        <TextBlock Text="{Binding PersistenceDetail}" Style="{StaticResource SystemDetail}" FontSize="11"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource SystemPanel}" Margin="0,0,12,12">
                    <StackPanel>
                        <TextBlock Text="{x:Static t:OperationalText.Storage}" Style="{StaticResource Label}"/>
                        <TextBlock Text="{Binding StorageTitle}" FontSize="19" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,8,0,4"/>
                        <TextBlock Text="{Binding StorageDetail}" Style="{StaticResource SystemDetail}" FontSize="11"/>
                    </StackPanel>
                </Border>
            </c:AdaptiveUniformGrid>

            <Border Style="{StaticResource SystemPanel}" Margin="0,0,0,12">
                <StackPanel>
                    <DockPanel Margin="0,0,0,12">
                        <WrapPanel DockPanel.Dock="Right" Margin="12,0,0,0">
                            <Button Content="{x:Static t:OperationalText.ExportCsv}" Style="{StaticResource GhostButton}" Click="ExportCsv_Click"/>
                            <Button Content="{x:Static t:OperationalText.ExportJson}" Style="{StaticResource GhostButton}" Click="ExportJson_Click"/>
                        </WrapPanel>
                        <TextBlock Text="{x:Static t:OperationalText.History}" Style="{StaticResource SystemSectionTitle}" VerticalAlignment="Center"/>
                    </DockPanel>
                    <WrapPanel>
                        <StackPanel Width="250" Margin="0,0,12,10">
                            <TextBlock Text="{x:Static t:OperationalText.Metric}" Style="{StaticResource Label}" Margin="0,0,0,5"/>
                            <ComboBox ItemsSource="{Binding Metrics}" SelectedItem="{Binding SelectedMetric}" MinHeight="34"/>
                        </StackPanel>
                        <StackPanel Width="160" Margin="0,0,0,10">
                            <TextBlock Text="{x:Static t:OperationalText.Range}" Style="{StaticResource Label}" Margin="0,0,0,5"/>
                            <ComboBox ItemsSource="{Binding Ranges}" SelectedItem="{Binding SelectedRange}" MinHeight="34"/>
                        </StackPanel>
                        <StackPanel Width="250" Margin="12,0,0,10" Visibility="{Binding HasDeviceFilter, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{x:Static t:OperationalText.Device}" Style="{StaticResource Label}" Margin="0,0,0,5"/>
                            <ComboBox ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}" MinHeight="34"/>
                        </StackPanel>
                    </WrapPanel>
                    <c:OperationalHistoryChart Series="{Binding Series}" Height="170" Margin="0,4,0,8"
                                               AutomationProperties.Name="{x:Static t:OperationalText.History}"/>
                    <c:AdaptiveUniformGrid MinItemWidth="125" MaxColumns="6">
                        <StackPanel Margin="0,0,12,8"><TextBlock Text="{x:Static t:OperationalText.Minimum}" Style="{StaticResource Label}"/><TextBlock Text="{Binding Minimum}" FontSize="17" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel>
                        <StackPanel Margin="0,0,12,8"><TextBlock Text="{x:Static t:OperationalText.Maximum}" Style="{StaticResource Label}"/><TextBlock Text="{Binding Maximum}" FontSize="17" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel>
                        <StackPanel Margin="0,0,12,8"><TextBlock Text="{x:Static t:OperationalText.Average}" Style="{StaticResource Label}"/><TextBlock Text="{Binding Average}" FontSize="17" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel>
                        <StackPanel Margin="0,0,12,8"><TextBlock Text="{x:Static t:OperationalText.P95}" Style="{StaticResource Label}"/><TextBlock Text="{Binding P95}" FontSize="17" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel>
                        <StackPanel Margin="0,0,12,8"><TextBlock Text="{x:Static t:OperationalText.Coverage}" Style="{StaticResource Label}"/><TextBlock Text="{Binding Coverage}" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource CpuBrush}" Margin="0,4,0,0"/></StackPanel>
                        <StackPanel Margin="0,0,0,8"><TextBlock Text="{x:Static t:OperationalText.AboveWarning}" Style="{StaticResource Label}"/><TextBlock Text="{Binding AboveWarning}" FontSize="17" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel>
                    </c:AdaptiveUniformGrid>
                    <TextBlock Text="{Binding HistoryDescription}" Style="{StaticResource SystemDetail}" FontSize="11"/>
                    <TextBlock Text="{x:Static t:OperationalText.GapHint}" Style="{StaticResource SystemDetail}" FontSize="11" Margin="0,3,0,10"/>
                    <WrapPanel>
                        <StackPanel Width="250" Margin="0,0,12,8">
                            <TextBlock Text="{x:Static t:OperationalText.Baseline}" Style="{StaticResource Label}" Margin="0,0,0,5"/>
                            <ComboBox ItemsSource="{Binding Sessions}" SelectedItem="{Binding BaselineSession}" MinHeight="34"/>
                        </StackPanel>
                        <StackPanel Width="250" Margin="0,0,12,8">
                            <TextBlock Text="{x:Static t:OperationalText.Candidate}" Style="{StaticResource Label}" Margin="0,0,0,5"/>
                            <ComboBox ItemsSource="{Binding Sessions}" SelectedItem="{Binding CandidateSession}" MinHeight="34"/>
                        </StackPanel>
                        <Button Content="{x:Static t:OperationalText.Compare}" Command="{Binding CompareCommand}" Style="{StaticResource SecondaryButton}" VerticalAlignment="Bottom" Margin="0,0,0,8"/>
                    </WrapPanel>
                    <TextBlock Text="{Binding Comparison}" Style="{StaticResource SystemDetail}"/>
                    <TextBlock Text="{Binding Status}" Style="{StaticResource SystemDetail}" Foreground="{StaticResource CpuBrush}" FontSize="11" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource SystemPanel}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="{x:Static t:OperationalText.Guidance}" Style="{StaticResource SystemSectionTitle}" Margin="0,0,0,8"/>
                    <ItemsControl ItemsSource="{Binding Guidance}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource SystemRow}">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="4"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <Border Background="{Binding Color, Converter={StaticResource HexToBrush}}" CornerRadius="2"/>
                                        <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="{Binding Color, Converter={StaticResource HexToBrush}}" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding Evidence}" Style="{StaticResource SystemDetail}"/>
                                            <TextBlock Text="{Binding Action}" Style="{StaticResource SystemDetail}" FontSize="11" Margin="0,5,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource SystemPanel}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="{x:Static t:OperationalText.Sensors}" Style="{StaticResource SystemSectionTitle}" Margin="0,0,0,12"/>
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="1.6*"/><ColumnDefinition Width="1.5*"/><ColumnDefinition Width="1.3*"/><ColumnDefinition Width="0.8*"/></Grid.ColumnDefinitions>
                        <TextBlock Text="{x:Static t:OperationalText.Metric}" Style="{StaticResource OperationalHeader}"/>
                        <TextBlock Grid.Column="1" Text="{x:Static t:OperationalText.Source}" Style="{StaticResource OperationalHeader}"/>
                        <TextBlock Grid.Column="2" Text="{x:Static t:OperationalText.ReadingQuality}" Style="{StaticResource OperationalHeader}"/>
                        <TextBlock Grid.Column="3" Text="{x:Static t:OperationalText.LastSuccess}" Style="{StaticResource OperationalHeader}"/>
                        <TextBlock Grid.Column="4" Text="{x:Static t:OperationalText.Failures}" Style="{StaticResource OperationalHeader}"/>
                    </Grid>
                    <ScrollViewer MaxHeight="280" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding Sensors}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource SystemRow}">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="1.6*"/><ColumnDefinition Width="1.5*"/><ColumnDefinition Width="1.3*"/><ColumnDefinition Width="0.8*"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Label}" Style="{StaticResource OperationalCell}" Foreground="{StaticResource TextBrush}" ToolTip="{Binding Key}" Margin="0,0,8,0"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Source}" Style="{StaticResource OperationalCell}" Margin="0,0,8,0"/>
                                            <StackPanel Grid.Column="2" Margin="0,0,6,0"><TextBlock Text="{Binding State}" TextWrapping="Wrap" Foreground="{Binding Color, Converter={StaticResource HexToBrush}}"/><TextBlock Text="{Binding Reason}" Style="{StaticResource OperationalHeader}" FontSize="10"/></StackPanel>
                                            <TextBlock Grid.Column="3" Text="{Binding Age}" Style="{StaticResource OperationalCell}" ToolTip="{Binding LastSuccess}"/>
                                            <TextBlock Grid.Column="4" Text="{Binding Failures}" Style="{StaticResource OperationalCell}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <TextBlock Text="{x:Static t:OperationalText.NoSensors}" Style="{StaticResource SystemDetail}" Visibility="{Binding HasSensors, Converter={StaticResource BoolToVisInverse}}"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource SystemPanel}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="{x:Static t:OperationalText.Fans}" Style="{StaticResource SystemSectionTitle}" Margin="0,0,0,12"/>
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="1.3*"/><ColumnDefinition Width="1.5*"/><ColumnDefinition Width="2.1*"/></Grid.ColumnDefinitions>
                        <TextBlock Text="{x:Static t:OperationalText.Supported}" Style="{StaticResource OperationalHeader}"/>
                        <TextBlock Grid.Column="1" Text="{x:Static t:OperationalText.Requested}" Style="{StaticResource OperationalHeader}"/>
                        <TextBlock Grid.Column="2" Text="{x:Static t:OperationalText.Accepted}" Style="{StaticResource OperationalHeader}"/>
                        <TextBlock Grid.Column="3" Text="{x:Static t:OperationalText.Measured}" Style="{StaticResource OperationalHeader}"/>
                        <TextBlock Grid.Column="4" Text="{x:Static t:OperationalText.ControlRule}" Style="{StaticResource OperationalHeader}"/>
                    </Grid>
                    <ScrollViewer MaxHeight="350" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding Fans}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource SystemRow}">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="1.3*"/><ColumnDefinition Width="1.5*"/><ColumnDefinition Width="2.1*"/></Grid.ColumnDefinitions>
                                            <StackPanel Margin="0,0,8,0"><TextBlock Text="{Binding Name}" TextWrapping="Wrap" FontWeight="SemiBold"/><TextBlock Text="{Binding Capabilities}" Style="{StaticResource OperationalHeader}" FontSize="10" ToolTip="{Binding Model}"/></StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding Requested}" Style="{StaticResource OperationalCell}"/>
                                            <TextBlock Grid.Column="2" Text="{Binding Accepted}" Style="{StaticResource OperationalCell}"/>
                                            <StackPanel Grid.Column="3"><TextBlock Text="{Binding Rpm}" TextWrapping="Wrap" Foreground="{Binding Color, Converter={StaticResource HexToBrush}}"/><TextBlock Text="{Binding State}" Style="{StaticResource OperationalHeader}" FontSize="10"/></StackPanel>
                                            <TextBlock Grid.Column="4" Text="{Binding Reason}" Style="{StaticResource OperationalCell}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource SystemPanel}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="{x:Static t:OperationalText.Commands}" Style="{StaticResource SystemSectionTitle}"/>
                    <TextBlock Text="{x:Static t:OperationalText.ConfirmationHint}" Style="{StaticResource SystemDetail}" FontSize="11" Margin="0,4,0,8"/>
                    <ScrollViewer MaxHeight="280" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding Commands}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource SystemRow}">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="1.4*"/><ColumnDefinition Width="1.6*"/><ColumnDefinition Width="1.2*"/></Grid.ColumnDefinitions>
                                            <StackPanel Margin="0,0,8,0"><TextBlock Text="{Binding Action}" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding Detail}" Style="{StaticResource OperationalHeader}" FontSize="10" TextWrapping="Wrap" ToolTip="{Binding Id}"/></StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding State}" Foreground="{Binding Color, Converter={StaticResource HexToBrush}}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <StackPanel Grid.Column="2"><TextBlock Text="{Binding Confirmation}" Style="{StaticResource OperationalCell}"/><TextBlock Text="{Binding Persistence}" Style="{StaticResource OperationalHeader}" FontSize="10"/></StackPanel>
                                            <TextBlock Grid.Column="3" Text="{Binding When}" Style="{StaticResource OperationalCell}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <TextBlock Text="{x:Static t:OperationalText.NoCommands}" Style="{StaticResource SystemDetail}" Visibility="{Binding HasCommands, Converter={StaticResource BoolToVisInverse}}"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource SystemPanel}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="{x:Static t:OperationalText.Inventory}" Style="{StaticResource SystemSectionTitle}"/>
                    <TextBlock Text="{Binding InventorySummary}" Style="{StaticResource SystemDetail}" Margin="0,5,0,8"/>
                    <ItemsControl ItemsSource="{Binding InventoryChanges}">
                        <ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource SystemRow}"><StackPanel><TextBlock Text="{Binding Label}" FontWeight="SemiBold"/><TextBlock Text="{Binding Detail}" Style="{StaticResource SystemDetail}"/><TextBlock Text="{Binding When}" Style="{StaticResource OperationalHeader}" FontSize="10"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource SystemPanel}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="{x:Static t:OperationalText.WindowsOperations}" Style="{StaticResource SystemSectionTitle}" Margin="0,0,0,8"/>
                    <ItemsControl ItemsSource="{Binding WindowsOperations}">
                        <ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource SystemRow}"><StackPanel><DockPanel><TextBlock DockPanel.Dock="Right" Text="{Binding State}" Foreground="{Binding Color, Converter={StaticResource HexToBrush}}" Margin="12,0,0,0"/><TextBlock Text="{Binding Action}" FontWeight="SemiBold" TextWrapping="Wrap"/></DockPanel><TextBlock Text="{Binding Detail}" Style="{StaticResource SystemDetail}"/><TextBlock Text="{Binding Confirmation}" Style="{StaticResource OperationalHeader}" FontSize="10"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{x:Static t:OperationalText.NoWindowsOperations}" Style="{StaticResource SystemDetail}" Visibility="{Binding HasWindowsOperations, Converter={StaticResource BoolToVisInverse}}"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource SystemPanel}">
                <StackPanel>
                    <TextBlock Text="{x:Static t:OperationalText.Timeline}" Style="{StaticResource SystemSectionTitle}" Margin="0,0,0,8"/>
                    <ScrollViewer MaxHeight="320" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding Events}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource SystemRow}">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding When}" Style="{StaticResource OperationalCell}" VerticalAlignment="Top" Margin="0,0,10,0"/>
                                            <StackPanel Grid.Column="1"><TextBlock Text="{Binding Label}" FontWeight="SemiBold" Foreground="{Binding Color, Converter={StaticResource HexToBrush}}"/><TextBlock Text="{Binding Detail}" Style="{StaticResource SystemDetail}"/><TextBlock Text="{Binding Source}" Style="{StaticResource OperationalHeader}" FontSize="10"/></StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <TextBlock Text="{x:Static t:OperationalText.NoEvents}" Style="{StaticResource SystemDetail}" Visibility="{Binding HasEvents, Converter={StaticResource BoolToVisInverse}}"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
