<UserControl x:Class="LinkFlow.App.Views.FleetPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:LinkFlow.App.Controls"
             xmlns:vm="clr-namespace:LinkFlow.App.ViewModels"
             IsVisibleChanged="Page_IsVisibleChanged">
    <ScrollViewer Style="{StaticResource SystemScroll}">
        <StackPanel Margin="0,0,0,24">
            <c:AdaptiveUniformGrid MinItemWidth="320" MaxColumns="2" StackColumns="True" Margin="0,0,0,16">
                <StackPanel><TextBlock Text="{x:Static vm:FleetText.Title}" Style="{StaticResource SystemSectionTitle}" FontSize="21"/>
                    <TextBlock Text="{x:Static vm:FleetText.Subtitle}" Style="{StaticResource SystemDetail}"/></StackPanel>
                <Button Content="{x:Static vm:FleetText.Refresh}" Style="{StaticResource SecondaryButton}" Click="Refresh_Click" IsEnabled="{Binding CanEdit}"
                        HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,6,0,0"/>
            </c:AdaptiveUniformGrid>
            <TextBlock Text="{Binding Status}" Style="{StaticResource SystemDetail}" Foreground="{StaticResource WarningBrush}" AutomationProperties.LiveSetting="Polite" Margin="0,0,0,10"/>
            <Border Style="{StaticResource SystemPanel}" Margin="0,0,0,12"><StackPanel>
                <TextBlock Text="{x:Static vm:FleetText.Pair}" Style="{StaticResource SystemSectionTitle}"/>
                <TextBlock Text="{x:Static vm:FleetText.PairHint}" Style="{StaticResource SystemDetail}" Margin="0,8,0,12"/>
                <c:AdaptiveUniformGrid MinItemWidth="250" MaxColumns="3" BalanceRows="False" StackColumns="True" IsEnabled="{Binding CanEdit}" Margin="0,0,-12,-8">
                    <StackPanel Margin="0,0,12,8"><TextBlock Text="{x:Static vm:FleetText.Name}" Style="{StaticResource Label}" Margin="0,0,0,6"/><TextBox x:Name="NewPeerNameBox" MinHeight="34" Text="{Binding NewName, UpdateSourceTrigger=PropertyChanged}" MaxLength="100" AutomationProperties.Name="{x:Static vm:FleetText.Name}"/></StackPanel>
                    <StackPanel Margin="0,0,12,8"><TextBlock Text="{x:Static vm:FleetText.Host}" Style="{StaticResource Label}" Margin="0,0,0,6"/><TextBox x:Name="NewPeerHostBox" MinHeight="34" Text="{Binding NewHost, UpdateSourceTrigger=PropertyChanged}" MaxLength="253" AutomationProperties.Name="{x:Static vm:FleetText.Host}"/></StackPanel>
                    <StackPanel Margin="0,0,12,8">
                        <TextBlock Text="{x:Static vm:FleetText.Port}" Style="{StaticResource Label}" Margin="0,0,0,6"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" MaxWidth="110"/></Grid.ColumnDefinitions>
                            <TextBox x:Name="NewPeerPortBox" MinHeight="34" Text="{Binding NewPort, UpdateSourceTrigger=PropertyChanged}" MaxLength="5" AutomationProperties.Name="{x:Static vm:FleetText.Port}"/>
                        </Grid>
                    </StackPanel>
                </c:AdaptiveUniformGrid>
                <TextBlock Text="{x:Static vm:FleetText.Pin}" Style="{StaticResource Label}" Margin="0,12,0,6"/>
                <TextBox x:Name="NewPeerPinBox" MinHeight="34" Text="{Binding NewPin, UpdateSourceTrigger=PropertyChanged}" MaxLength="95" IsEnabled="{Binding CanEdit}" AutomationProperties.Name="{x:Static vm:FleetText.Pin}"/>
                <TextBlock Text="{x:Static vm:FleetText.Token}" Style="{StaticResource Label}" Margin="0,12,0,6"/>
                <PasswordBox x:Name="PairingToken" MaxLength="256" MinHeight="34" Padding="10,7" VerticalContentAlignment="Center" Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}" BorderBrush="{StaticResource BorderBrush}" IsEnabled="{Binding CanEdit}" AutomationProperties.Name="{x:Static vm:FleetText.Token}"/>
                <Button x:Name="PairPeerButton" Content="{x:Static vm:FleetText.Pair}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Margin="0,12,0,0" Click="Pair_Click" IsEnabled="{Binding CanEdit}"/>
            </StackPanel></Border>
            <TextBlock Text="{x:Static vm:FleetText.Empty}" Style="{StaticResource SystemDetail}" Visibility="{Binding HasPeers, Converter={StaticResource BoolToVisInverse}}" Margin="0,0,0,12"/>
            <ListBox ItemsSource="{Binding Peers}" SelectedItem="{Binding Selected}" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch" MaxHeight="320">
                <ListBox.ItemTemplate><DataTemplate><Border Style="{StaticResource SystemPanel}" Margin="0,0,0,8"><StackPanel>
                    <TextBlock Text="{Binding Name}" Style="{StaticResource SystemItemTitle}" ToolTip="{Binding Name}"/>
                    <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Foreground="{StaticResource WarningBrush}" Margin="0,4,0,0"/>
                    <TextBlock Text="{Binding Address}" Style="{StaticResource SystemDetail}" ToolTip="{Binding Address}"/>
                    <TextBlock Text="{Binding Readings}" Style="{StaticResource SystemDetail}" Margin="0,8,0,0"/>
                </StackPanel></Border></DataTemplate></ListBox.ItemTemplate>
            </ListBox>
            <Border Style="{StaticResource SystemPanel}" Margin="0,12,0,0" Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}"><StackPanel>
                <TextBlock Text="{Binding SelectedDetail}" Style="{StaticResource SystemDetail}"/>
                <WrapPanel Margin="0,12,-8,0" IsEnabled="{Binding CanEdit}">
                    <ComboBox x:Name="PeerProfileComboBox" ItemsSource="{Binding Profiles}" DisplayMemberPath="Label" SelectedValuePath="Key" SelectedValue="{Binding SelectedProfile}" Width="180" VerticalAlignment="Center" Margin="0,0,8,8"/>
                    <Button Content="{x:Static vm:FleetText.Apply}" Style="{StaticResource PrimaryButton}" IsEnabled="{Binding Selected.CanControl}" Click="ApplyProfile_Click" VerticalAlignment="Center" Margin="0,0,8,8"/>
                    <Button Content="{x:Static vm:FleetText.History}" Style="{StaticResource SecondaryButton}" Click="QueryHistory_Click" VerticalAlignment="Center" Margin="0,0,8,8"/>
                    <Button Content="{x:Static vm:FleetText.Export}" Style="{StaticResource SecondaryButton}" IsEnabled="{Binding CanExport}" Click="Export_Click" VerticalAlignment="Center" Margin="0,0,8,8"/>
                    <Button Content="{x:Static vm:FleetText.Remove}" Style="{StaticResource GhostButton}" Click="Remove_Click" VerticalAlignment="Center" Margin="0,0,8,8"/>
                </WrapPanel>
                <TextBlock Text="{Binding HistorySummary}" Style="{StaticResource SystemDetail}"/>
            </StackPanel></Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
