<UserControl x:Class="LinkFlow.App.Views.FailSafeBanner"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="False">
    <!-- Faixa do modo de segurança (DataContext: FailSafeBannerViewModel). Vermelha enquanto protege, âmbar ao recuperar. -->
    <Border Padding="14,10" CornerRadius="10" BorderThickness="1"
            AutomationProperties.LiveSetting="Assertive" AutomationProperties.Name="{Binding Title}">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="Background" Value="{StaticResource DangerSoftBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource DangerBrush}"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsRecovering}" Value="True">
                        <Setter Property="Background" Value="{StaticResource WarningSoftBrush}"/>
                        <Setter Property="BorderBrush" Value="{StaticResource WarningBrush}"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <DockPanel>
            <TextBlock DockPanel.Dock="Left" Text="&#xE7BA;" FontSize="20" Margin="2,0,14,0"
                       VerticalAlignment="Center">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource Icon}">
                        <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsRecovering}" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource WarningBrush}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <StackPanel VerticalAlignment="Center">
                <TextBlock FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{StaticResource TextBrush}">
                    <Run Text="{Binding Title, Mode=OneWay}"/><Run Text=" · " Foreground="{StaticResource TextSubtleBrush}"/><Run Text="{Binding Status, Mode=OneWay}"/>
                </TextBlock>
                <TextBlock Text="{Binding Reason}" Foreground="{StaticResource TextMutedBrush}" FontSize="12.5" Margin="0,2,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </DockPanel>
    </Border>
</UserControl>
