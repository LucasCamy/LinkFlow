<UserControl x:Class="LinkFlow.App.Views.HardwareDetailPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:LinkFlow.App.Controls"
             xmlns:r="clr-namespace:LinkFlow.App.Resources"
             PreviewKeyDown="Panel_PreviewKeyDown">
    <UserControl.Resources>
        <!-- Valor da ficha: texto selecionável (para copiar um part number, por exemplo), sem aparência de campo -->
        <Style x:Key="SpecValue" TargetType="TextBox">
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="IsReadOnlyCaretVisible" Value="False"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="SelectionBrush" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="-2,0,0,0"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <!-- Decorator em vez de ScrollViewer: a roda do mouse continua rolando o modal -->
                        <Decorator x:Name="PART_ContentHost"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- Fundo escurecido: clicar fora fecha (mesmo padrão dos Detalhes do Painel) -->
    <Grid x:Name="Backdrop" Background="#B3050913" MouseLeftButtonDown="Backdrop_MouseLeftButtonDown">
        <Border x:Name="Panel" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                CornerRadius="14" MaxWidth="960" Margin="24,20" VerticalAlignment="Center" MouseLeftButtonDown="Panel_MouseLeftButtonDown"
                AutomationProperties.Name="{Binding Title}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="40" ShadowDepth="0" Opacity="0.55" Color="Black"/>
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Cabeçalho -->
                <Grid Margin="22,18,14,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="44" Height="44" CornerRadius="12" Background="{StaticResource SurfaceAltBrush}" Margin="0,0,14,0">
                        <TextBlock Style="{StaticResource Icon}" Text="{Binding Icon}" FontSize="18"
                                   Foreground="{Binding Color, Converter={StaticResource HexToBrush}}"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}" Style="{StaticResource Label}"/>
                        <TextBlock Text="{Binding Subtitle}" FontSize="19" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding Subtitle}"/>
                    </StackPanel>
                    <Button x:Name="CloseButton" Grid.Column="2" Style="{StaticResource IconButton}" Content="&#xE711;" VerticalAlignment="Top"
                            Command="{Binding CloseCommand}" ToolTip="{x:Static r:Strings.Det_CloseTip}" AutomationProperties.Name="{x:Static r:Strings.Det_CloseName}"/>
                </Grid>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,8,0,0">
                    <StackPanel Margin="22,4,22,20">
                        <!-- Telemetria ao vivo (snapshot do engine) -->
                        <StackPanel Visibility="{Binding HasLive, Converter={StaticResource BoolToVis}}" Margin="0,4,0,8">
                            <DockPanel Margin="0,0,0,8">
                                <TextBlock DockPanel.Dock="Right" Text="{Binding LiveSource}" Style="{StaticResource Caption}" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" MaxWidth="420" TextWrapping="NoWrap"/>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="8" Height="8" Fill="{StaticResource SuccessBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="{x:Static r:Strings.Hwi_LiveTitle}" Style="{StaticResource SectionTitle}"/>
                                </StackPanel>
                            </DockPanel>
                            <ItemsControl ItemsSource="{Binding LiveTiles}" Focusable="False" Margin="0,0,-10,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <c:AdaptiveUniformGrid MinItemWidth="150" MaxColumns="5"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource BgBrush}" CornerRadius="10" Padding="14,10" Margin="0,0,10,10">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Label}" Style="{StaticResource Label}" TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding Label}"/>
                                                <TextBlock Text="{Binding Value}" FontSize="20" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                                           Foreground="{Binding DataContext.Color, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource HexToBrush}}"/>
                                                <TextBlock Text="{Binding Hint}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                                                           ToolTip="{Binding Hint}" Visibility="{Binding Hint, Converter={StaticResource NullToVis}}"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <StackPanel Visibility="{Binding HasChart, Converter={StaticResource BoolToVis}}">
                                <ItemsControl ItemsSource="{Binding SeriesOptions}" Focusable="False" Margin="0,2,0,6">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <ToggleButton Style="{StaticResource Chip}" Content="{Binding Label}"
                                                          Command="{Binding DataContext.SetSeriesCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                          CommandParameter="{Binding Key}">
                                                <ToggleButton.IsChecked>
                                                    <MultiBinding Converter="{StaticResource StringsEqual}" Mode="OneWay">
                                                        <Binding Path="Key"/>
                                                        <Binding Path="DataContext.SeriesKey" RelativeSource="{RelativeSource AncestorType=ItemsControl}"/>
                                                    </MultiBinding>
                                                </ToggleButton.IsChecked>
                                            </ToggleButton>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Border Background="{StaticResource BgBrush}" CornerRadius="10" Padding="10,12,14,8">
                                    <c:HistoryChart Height="150" Values="{Binding History}" Unit="{Binding ChartUnit}" MinRange="{Binding ChartMinRange}"
                                                    Stroke="{Binding ChartColor, Converter={StaticResource HexToBrush}}"/>
                                </Border>
                                <TextBlock Text="{Binding ChartStats}" Style="{StaticResource Caption}" Margin="2,6,0,6"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Ficha técnica -->
                        <ItemsControl ItemsSource="{Binding Sections}" Focusable="False" Margin="0,8,-18,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <c:AdaptiveUniformGrid MinItemWidth="380" MaxColumns="2" StackColumns="True" BalanceRows="False"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,18,16">
                                        <TextBlock Text="{Binding Title}" Style="{StaticResource SectionTitle}" Margin="0,0,0,6" TextWrapping="Wrap"/>
                                        <ItemsControl ItemsSource="{Binding Rows}" Focusable="False">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,6">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="150"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{Binding Label}" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap"
                                                                       Margin="0,0,12,0" VerticalAlignment="Top"/>
                                                            <TextBox Grid.Column="1" Text="{Binding Value, Mode=OneWay}" Style="{StaticResource SpecValue}"/>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="{Binding Note}" Style="{StaticResource Caption}" Margin="0,0,0,8"
                                   Visibility="{Binding Note, Converter={StaticResource NullToVis}}"/>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                            <Button Style="{StaticResource SecondaryButton}" Content="{x:Static r:Strings.Hwi_Copy}" Command="{Binding CopyCommand}"
                                    ToolTip="{x:Static r:Strings.Hwi_CopyTip}" Margin="0,0,8,0"/>
                            <Button Style="{StaticResource PrimaryButton}" Content="{x:Static r:Strings.Common_Close}" Command="{Binding CloseCommand}"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
