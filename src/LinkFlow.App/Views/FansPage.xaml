<UserControl x:Class="LinkFlow.App.Views.FansPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:LinkFlow.App.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="8,8,20,24">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Ventoinhas" Style="{StaticResource PageTitle}"/>
                    <TextBlock Text="{Binding FanCountLabel}" Style="{StaticResource PageSubtitle}"/>
                </StackPanel>
                <!-- Modo: fixo / curva -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <ToggleButton Style="{StaticResource Chip}" Margin="0,0,6,0" IsChecked="{Binding IsFixedMode, Mode=OneWay}"
                                  Command="{Binding SetModeCommand}" CommandParameter="Fixed" ToolTip="Mesma potência o tempo todo">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE9E9;" FontSize="13" Margin="0,0,8,0"/>
                            <TextBlock Text="Potência fixa"/>
                        </StackPanel>
                    </ToggleButton>
                    <ToggleButton Style="{StaticResource Chip}" Margin="0" IsChecked="{Binding IsCurveMode, Mode=OneWay}"
                                  Command="{Binding SetModeCommand}" CommandParameter="Curve" ToolTip="A potência acompanha a temperatura">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE9D9;" FontSize="13" Margin="0,0,8,0"/>
                            <TextBlock Text="Curva automática"/>
                        </StackPanel>
                    </ToggleButton>
                </StackPanel>
            </Grid>

            <!-- Perfis -->
            <Border Style="{StaticResource Card}" Margin="0,16,0,12">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Perfis" Style="{StaticResource SectionTitle}" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Style="{StaticResource GhostButton}" Command="{Binding RelinkAllCommand}"
                                ToolTip="Todas as ventoinhas voltam a seguir a potência global">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE71B;" FontSize="12" Margin="0,0,6,0"/>
                                <TextBlock Text="Revincular todas"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                    <ItemsControl ItemsSource="{Binding PresetItems}" Margin="0,10,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <ToggleButton Style="{StaticResource Chip}" IsChecked="{Binding IsActive, Mode=OneWay}" ToolTip="{Binding Tooltip}"
                                              Command="{Binding DataContext.ApplyPresetCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                              CommandParameter="{Binding Key}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Icon}" Text="{Binding Icon}" FontSize="13" Margin="0,0,8,0"/>
                                        <TextBlock Text="{Binding Label}"/>
                                        <TextBlock Text="{Binding Index, StringFormat=' F{0}'}" Foreground="{StaticResource TextSubtleBrush}" Margin="6,0,0,0" FontSize="11" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </ToggleButton>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Perfis salvos pelo usuário -->
                    <ItemsControl ItemsSource="{Binding Profiles}" Visibility="{Binding HasProfiles, Converter={StaticResource BoolToVis}}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,8,8">
                                    <ToggleButton Style="{StaticResource Chip}" Margin="0" Padding="12,7,34,7" IsChecked="{Binding IsActive, Mode=OneWay}"
                                                  Content="{Binding Name}" ToolTip="Aplicar perfil salvo"
                                                  Command="{Binding DataContext.ApplyProfileCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                  CommandParameter="{Binding Name}"/>
                                    <Button Style="{StaticResource IconButton}" Width="26" Height="26" FontSize="9" Content="&#xE711;" HorizontalAlignment="Right" Margin="0,0,4,0"
                                            ToolTip="Excluir perfil" AutomationProperties.Name="Excluir perfil"
                                            Command="{Binding DataContext.DeleteProfileCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding Name}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MaxWidth="380"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*" MaxWidth="9999"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="ProfileNameBox" Text="{Binding NewProfileName, UpdateSourceTrigger=PropertyChanged}" KeyDown="ProfileNameBox_KeyDown"
                                 ToolTip="Nome do perfil (ex.: Jogo, Noite, Render)" MinWidth="200"/>
                        <TextBlock Text="Salvar configuração atual como perfil..." IsHitTestVisible="False" Margin="11,0,0,0" VerticalAlignment="Center"
                                   Foreground="{StaticResource TextSubtleBrush}"
                                   Visibility="{Binding NewProfileName, Converter={StaticResource NullToVisInverse}}"/>
                        <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Command="{Binding SaveProfileCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE74E;" FontSize="13" Margin="0,0,8,0"/>
                                <TextBlock Text="Salvar"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Potência global (modo fixo) -->
            <Border Style="{StaticResource Card}" Visibility="{Binding IsFixedMode, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                        <TextBlock Text="Potência global" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="Ventoinhas vinculadas seguem este valor" Style="{StaticResource Caption}"/>
                    </StackPanel>
                    <Slider Grid.Column="1" Minimum="25" Maximum="100" Value="{Binding GlobalSpeedPercent}" ToolTip="Ctrl+↑ / Ctrl+↓ ajusta 5%"/>
                    <TextBlock Grid.Column="2" Text="{Binding GlobalSpeedFormatted}" FontSize="22" FontWeight="SemiBold" Width="70" TextAlignment="Right"
                               Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- Curva (modo automático) -->
            <Border Style="{StaticResource Card}" Visibility="{Binding IsCurveMode, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Curva de temperatura" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Text="{Binding CurveStatus}" Style="{StaticResource Caption}" Foreground="{StaticResource WarningBrush}"/>
                        </StackPanel>
                        <Button Grid.Column="1" Style="{StaticResource GhostButton}" Content="Restaurar padrão" Command="{Binding ResetCurveCommand}" VerticalAlignment="Top"/>
                    </Grid>
                    <c:CurveEditor x:Name="CurveEditorControl" Grid.Row="1" Height="240" Margin="0,12,0,12"
                                   Points="{Binding CurvePoints}" CurrentTemp="{Binding CurveCurrentTemp}" CurrentOutput="{Binding CurveCurrentOutput}"/>
                    <c:AdaptiveUniformGrid Grid.Row="2" MinItemWidth="280" MaxColumns="2">
                        <StackPanel Margin="0,0,16,8">
                            <TextBlock Text="Sensor de referência" Style="{StaticResource Label}" Margin="0,0,0,6"/>
                            <ComboBox ItemsSource="{Binding CurveSources}" SelectedValuePath="Value" DisplayMemberPath="Label"
                                      SelectedValue="{Binding CurveSourceValue}"/>
                            <TextBlock Text="Para AIO, o líquido reage devagar e evita picos de ruído." Style="{StaticResource Caption}" Margin="0,4,0,0"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,0,8">
                            <Grid Margin="0,0,0,6">
                                <TextBlock Text="Histerese (queda antes de reduzir)" Style="{StaticResource Label}"/>
                                <TextBlock Text="{Binding CurveHysteresisFormatted}" HorizontalAlignment="Right" FontWeight="SemiBold"/>
                            </Grid>
                            <Slider Minimum="0" Maximum="10" Value="{Binding CurveHysteresis}" IsSnapToTickEnabled="True" TickFrequency="1"/>
                            <TextBlock Text="Evita que as ventoinhas fiquem acelerando e desacelerando." Style="{StaticResource Caption}" Margin="0,4,0,0"/>
                        </StackPanel>
                    </c:AdaptiveUniformGrid>
                </Grid>
            </Border>

            <!-- GPU -->
            <Border Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="38" Height="38" CornerRadius="10" Background="#14342A" Margin="0,0,14,0">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE950;" Foreground="{StaticResource GpuBrush}"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding GpuName}" Style="{StaticResource SectionTitle}" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding GpuFanRpmFormatted}" Style="{StaticResource Caption}"/>
                    </StackPanel>
                    <CheckBox Grid.Column="2" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding IsGpuFanAuto}" Content="Automático (vBIOS)"
                              VerticalAlignment="Center"/>
                    <Grid Grid.Row="1" Grid.ColumnSpan="3" Margin="0,14,0,0" Visibility="{Binding IsGpuFanManual, Converter={StaticResource BoolToVis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Controle manual" Style="{StaticResource Label}" VerticalAlignment="Center" Margin="0,0,16,0"/>
                        <Slider Grid.Column="1" Minimum="30" Maximum="100" Value="{Binding GpuFanPercent}" Foreground="{StaticResource GpuBrush}"/>
                        <TextBlock Grid.Column="2" Text="{Binding GpuFanPercentFormatted}" FontSize="16" FontWeight="SemiBold" Width="56" TextAlignment="Right"
                                   Foreground="{StaticResource GpuBrush}" VerticalAlignment="Center"/>
                    </Grid>
                </Grid>
            </Border>

            <!-- Barra de seleção -->
            <Border Style="{StaticResource Card}" Padding="14,10">
                <StackPanel>
                    <WrapPanel VerticalAlignment="Center">
                        <TextBlock Text="Selecionar:" Style="{StaticResource Label}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <Button Style="{StaticResource GhostButton}" Content="Todas" Command="{Binding SelectAllCommand}" ToolTip="Ctrl+A"/>
                        <Button Style="{StaticResource GhostButton}" Content="Só ventoinhas" Command="{Binding SelectFansCommand}"/>
                        <Button Style="{StaticResource GhostButton}" Content="Bomba" Command="{Binding SelectPumpsCommand}"/>
                        <ItemsControl ItemsSource="{Binding AvailableGroups}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource GhostButton}" Content="{Binding}" ToolTip="Selecionar grupo"
                                            Command="{Binding DataContext.SelectGroupCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}" Foreground="{StaticResource AccentBrush}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Style="{StaticResource GhostButton}" Content="Inverter" Command="{Binding InvertSelectionCommand}"/>
                        <Button Style="{StaticResource GhostButton}" Content="Limpar" Command="{Binding ClearSelectionCommand}" ToolTip="Esc"/>
                        <TextBlock Text="{Binding SelectionSummary}" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    </WrapPanel>

                    <!-- Ações em lote -->
                    <Border Background="{StaticResource BgBrush}" CornerRadius="10" Padding="14,10" Margin="0,10,0,0"
                            Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
                        <c:AdaptiveUniformGrid MinItemWidth="330" MaxColumns="2">
                            <Grid Margin="0,4,16,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Aplicar" Style="{StaticResource Label}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <Slider Grid.Column="1" Minimum="25" Maximum="100" Value="{Binding BatchPercent}"/>
                                <TextBlock Grid.Column="2" Text="{Binding BatchPercent, StringFormat={}{0}%}" Width="44" TextAlignment="Right" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <Button Grid.Column="3" Style="{StaticResource PrimaryButton}" Content="Aplicar" Margin="10,0,0,0" Command="{Binding ApplyBatchCommand}"/>
                            </Grid>
                            <WrapPanel Margin="0,4">
                                <Button Style="{StaticResource SecondaryButton}" Margin="0,0,8,6" Command="{Binding LinkSelectedCommand}"
                                        ToolTip="As selecionadas voltam a seguir a potência global">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE71B;" FontSize="12" Margin="0,0,6,0"/>
                                        <TextBlock Text="Vincular ao global"/>
                                    </StackPanel>
                                </Button>
                                <Grid Margin="0,0,8,6">
                                    <TextBox Width="130" Text="{Binding GroupNameInput, UpdateSourceTrigger=PropertyChanged}" ToolTip="Nome do grupo (ex.: Frontal, Topo, Radiador)"/>
                                    <TextBlock Text="Grupo..." IsHitTestVisible="False" Margin="11,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource TextSubtleBrush}"
                                               Visibility="{Binding GroupNameInput, Converter={StaticResource NullToVisInverse}}"/>
                                </Grid>
                                <Button Style="{StaticResource SecondaryButton}" Content="Agrupar" Margin="0,0,8,6" Command="{Binding SetGroupCommand}"/>
                                <Button Style="{StaticResource GhostButton}" Content="Sem grupo" Margin="0,0,0,6" Command="{Binding ClearGroupCommand}"/>
                            </WrapPanel>
                        </c:AdaptiveUniformGrid>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Cartões das ventoinhas -->
            <ItemsControl ItemsSource="{Binding Fans}" Margin="0,0,-12,0" Focusable="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <c:AdaptiveUniformGrid MinItemWidth="300" MaxColumns="4"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border x:Name="Card" Style="{StaticResource GridCard}" Padding="14,12" Cursor="Hand"
                                MouseLeftButtonDown="FanCard_MouseLeftButtonDown" Background="{StaticResource SurfaceBrush}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <CheckBox IsChecked="{Binding IsSelected}" VerticalAlignment="Center" Margin="0,0,10,0" ToolTip="Selecionar"
                                              AutomationProperties.Name="Selecionar ventoinha"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <Grid>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13.5" TextTrimming="CharacterEllipsis"
                                                       ToolTip="Clique duplo para renomear"
                                                       Visibility="{Binding IsEditingName, Converter={StaticResource BoolToVisInverse}}"
                                                       MouseLeftButtonDown="FanName_MouseLeftButtonDown"/>
                                            <TextBox Text="{Binding Name, UpdateSourceTrigger=Explicit}" Padding="6,2" FontSize="13"
                                                     Visibility="{Binding IsEditingName, Converter={StaticResource BoolToVis}}"
                                                     IsVisibleChanged="RenameBox_IsVisibleChanged" KeyDown="RenameBox_KeyDown" LostKeyboardFocus="RenameBox_LostFocus"/>
                                        </Grid>
                                        <TextBlock Text="{Binding ChannelLabel}" Style="{StaticResource Caption}"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding RpmFormatted}" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center"
                                               Foreground="{Binding StatusColor, Converter={StaticResource HexToBrush}}"/>
                                </Grid>
                                <Grid Grid.Row="1" Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Button x:Name="LinkButton" Style="{StaticResource IconButton}" Width="30" Height="28" FontSize="13" Margin="-6,0,6,0"
                                            Content="&#xE71B;" ToolTip="{Binding LinkTooltip}" AutomationProperties.Name="Vincular à potência global"
                                            Command="{Binding DataContext.ToggleLinkCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}" Foreground="{StaticResource AccentBrush}"/>
                                    <Slider x:Name="FanSlider" Grid.Column="1" Minimum="{Binding SliderMinimum}" Maximum="100" Value="{Binding SliderValue}"/>
                                    <TextBlock Grid.Column="2" Text="{Binding PowerFormatted}" Width="42" TextAlignment="Right" VerticalAlignment="Center"
                                               Foreground="{StaticResource TextMutedBrush}"/>
                                </Grid>
                            </Grid>
                        </Border>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="Card" Property="Background" Value="#15253A"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsLinked}" Value="False">
                                <Setter TargetName="LinkButton" Property="Foreground" Value="{StaticResource WarningBrush}"/>
                                <Setter TargetName="LinkButton" Property="Content" Value="&#xE70F;"/>
                                <Setter TargetName="FanSlider" Property="Foreground" Value="{StaticResource WarningBrush}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsStopped}" Value="True">
                                <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource DangerBrush}"/>
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="Nenhum dispositivo do iCUE LINK encontrado ainda. Verifique o cabo USB do hub e se o iCUE está fechado."
                       Style="{StaticResource Caption}" FontSize="13" Margin="0,8,0,0"
                       Visibility="{Binding IsConnected, Converter={StaticResource BoolToVisInverse}}"/>
            <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0"
                       Text="Dica: arraste o slider de uma ventoinha para controlá-la manualmente (ícone de lápis). Clique no ícone para voltar a seguir o global. Clique duplo no nome para renomear."/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
