<UserControl x:Class="LinkFlow.App.Views.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:r="clr-namespace:LinkFlow.App.Resources"
             xmlns:c="clr-namespace:LinkFlow.App.Controls">

    <Grid Margin="24,20,24,0" MaxWidth="1160">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,18">
            <TextBlock Text="{x:Static r:Strings.Nav_Settings}" Style="{StaticResource SystemPageTitle}"/>
            <TextBlock Text="{x:Static r:Strings.Set_PreferenciasLinkFlowProtecaoHardware}" Style="{StaticResource SystemDetail}"/>
        </StackPanel>

        <TabControl x:Name="SettingsTabs" Grid.Row="1" Style="{StaticResource SystemTabs}" SelectedIndex="0">
            <TabItem Header="{x:Static r:Strings.Set_Geral}" Style="{StaticResource SystemTab}">
                <ScrollViewer Style="{StaticResource SystemScroll}">
                    <StackPanel Margin="0,0,0,24">
                        <Border Style="{StaticResource SystemPanel}" DataContext="{Binding Settings, RelativeSource={RelativeSource AncestorType=Window}}">
                            <StackPanel>
                                <DockPanel>
                                    <Border DockPanel.Dock="Left" Style="{StaticResource SystemIconTile}" Margin="0,0,12,0">
                                        <TextBlock Text="&#xE713;" Style="{StaticResource SystemIcon}"/>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{x:Static r:Strings.Set_InicializacaoInterface}" Style="{StaticResource SystemSectionTitle}"/>
                                    </StackPanel>
                                </DockPanel>

                                <StackPanel Margin="0,14,0,-8">
                                    <Border Style="{StaticResource SystemRow}">
                                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding StartWithWindows}" Margin="0"
                                                  AutomationProperties.Name="{x:Static r:Strings.Tray_StartWithWindows}">
                                            <StackPanel>
                                                <TextBlock Text="{x:Static r:Strings.Tray_StartWithWindows}" Style="{StaticResource SystemItemTitle}"/>
                                                <TextBlock Text="{Binding AutoStartMessage, TargetNullValue={x:Static r:Strings.Set_AbreBandejaEntrarWindows}}" Style="{StaticResource SystemDetail}"/>
                                            </StackPanel>
                                        </CheckBox>
                                    </Border>
                                    <Border Style="{StaticResource SystemRow}">
                                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding CloseToTray}" Margin="0"
                                                  AutomationProperties.Name="{x:Static r:Strings.Set_ManterBandejaFecharJanela}">
                                            <StackPanel>
                                                <TextBlock Text="{x:Static r:Strings.Set_ManterBandejaFecharJanela}" Style="{StaticResource SystemItemTitle}"/>
                                                <TextBlock Text="{x:Static r:Strings.Set_LinkFlowContinuaSegundoPlano}" Style="{StaticResource SystemDetail}"/>
                                            </StackPanel>
                                        </CheckBox>
                                    </Border>
                                    <Border Style="{StaticResource SystemRow}">
                                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding MinimizeToTray}" Margin="0"
                                                  AutomationProperties.Name="{x:Static r:Strings.Set_MinimizarBandeja}">
                                            <StackPanel>
                                                <TextBlock Text="{x:Static r:Strings.Set_MinimizarBandeja}" Style="{StaticResource SystemItemTitle}"/>
                                            </StackPanel>
                                        </CheckBox>
                                    </Border>
                                    <Border Style="{StaticResource SystemRow}">
                                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding ShowTrayTemperature}" Margin="0"
                                                  AutomationProperties.Name="{x:Static r:Strings.Set_ExibirTemperaturaCPUIcone}">
                                            <StackPanel>
                                                <TextBlock Text="{x:Static r:Strings.Set_ExibirTemperaturaCPUIcone}" Style="{StaticResource SystemItemTitle}"/>
                                            </StackPanel>
                                        </CheckBox>
                                    </Border>
                                    <Border Style="{StaticResource SystemRow}">
                                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding Animations}" Margin="0"
                                                  AutomationProperties.Name="{x:Static r:Strings.Set_AnimacoesTransicoes}">
                                            <StackPanel>
                                                <TextBlock Text="{x:Static r:Strings.Set_AnimacoesTransicoes}" Style="{StaticResource SystemItemTitle}"/>
                                                <TextBlock Text="{x:Static r:Strings.Set_TransicoesTambemSeguemPreferencia}" Style="{StaticResource SystemDetail}"/>
                                            </StackPanel>
                                        </CheckBox>
                                    </Border>
                                    <Border Style="{StaticResource SystemRow}">
                                        <DockPanel>
                                            <ComboBox DockPanel.Dock="Right" Width="270" VerticalAlignment="Center" Margin="12,0,0,0"
                                                      ItemsSource="{Binding LanguageOptions}" SelectedValuePath="Code" DisplayMemberPath="Label"
                                                      SelectedValue="{Binding LanguageChoice}" AutomationProperties.Name="{x:Static r:Strings.Language_Title}"/>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{x:Static r:Strings.Language_Title}" Style="{StaticResource SystemItemTitle}"/>
                                                <TextBlock Text="{x:Static r:Strings.Language_RestartNotice}" Style="{StaticResource SystemDetail}" TextWrapping="Wrap"/>
                                                <Button Content="{x:Static r:Strings.Language_RestartNow}" Style="{StaticResource SystemLinkButton}"
                                                        HorizontalAlignment="Left" Margin="-6,4,0,0" Click="RestartForLanguage_Click"
                                                        Visibility="{Binding LanguageChangePending, Converter={StaticResource BoolToVis}}"/>
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                    <Border Style="{StaticResource SystemRow}">
                                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding AdvancedSystemTools}" Margin="0"
                                                  AutomationProperties.Name="{x:Static r:Strings.Set_HabilitarFerramentasAvancadasSistema}">
                                            <StackPanel>
                                                <TextBlock Text="{x:Static r:Strings.Set_HabilitarFerramentasAvancadasSistema}" Style="{StaticResource SystemItemTitle}"/>
                                                <TextBlock Text="{x:Static r:Strings.Set_MostraPaginaDriversAbas}"
                                                           Style="{StaticResource SystemDetail}" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </CheckBox>
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="{x:Static r:Strings.Set_Seguranca}" Style="{StaticResource SystemTab}">
                <ScrollViewer Style="{StaticResource SystemScroll}">
                    <StackPanel Margin="0,0,0,24">
                        <Border Style="{StaticResource SystemPanel}" Margin="0,0,0,12">
                            <StackPanel>
                                <DockPanel>
                                    <Border DockPanel.Dock="Left" Style="{StaticResource SystemIconTile}" Margin="0,0,12,0">
                                        <TextBlock Text="&#xE7B8;" Style="{StaticResource SystemIcon}"/>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{x:Static r:Strings.Set_ProtecaoAvisos}" Style="{StaticResource SystemSectionTitle}"/>
                                    </StackPanel>
                                </DockPanel>

                                <StackPanel Margin="0,14,0,-8">
                                    <Border Style="{StaticResource SystemRow}">
                                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding FailSafeEnabled}" Margin="0"
                                                  AutomationProperties.Name="{x:Static r:Strings.Set_ModoSegurancaAutomatico}">
                                            <StackPanel>
                                                <TextBlock Text="{x:Static r:Strings.Set_ModoSegurancaAutomatico}" Style="{StaticResource SystemItemTitle}"/>
                                                <TextBlock Text="{x:Static r:Strings.Set_AcionaVentoinhas100Condicao}" Style="{StaticResource SystemDetail}"/>
                                            </StackPanel>
                                        </CheckBox>
                                    </Border>
                                    <Border Style="{StaticResource SystemRow}">
                                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding FanStopAlert}" Margin="0"
                                                  AutomationProperties.Name="{x:Static r:Strings.Set_AvisarVentoinhaOuBomba}">
                                            <StackPanel>
                                                <TextBlock Text="{x:Static r:Strings.Set_AvisarVentoinhaOuBomba}" Style="{StaticResource SystemItemTitle}"/>
                                            </StackPanel>
                                        </CheckBox>
                                    </Border>
                                    <Border Style="{StaticResource SystemRow}">
                                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding AlertNotifications}" Margin="0"
                                                  AutomationProperties.Name="{x:Static r:Strings.Set_ExibirNotificacoesAlerta}"
                                                  DataContext="{Binding Settings, RelativeSource={RelativeSource AncestorType=Window}}">
                                            <StackPanel>
                                                <TextBlock Text="{x:Static r:Strings.Set_ExibirNotificacoesAlerta}" Style="{StaticResource SystemItemTitle}"/>
                                                <TextBlock Text="{x:Static r:Strings.Set_MostraAvisosLinkFlowArea}" Style="{StaticResource SystemDetail}"/>
                                            </StackPanel>
                                        </CheckBox>
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SystemPanel}" Margin="0">
                            <StackPanel>
                                <DockPanel>
                                    <Border DockPanel.Dock="Left" Style="{StaticResource SystemIconTile}" Margin="0,0,12,0">
                                        <TextBlock Text="&#xE9CA;" Style="{StaticResource SystemIcon}"/>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{x:Static r:Strings.Set_LimitesTemperatura}" Style="{StaticResource SystemSectionTitle}"/>
                                        <TextBlock Text="{x:Static r:Strings.Set_ConfigureLimitesAlertaProtecao}" Style="{StaticResource SystemDetail}"/>
                                    </StackPanel>
                                </DockPanel>
                                <Grid Margin="0,16,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="58"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="58"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="42"/>
                                        <RowDefinition Height="42"/>
                                        <RowDefinition Height="42"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Column="1" Text="{x:Static r:Strings.Set_Alerta}" Style="{StaticResource Label}" Foreground="{StaticResource WarningBrush}"/>
                                    <TextBlock Grid.Column="3" Text="{x:Static r:Strings.Set_Critico}" Style="{StaticResource Label}" Foreground="{StaticResource DangerBrush}" Margin="8,0,0,0"/>

                                    <TextBlock Grid.Row="1" Text="CPU" VerticalAlignment="Center"/>
                                    <Slider Grid.Row="1" Grid.Column="1" Minimum="60" Maximum="100" Value="{Binding CpuWarn}" AutomationProperties.Name="{x:Static r:Strings.Set_TemperaturaAlertaCPU}" IsSnapToTickEnabled="True" TickFrequency="1" Foreground="{StaticResource WarningBrush}"/>
                                    <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding CpuWarn, StringFormat={}{0:0} °C}" TextAlignment="Right" VerticalAlignment="Center"/>
                                    <Slider Grid.Row="1" Grid.Column="3" Minimum="70" Maximum="105" Value="{Binding CpuCritical}" AutomationProperties.Name="{x:Static r:Strings.Set_TemperaturaCriticaCPU}" IsSnapToTickEnabled="True" TickFrequency="1" Foreground="{StaticResource DangerBrush}" Margin="8,0,0,0"/>
                                    <TextBlock Grid.Row="1" Grid.Column="4" Text="{Binding CpuCritical, StringFormat={}{0:0} °C}" TextAlignment="Right" VerticalAlignment="Center"/>

                                    <TextBlock Grid.Row="2" Text="GPU" VerticalAlignment="Center"/>
                                    <Slider Grid.Row="2" Grid.Column="1" Minimum="60" Maximum="95" Value="{Binding GpuWarn}" AutomationProperties.Name="{x:Static r:Strings.Set_TemperaturaAlertaGPU}" IsSnapToTickEnabled="True" TickFrequency="1" Foreground="{StaticResource WarningBrush}"/>
                                    <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding GpuWarn, StringFormat={}{0:0} °C}" TextAlignment="Right" VerticalAlignment="Center"/>
                                    <Slider Grid.Row="2" Grid.Column="3" Minimum="70" Maximum="100" Value="{Binding GpuCritical}" AutomationProperties.Name="{x:Static r:Strings.Set_TemperaturaCriticaGPU}" IsSnapToTickEnabled="True" TickFrequency="1" Foreground="{StaticResource DangerBrush}" Margin="8,0,0,0"/>
                                    <TextBlock Grid.Row="2" Grid.Column="4" Text="{Binding GpuCritical, StringFormat={}{0:0} °C}" TextAlignment="Right" VerticalAlignment="Center"/>

                                    <TextBlock Grid.Row="3" Text="{x:Static r:Strings.Det_Coolant}" VerticalAlignment="Center"/>
                                    <Slider Grid.Row="3" Grid.Column="1" Minimum="35" Maximum="55" Value="{Binding CoolantWarn}" AutomationProperties.Name="{x:Static r:Strings.Set_TemperaturaAlertaLiquido}" IsSnapToTickEnabled="True" TickFrequency="1" Foreground="{StaticResource WarningBrush}"/>
                                    <TextBlock Grid.Row="3" Grid.Column="2" Text="{Binding CoolantWarn, StringFormat={}{0:0} °C}" TextAlignment="Right" VerticalAlignment="Center"/>
                                    <Slider Grid.Row="3" Grid.Column="3" Minimum="40" Maximum="60" Value="{Binding CoolantCritical}" AutomationProperties.Name="{x:Static r:Strings.Set_TemperaturaCriticaLiquido}" IsSnapToTickEnabled="True" TickFrequency="1" Foreground="{StaticResource DangerBrush}" Margin="8,0,0,0"/>
                                    <TextBlock Grid.Row="3" Grid.Column="4" Text="{Binding CoolantCritical, StringFormat={}{0:0} °C}" TextAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="{x:Static r:Strings.Set_Atalhos}" Style="{StaticResource SystemTab}">
                <ScrollViewer Style="{StaticResource SystemScroll}">
                    <StackPanel Margin="0,0,0,24">
                        <Border Style="{StaticResource SystemPanel}" Margin="0">
                            <StackPanel>
                                <DockPanel>
                                    <Border DockPanel.Dock="Left" Style="{StaticResource SystemIconTile}" Margin="0,0,12,0">
                                        <TextBlock Text="&#xE765;" Style="{StaticResource SystemIcon}"/>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{x:Static r:Strings.Set_AtalhosTeclado}" Style="{StaticResource SystemSectionTitle}"/>
                                    </StackPanel>
                                </DockPanel>

                                <StackPanel Margin="0,14,0,-8">
                                    <Border Style="{StaticResource SystemRow}">
                                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding GlobalHotkeys}" Margin="0"
                                                  AutomationProperties.Name="{x:Static r:Strings.Set_AtalhosGlobais}"
                                                  DataContext="{Binding Settings, RelativeSource={RelativeSource AncestorType=Window}}">
                                            <StackPanel>
                                                <TextBlock Text="{x:Static r:Strings.Set_AtalhosGlobais}" Style="{StaticResource SystemItemTitle}"/>
                                                <TextBlock Text="{x:Static r:Strings.Set_CtrlAlt15}" Style="{StaticResource SystemDetail}"/>
                                            </StackPanel>
                                        </CheckBox>
                                    </Border>
                                </StackPanel>

                                <Grid Margin="0,4,0,0">
                                    <Grid.Resources>
                                        <Style x:Key="Kbd" TargetType="Border">
                                            <Setter Property="Background" Value="{StaticResource BgBrush}"/>
                                            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
                                            <Setter Property="BorderThickness" Value="1"/>
                                            <Setter Property="CornerRadius" Value="5"/>
                                            <Setter Property="Padding" Value="7,2"/>
                                            <Setter Property="Margin" Value="0,3,12,3"/>
                                            <Setter Property="HorizontalAlignment" Value="Left"/>
                                        </Style>
                                    </Grid.Resources>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                                    </Grid.RowDefinitions>
                                    <Border Style="{StaticResource Kbd}"><TextBlock Text="F1 … F5" FontFamily="Consolas"/></Border>
                                    <TextBlock Grid.Column="1" Text="{x:Static r:Strings.Set_AplicarPerfilSilenciosoCurva}" VerticalAlignment="Center" Style="{StaticResource SystemDetail}" Margin="0"/>
                                    <Border Grid.Row="1" Style="{StaticResource Kbd}"><TextBlock Text="{x:Static r:Strings.Set_Ctrl19}" FontFamily="Consolas"/></Border>
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Static r:Strings.Set_TrocarPagina}" VerticalAlignment="Center" Style="{StaticResource SystemDetail}" Margin="0"/>
                                    <Border Grid.Row="2" Style="{StaticResource Kbd}"><TextBlock Text="{x:Static r:Strings.Set_CtrlCtrl}" FontFamily="Consolas"/></Border>
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{x:Static r:Strings.Set_PotenciaGlobal5}" VerticalAlignment="Center" Style="{StaticResource SystemDetail}" Margin="0"/>
                                    <Border Grid.Row="3" Style="{StaticResource Kbd}"><TextBlock Text="{x:Static r:Strings.Set_Ctrl}" FontFamily="Consolas"/></Border>
                                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{x:Static r:Strings.Set_DesfazerUltimaAlteracao}" VerticalAlignment="Center" Style="{StaticResource SystemDetail}" Margin="0"/>
                                    <Border Grid.Row="4" Style="{StaticResource Kbd}"><TextBlock Text="{x:Static r:Strings.Set_CtrlEsc}" FontFamily="Consolas"/></Border>
                                    <TextBlock Grid.Row="4" Grid.Column="1" Text="{x:Static r:Strings.Set_SelecionarTodasLimparSelecao}" VerticalAlignment="Center" Style="{StaticResource SystemDetail}" Margin="0"/>
                                    <Border Grid.Row="5" Style="{StaticResource Kbd}"><TextBlock Text="{x:Static r:Strings.Set_Ctrl2}" FontFamily="Consolas"/></Border>
                                    <TextBlock Grid.Row="5" Grid.Column="1" Text="{x:Static r:Strings.Main_MiniWidget}" VerticalAlignment="Center" Style="{StaticResource SystemDetail}" Margin="0"/>
                                    <Border Grid.Row="6" Style="{StaticResource Kbd}"><TextBlock Text="{x:Static r:Strings.Lcd_Ctrl}" FontFamily="Consolas"/></Border>
                                    <TextBlock Grid.Row="6" Grid.Column="1" Text="{x:Static r:Strings.Set_EnviarQuadroLCD}" VerticalAlignment="Center" Style="{StaticResource SystemDetail}" Margin="0"/>
                                    <Border Grid.Row="7" Style="{StaticResource Kbd}"><TextBlock Text="{x:Static r:Strings.Set_EscCtrl}" FontFamily="Consolas"/></Border>
                                    <TextBlock Grid.Row="7" Grid.Column="1" Text="{x:Static r:Strings.Set_FecharJanelaCtrlEncerra}" VerticalAlignment="Center" Style="{StaticResource SystemDetail}" Margin="0"/>
                                    <Border Grid.Row="8" Style="{StaticResource Kbd}"><TextBlock Text="{x:Static r:Strings.Set_Ctrl3}" FontFamily="Consolas"/></Border>
                                    <TextBlock Grid.Row="8" Grid.Column="1" Text="{x:Static r:Strings.Set_RenomearCartaoSelecionadoVentoinhas}" VerticalAlignment="Center" Style="{StaticResource SystemDetail}" Margin="0"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="{x:Static r:Strings.Set_ServicoBackup}" Style="{StaticResource SystemTab}">
                <ScrollViewer Style="{StaticResource SystemScroll}">
                    <StackPanel Margin="0,0,0,24">
                        <c:AdaptiveUniformGrid MinItemWidth="350" MaxColumns="2" StackColumns="True" Margin="0,0,-12,0">
                            <Border Style="{StaticResource SystemPanel}" Margin="0,0,12,12">
                                <StackPanel>
                                    <DockPanel>
                                        <Border DockPanel.Dock="Left" Style="{StaticResource SystemIconTile}" Margin="0,0,12,0">
                                            <TextBlock Text="&#xE950;" Style="{StaticResource SystemIcon}"/>
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{x:Static r:Strings.Main_EngineService}" Style="{StaticResource SystemSectionTitle}"/>
                                            <TextBlock Text="{x:Static r:Strings.Set_MantemControleVentoinhasRGB}" Style="{StaticResource SystemDetail}"/>
                                        </StackPanel>
                                    </DockPanel>
                                    <Border Background="{StaticResource BgBrush}" CornerRadius="10" Padding="14,10" Margin="0,14,0,12">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Settings.ServiceStatusText, RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource SystemItemTitle}"/>
                                            <TextBlock Text="{Binding Settings.ServiceDetailText, RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource SystemDetail}"/>
                                        </StackPanel>
                                    </Border>
                                    <WrapPanel Margin="0,0,-8,-8">
                                        <Button Style="{StaticResource PrimaryButton}" Content="{x:Static r:Strings.Dash_InstallService}" Margin="0,0,8,8" Click="InstallService_Click"
                                                Visibility="{Binding Settings.ServiceCanInstall, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}"/>
                                        <Button Style="{StaticResource SecondaryButton}" Content="{x:Static r:Strings.Dash_RestartAsAdmin}" Margin="0,0,8,8" Click="RestartAsAdmin_Click"
                                                Visibility="{Binding Settings.CanRestartAsAdmin, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}"/>
                                        <Button Style="{StaticResource SecondaryButton}" Content="{x:Static r:Strings.Set_ReiniciarServico}" Margin="0,0,8,8" Click="RestartService_Click"
                                                Visibility="{Binding Settings.ServiceInstalled, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}"/>
                                        <Button Style="{StaticResource DangerButton}" Content="{x:Static r:Strings.Set_RemoverServico}" Margin="0,0,8,8" Click="UninstallService_Click"
                                                Visibility="{Binding Settings.ServiceInstalled, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource SystemPanel}" Margin="0,0,12,12" AllowDrop="True" Drop="Backup_Drop" DragOver="Backup_DragOver">
                                <StackPanel>
                                    <DockPanel>
                                        <Border DockPanel.Dock="Left" Style="{StaticResource SystemIconTile}" Margin="0,0,12,0">
                                            <TextBlock Text="&#xE8F7;" Style="{StaticResource SystemIcon}"/>
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{x:Static r:Strings.Set_BackupConfiguracoes}" Style="{StaticResource SystemSectionTitle}"/>
                                            <TextBlock Text="{x:Static r:Strings.Set_ReunePerfisCurvasIluminacao}" Style="{StaticResource SystemDetail}"/>
                                        </StackPanel>
                                    </DockPanel>
                                    <WrapPanel Margin="0,14,0,0">
                                        <Button Style="{StaticResource SecondaryButton}" Margin="0,0,8,8" Click="ExportBackup_Click">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Style="{StaticResource Icon}" Text="&#xEDE1;" FontSize="13" Margin="0,0,8,0"/>
                                                <TextBlock Text="{x:Static r:Strings.Set_Exportar}"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Style="{StaticResource PrimaryButton}" Margin="0,0,0,8" Click="ImportBackup_Click">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Style="{StaticResource Icon}" Text="&#xE8B5;" FontSize="13" Margin="0,0,8,0"/>
                                                <TextBlock Text="{x:Static r:Strings.Set_Importar}"/>
                                            </StackPanel>
                                        </Button>
                                    </WrapPanel>
                                    <TextBlock Text="{x:Static r:Strings.Set_VoceTambemPodeArrastar}" Style="{StaticResource SystemDetail}"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource SystemPanel}" Margin="0,0,12,12">
                                <StackPanel>
                                    <DockPanel>
                                        <Border DockPanel.Dock="Left" Style="{StaticResource SystemIconTile}" Margin="0,0,12,0">
                                            <TextBlock Text="&#xE8B7;" Style="{StaticResource SystemIcon}"/>
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{x:Static r:Strings.Set_ArquivosAplicativo}" Style="{StaticResource SystemSectionTitle}"/>
                                            <TextBlock Text="{Binding Settings.ExitHintText, RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource SystemDetail}"/>
                                        </StackPanel>
                                    </DockPanel>
                                    <WrapPanel Margin="0,14,-8,-8">
                                        <Button Style="{StaticResource SecondaryButton}" Content="{x:Static r:Strings.Set_AbrirPastaLogs}" Margin="0,0,8,8" Click="OpenLogs_Click"/>
                                        <Button Style="{StaticResource SecondaryButton}" Content="{x:Static r:Strings.Set_AbrirPastaConfiguracao}" Margin="0,0,8,8" Click="OpenConfig_Click"/>
                                        <Button Style="{StaticResource SecondaryButton}" Margin="0,0,8,8" Click="Diagnostic_Click"
                                                ToolTip="{x:Static r:Strings.Set_LogsRecentesConfigJson}"
                                                AutomationProperties.Name="{x:Static r:Strings.Set_GerarPacoteDiagnostico}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Style="{StaticResource Icon}" Text="&#xE9D9;" FontSize="13" Margin="0,0,8,0"/>
                                                <TextBlock Text="{x:Static r:Strings.Set_GerarPacoteDiagnosticoZip}"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Style="{StaticResource DangerButton}" Content="{Binding Settings.ExitButtonText, RelativeSource={RelativeSource AncestorType=Window}}" Margin="0,0,8,8" Click="ExitApp_Click"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                        </c:AdaptiveUniformGrid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem x:Name="UpdatesTab" Header="{x:Static r:Strings.Set_Atualizacoes}" Style="{StaticResource SystemTab}">
                <ScrollViewer Style="{StaticResource SystemScroll}">
                    <Border Style="{StaticResource SystemPanel}" Margin="0,0,0,24" VerticalAlignment="Top"
                            DataContext="{Binding Updates, RelativeSource={RelativeSource AncestorType=Window}}">
                        <StackPanel>
                            <DockPanel>
                                <Border DockPanel.Dock="Left" Style="{StaticResource SystemIconTile}" Margin="0,0,12,0">
                                    <TextBlock Text="&#xE72C;" Style="{StaticResource SystemIcon}"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{x:Static r:Strings.Tray_Updates}" Style="{StaticResource SystemSectionTitle}"/>
                                    <TextBlock Text="{Binding VersionText}" Style="{StaticResource SystemDetail}"/>
                                </StackPanel>
                            </DockPanel>
                            <Border Style="{StaticResource SystemRow}" Margin="0,16,0,0">
                                <CheckBox Style="{StaticResource ToggleSwitch}" Margin="0" IsChecked="{Binding AutomaticCheck}"
                                          AutomationProperties.Name="{x:Static r:Strings.Set_BuscarAtualizacoesAutomaticamente}">
                                    <StackPanel>
                                        <TextBlock Text="{x:Static r:Strings.Set_BuscarAtualizacoesAutomaticamente}" Style="{StaticResource SystemItemTitle}"/>
                                        <TextBlock Text="{x:Static r:Strings.Set_LinkFlowAvisaQuandoNova}" Style="{StaticResource SystemDetail}"/>
                                    </StackPanel>
                                </CheckBox>
                            </Border>
                            <TextBlock Text="{Binding Status}" Style="{StaticResource SystemDetail}" Margin="0,12,0,0"
                                       AutomationProperties.LiveSetting="Polite"/>
                            <ProgressBar Height="5" Maximum="100" Value="{Binding Progress, Mode=OneWay}" Margin="0,8,0,0"
                                         Foreground="{StaticResource AccentBrush}" Background="{StaticResource BgBrush}"
                                         Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVis}}"
                                         AutomationProperties.Name="{x:Static r:Strings.Set_ProgressoDownloadAtualizacao}"/>
                            <WrapPanel Margin="0,14,-8,-8">
                                <Button Style="{StaticResource PrimaryButton}" Content="{Binding ActionText}" Click="UpdateAction_Click"
                                        Visibility="{Binding HasUpdate, Converter={StaticResource BoolToVis}}" IsEnabled="{Binding CanCheck}"
                                        Margin="0,0,8,8"/>
                                <Button Style="{StaticResource SecondaryButton}" Content="{x:Static r:Strings.Set_VerificarAtualizacao}" Click="CheckUpdate_Click"
                                        IsEnabled="{Binding CanCheck}" Margin="0,0,8,8"/>
                                <Button Style="{StaticResource SecondaryButton}" Content="{x:Static r:Strings.Set_CancelarDownload}" Click="CancelUpdateDownload_Click"
                                        Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVis}}" Margin="0,0,8,8"/>
                                <Button Style="{StaticResource SecondaryButton}" Content="{x:Static r:Strings.Set_AbrirPaginaDownloads}" Click="OpenUpdateDownloads_Click"
                                        Visibility="{Binding ShowDownloadsLink, Converter={StaticResource BoolToVis}}" Margin="0,0,8,8"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
