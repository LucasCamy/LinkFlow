<UserControl x:Class="LinkFlow.App.Views.LcdPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:LinkFlow.App.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="8,8,20,24">
            <TextBlock Text="Tela LCD" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="Painel de métricas exibido no display 480x480 da bomba." Style="{StaticResource PageSubtitle}"/>

            <c:AdaptiveUniformGrid MinItemWidth="380" MaxColumns="2" Margin="0,16,-12,0">
                <!-- Prévia -->
                <Border Style="{StaticResource GridCard}">
                    <StackPanel HorizontalAlignment="Center">
                        <Border Width="260" Height="260" CornerRadius="130" Background="#0B0F19" BorderThickness="4"
                                BorderBrush="{Binding CurrentRgbHex, Converter={StaticResource HexToBrush}}">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="LINKFLOW" Foreground="{StaticResource TextMutedBrush}" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding CpuTempFormatted}" Foreground="{StaticResource TextBrush}" FontSize="40" FontWeight="Bold" HorizontalAlignment="Center"/>
                                <TextBlock Text="CPU" Foreground="{Binding CurrentRgbHex, Converter={StaticResource HexToBrush}}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center"/>
                                <Border Height="1" Background="{StaticResource BorderBrush}" Width="130" Margin="0,10"/>
                                <Grid Width="190">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="GPU" Foreground="{StaticResource TextSubtleBrush}" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center"/>
                                        <TextBlock Text="{Binding GpuTempFormatted}" Foreground="{StaticResource GpuBrush}" FontSize="13" FontWeight="SemiBold"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                        <TextBlock Text="LÍQUIDO" Foreground="{StaticResource TextSubtleBrush}" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center"/>
                                        <TextBlock Text="{Binding CoolantTempFormatted}" Foreground="{StaticResource TextBrush}" FontSize="13" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,14,0,0">
                            <Ellipse Width="8" Height="8" VerticalAlignment="Center">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{StaticResource WarningBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsLcdConnected}" Value="True">
                                                <Setter Property="Fill" Value="{StaticResource SuccessBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="{Binding LcdStatus}" Margin="8,0,0,0" Foreground="{StaticResource TextMutedBrush}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Controles -->
                <Border Style="{StaticResource GridCard}">
                    <StackPanel>
                        <TextBlock Text="Transmissão" Style="{StaticResource SectionTitle}" Margin="0,0,0,10"/>
                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding IsLcdAutoStream}">
                            <StackPanel>
                                <TextBlock Text="Atualizar métricas continuamente"/>
                                <TextBlock Text="1 quadro por segundo, renderizado em segundo plano" Style="{StaticResource Caption}"/>
                            </StackPanel>
                        </CheckBox>
                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding SyncLcd}">
                            <StackPanel>
                                <TextBlock Text="Usar a cor da iluminação no anel do display"/>
                                <TextBlock Text="Sem esta opção o anel fica em ciano" Style="{StaticResource Caption}"/>
                            </StackPanel>
                        </CheckBox>

                        <Button Style="{StaticResource PrimaryButton}" Command="{Binding TransmitLcdCommand}" HorizontalAlignment="Left" Margin="0,16,0,0"
                                ToolTip="Ctrl+L">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE724;" FontSize="13" Margin="0,0,8,0"/>
                                <TextBlock Text="Enviar quadro agora"/>
                            </StackPanel>
                        </Button>

                        <Border Background="{StaticResource BgBrush}" CornerRadius="10" Padding="14,10" Margin="0,18,0,0">
                            <StackPanel>
                                <TextBlock Text="Detalhes" Style="{StaticResource Label}" Margin="0,0,0,6"/>
                                <TextBlock Text="• Resolução 480x480, JPEG em blocos de 1016 bytes (Report ID 0x02)" Style="{StaticResource Caption}"/>
                                <TextBlock Text="• O display reconecta sozinho se o USB for desconectado" Style="{StaticResource Caption}"/>
                                <TextBlock Text="• Em modo de segurança o painel fica vermelho com o aviso" Style="{StaticResource Caption}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </c:AdaptiveUniformGrid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
