<UserControl x:Class="LinkFlow.App.Views.DashboardPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:LinkFlow.App.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="8,8,20,24">
            <TextBlock Text="Painel" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="Temperaturas, ventoinhas e alertas em tempo real." Style="{StaticResource PageSubtitle}" Margin="0,2,0,16"/>

            <!-- Modo de segurança -->
            <Border Style="{StaticResource Banner}" Background="{StaticResource DangerSoftBrush}" BorderBrush="{StaticResource DangerBrush}"
                    Visibility="{Binding IsFailSafeActive, Converter={StaticResource BoolToVis}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE7BA;" Foreground="{StaticResource DangerBrush}" Margin="0,0,10,0"/>
                    <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextBrush}">
                        <Run FontWeight="SemiBold" Text="Modo de segurança ativo."/>
                        <Run Text="Todas as ventoinhas estão em 100% até as temperaturas voltarem ao normal."/>
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- Serviço sem resposta -->
            <Border Style="{StaticResource Banner}" Background="{StaticResource WarningSoftBrush}" BorderBrush="{StaticResource WarningBrush}"
                    Visibility="{Binding IsEngineDisconnected, Converter={StaticResource BoolToVis}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE7BA;" Foreground="{StaticResource WarningBrush}" Margin="0,0,10,0"/>
                    <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextBrush}">
                        <Run FontWeight="SemiBold" Text="O serviço LinkFlow não está respondendo."/>
                        <Run Text="Os valores podem estar desatualizados. Reconectando automaticamente..."/>
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- Modo limitado / sensor da CPU indisponível -->
            <Border Style="{StaticResource Banner}" Background="{StaticResource WarningSoftBrush}" BorderBrush="{StaticResource WarningBrush}"
                    Visibility="{Binding CpuSensorHint, Converter={StaticResource NullToVis}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE946;" Foreground="{StaticResource WarningBrush}" Margin="0,0,10,0" VerticalAlignment="Top"/>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding CpuSensorHint}" TextWrapping="Wrap" Foreground="{StaticResource TextBrush}"/>
                        <WrapPanel Margin="0,8,0,0" DataContext="{Binding Settings, RelativeSource={RelativeSource AncestorType=Window}}"
                                   Visibility="{Binding IsLimitedLocal, Converter={StaticResource BoolToVis}}">
                            <Button Style="{StaticResource PrimaryButton}" Content="Instalar serviço (recomendado)" Margin="0,0,8,0" Click="InstallService_Click"
                                    Visibility="{Binding ServiceCanInstall, Converter={StaticResource BoolToVis}}"/>
                            <Button Style="{StaticResource SecondaryButton}" Content="Reiniciar como administrador" Click="RestartAsAdmin_Click"/>
                        </WrapPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Métricas -->
            <c:AdaptiveUniformGrid MinItemWidth="230" MaxColumns="4" Margin="0,0,-12,0">
                <Border Style="{StaticResource GridCard}">
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="CPU" Style="{StaticResource Label}"/>
                            <TextBlock Text="{Binding CpuTempFormatted}" Style="{StaticResource Metric}" Foreground="{StaticResource CpuBrush}" Margin="0,4,0,0"/>
                            <TextBlock Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap">
                                <Run Text="{Binding CpuLoadFormatted, Mode=OneWay}"/><Run Text=" de uso • "/><Run Text="{Binding CpuName, Mode=OneWay}"/>
                            </TextBlock>
                            <c:Sparkline Values="{Binding CpuHistory}" Stroke="{StaticResource CpuBrush}" Height="38" Margin="0,10,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>
                <Border Style="{StaticResource GridCard}">
                    <StackPanel>
                        <TextBlock Text="GPU" Style="{StaticResource Label}"/>
                        <TextBlock Text="{Binding GpuTempFormatted}" Style="{StaticResource Metric}" Foreground="{StaticResource GpuBrush}" Margin="0,4,0,0"/>
                        <TextBlock Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap">
                            <Run Text="{Binding GpuLoadFormatted, Mode=OneWay}"/><Run Text=" de uso • hotspot "/><Run Text="{Binding GpuHotspotFormatted, Mode=OneWay}"/>
                        </TextBlock>
                        <c:Sparkline Values="{Binding GpuHistory}" Stroke="{StaticResource GpuBrush}" Height="38" Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource GridCard}">
                    <StackPanel>
                        <TextBlock Text="LÍQUIDO (AIO)" Style="{StaticResource Label}"/>
                        <TextBlock Text="{Binding CoolantTempFormatted}" Style="{StaticResource Metric}" Foreground="{StaticResource CoolantBrush}" Margin="0,4,0,0"/>
                        <TextBlock Style="{StaticResource Caption}">
                            <Run Text="Bomba "/><Run Text="{Binding PumpRpmFormatted, Mode=OneWay}"/>
                        </TextBlock>
                        <c:Sparkline Values="{Binding CoolantHistory}" Stroke="{StaticResource CoolantBrush}" MinRange="3" Height="38" Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource GridCard}">
                    <StackPanel>
                        <TextBlock Text="VENTOINHAS" Style="{StaticResource Label}"/>
                        <TextBlock Text="{Binding AverageFanRpmFormatted}" Style="{StaticResource Metric}" Foreground="{StaticResource AccentBrush}" Margin="0,4,0,0"/>
                        <TextBlock Style="{StaticResource Caption}">
                            <Run Text="Potência "/><Run Text="{Binding GlobalSpeedFormatted, Mode=OneWay}"/><Run Text=" • "/><Run Text="{Binding ActivePresetLabel, Mode=OneWay}"/>
                        </TextBlock>
                        <c:Sparkline Values="{Binding FanHistory}" Stroke="{StaticResource AccentBrush}" MinRange="200" Height="38" Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>
            </c:AdaptiveUniformGrid>

            <c:AdaptiveUniformGrid MinItemWidth="380" MaxColumns="2" Margin="0,0,-12,0">
                <!-- Perfis rápidos -->
                <Border Style="{StaticResource GridCard}">
                    <StackPanel>
                        <TextBlock Text="Perfil de ventoinhas" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="Um clique aplica em todas as ventoinhas. Atalhos F1–F5 (ou Ctrl+Alt+1–5 de qualquer lugar)." Style="{StaticResource Caption}" Margin="0,2,0,12"/>
                        <ItemsControl ItemsSource="{Binding PresetItems}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <ToggleButton Style="{StaticResource Chip}" IsChecked="{Binding IsActive, Mode=OneWay}" ToolTip="{Binding Tooltip}"
                                                  Command="{Binding DataContext.ApplyPresetCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                  CommandParameter="{Binding Key}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource Icon}" Text="{Binding Icon}" FontSize="13" Margin="0,0,8,0"/>
                                            <TextBlock Text="{Binding Label}"/>
                                        </StackPanel>
                                    </ToggleButton>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <ItemsControl ItemsSource="{Binding Profiles}" Visibility="{Binding HasProfiles, Converter={StaticResource BoolToVis}}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <ToggleButton Style="{StaticResource Chip}" IsChecked="{Binding IsActive, Mode=OneWay}" Content="{Binding Name}"
                                                  Command="{Binding DataContext.ApplyProfileCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                  CommandParameter="{Binding Name}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Potência" Style="{StaticResource Label}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <Slider Grid.Column="1" Minimum="25" Maximum="100" Value="{Binding GlobalSpeedPercent}"
                                    ToolTip="Ctrl+↑ / Ctrl+↓ ajusta 5%"/>
                            <TextBlock Grid.Column="2" Text="{Binding GlobalSpeedFormatted}" FontWeight="SemiBold" Width="48" TextAlignment="Right"
                                       Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Alertas -->
                <Border Style="{StaticResource GridCard}">
                    <StackPanel>
                        <TextBlock Text="Alertas" Style="{StaticResource SectionTitle}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0" Visibility="{Binding HasAlerts, Converter={StaticResource BoolToVisInverse}}">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE73E;" Foreground="{StaticResource SuccessBrush}"/>
                            <TextBlock Text="Tudo normal. Ventoinhas, bomba e temperaturas dentro dos limites." Margin="10,0,0,0"
                                       Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap"/>
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding Alerts}" Margin="0,10,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{Binding Severity, Converter={StaticResource SeverityToSoftBrush}}" CornerRadius="8" Padding="12,8" Margin="0,0,0,6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Style="{StaticResource Icon}" Text="&#xE7BA;" VerticalAlignment="Top" Margin="0,2,10,0"
                                                       Foreground="{Binding Severity, Converter={StaticResource SeverityToBrush}}"/>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding Message}" Style="{StaticResource Caption}" Foreground="{StaticResource TextMutedBrush}"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="MEMÓRIA" Style="{StaticResource Label}"/>
                                <TextBlock Text="{Binding RamUsageFormatted}" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource RamBrush}"/>
                                <TextBlock Text="{Binding RamDetail}" Style="{StaticResource Caption}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="FANS DA GPU" Style="{StaticResource Label}"/>
                                <TextBlock Text="{Binding GpuFanModeText}" FontSize="13" FontWeight="SemiBold" Margin="0,3,0,0"/>
                                <TextBlock Text="{Binding GpuFanRpmFormatted}" Style="{StaticResource Caption}"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </c:AdaptiveUniformGrid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
