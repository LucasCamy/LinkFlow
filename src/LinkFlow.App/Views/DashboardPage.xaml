<UserControl x:Class="LinkFlow.App.Views.DashboardPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:LinkFlow.App.Controls"
             xmlns:vm="clr-namespace:LinkFlow.App.ViewModels"
             Language="pt-BR">
    <UserControl.Resources>
        <Style x:Key="TelemetryMeter" TargetType="ProgressBar">
            <Setter Property="Height" Value="5"/>
            <Setter Property="Maximum" Value="100"/>
            <Setter Property="Background" Value="{StaticResource BgBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border x:Name="PART_Track" Background="{TemplateBinding Background}" CornerRadius="3"/>
                            <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" CornerRadius="3" HorizontalAlignment="Left"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DismissNoticeButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="Content" Value="&#xE8BB;"/>
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="ToolTip" Value="Dispensar aviso"/>
            <Setter Property="AutomationProperties.Name" Value="Dispensar aviso"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="24,20,24,0" MaxWidth="1160">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,18">
            <Border DockPanel.Dock="Right" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="11,6" Margin="12,0,0,0" VerticalAlignment="Center"
                    Visibility="{Binding Snapshot.SensorsReady, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding Snapshot.Timestamp, StringFormat='Leitura às {0:HH:mm:ss}'}"
                           Style="{StaticResource SystemDetail}" Margin="0"/>
            </Border>
            <StackPanel>
                <TextBlock Text="Painel" Style="{StaticResource SystemPageTitle}"/>
                <TextBlock Text="Temperaturas, utilização e refrigeração deste PC." Style="{StaticResource SystemDetail}"/>
            </StackPanel>
        </DockPanel>

        <ContentControl x:Name="DashboardNotice" Grid.Row="1" Content="{Binding AlertCenter.Banner}"
                        Visibility="{Binding AlertCenter.Banner, Converter={StaticResource NullToVis}}"
                        HorizontalContentAlignment="Stretch">
            <ContentControl.ContentTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource Banner}" Padding="14,4"
                            Background="{Binding Severity, Converter={StaticResource SeverityToSoftBrush}}"
                            BorderBrush="{Binding Severity, Converter={StaticResource SeverityToBrush}}">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource DismissNoticeButton}"
                                    Command="{Binding DataContext.AlertCenter.DismissCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"/>
                            <TextBlock DockPanel.Dock="Left" Style="{StaticResource Icon}" Text="&#xE7BA;" Margin="0,0,10,0"
                                       VerticalAlignment="Center" Foreground="{Binding Severity, Converter={StaticResource SeverityToBrush}}"/>
                            <StackPanel VerticalAlignment="Center" Margin="0,4">
                                <TextBlock TextWrapping="Wrap">
                                    <Run FontWeight="SemiBold" Text="{Binding Title, Mode=OneWay}"/><Run Text=". "/><Run Text="{Binding Message, Mode=OneWay}"/>
                                </TextBlock>
                                <ContentControl Content="{Binding Settings, RelativeSource={RelativeSource AncestorType=Window}}"
                                                Visibility="{Binding Key, Converter={StaticResource EqualsToVis}, ConverterParameter={x:Static vm:AlertsViewModel.CpuSensorKey}}">
                                    <ContentControl.ContentTemplate>
                                        <DataTemplate>
                                            <WrapPanel Margin="0,8,0,0" Visibility="{Binding IsLimitedLocal, Converter={StaticResource BoolToVis}}">
                                                <Button Style="{StaticResource PrimaryButton}" Content="Instalar serviço" Margin="0,0,8,4" Click="InstallService_Click"
                                                        Visibility="{Binding ServiceCanInstall, Converter={StaticResource BoolToVis}}"/>
                                                <Button Style="{StaticResource SecondaryButton}" Content="Reiniciar como administrador" Margin="0,0,0,4" Click="RestartAsAdmin_Click"/>
                                            </WrapPanel>
                                        </DataTemplate>
                                    </ContentControl.ContentTemplate>
                                </ContentControl>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </DataTemplate>
            </ContentControl.ContentTemplate>
        </ContentControl>

        <TabControl x:Name="DashboardTabs" Grid.Row="2" Style="{StaticResource SystemTabs}" SelectedIndex="0">
            <TabItem Header="Visão geral" Style="{StaticResource SystemTab}">
                <ScrollViewer Style="{StaticResource SystemScroll}">
                    <StackPanel Margin="0,0,0,24">
                        <c:AdaptiveUniformGrid MinItemWidth="275" MaxColumns="2" Margin="0,0,-12,0">
                            <Button Style="{StaticResource CardButton}" Command="{Binding OpenDetailCommand}" CommandParameter="cpu"
                                    AutomationProperties.Name="Abrir detalhes do processador">
                                <StackPanel Margin="0,0,14,0">
                                    <DockPanel>
                                        <Border DockPanel.Dock="Left" Style="{StaticResource SystemIconTile}" Margin="0,0,12,0">
                                            <TextBlock Text="&#xE950;" Style="{StaticResource SystemIcon}" Foreground="{StaticResource CpuBrush}"/>
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Processador" Style="{StaticResource SystemItemTitle}"/>
                                            <TextBlock Text="{Binding CpuName}" Style="{StaticResource SystemDetail}" TextWrapping="NoWrap"
                                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding CpuName}"/>
                                        </StackPanel>
                                    </DockPanel>
                                    <DockPanel Margin="0,12,0,12">
                                        <StackPanel DockPanel.Dock="Left" MinWidth="98" Margin="0,0,12,0">
                                            <TextBlock Text="{Binding CpuTempFormatted}" Style="{StaticResource Metric}" Foreground="{StaticResource CpuBrush}"/>
                                            <TextBlock Text="Temperatura" Style="{StaticResource Label}"/>
                                        </StackPanel>
                                        <c:Sparkline Values="{Binding CpuHistory}" Stroke="{StaticResource CpuBrush}" Height="45" MinRange="6" ClipToBounds="True"
                                                     AutomationProperties.Name="Histórico de temperatura do processador"/>
                                    </DockPanel>
                                    <DockPanel Margin="0,0,0,6">
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding CpuLoadFormatted}" Style="{StaticResource SystemItemTitle}"/>
                                        <TextBlock Text="Uso da CPU" Style="{StaticResource SystemDetail}" Margin="0" VerticalAlignment="Center"/>
                                    </DockPanel>
                                    <ProgressBar Style="{StaticResource TelemetryMeter}" Foreground="{StaticResource CpuBrush}"
                                                 Value="{Binding Snapshot.CpuLoad, Mode=OneWay, TargetNullValue=0, FallbackValue=0}"
                                                 AutomationProperties.Name="Uso da CPU"/>
                                    <TextBlock Text="{Binding CpuPowerDetail}" Style="{StaticResource SystemDetail}" Margin="0,8,0,0"
                                               Visibility="{Binding CpuPowerDetail, Converter={StaticResource NullToVis}}"/>
                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource CardButton}" Command="{Binding OpenDetailCommand}" CommandParameter="gpu"
                                    AutomationProperties.Name="Abrir detalhes da placa de vídeo">
                                <StackPanel Margin="0,0,14,0">
                                    <DockPanel>
                                        <Border DockPanel.Dock="Left" Style="{StaticResource SystemIconTile}" Margin="0,0,12,0">
                                            <TextBlock Text="&#xE7F4;" Style="{StaticResource SystemIcon}" Foreground="{StaticResource GpuBrush}"/>
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Placa de vídeo" Style="{StaticResource SystemItemTitle}"/>
                                            <TextBlock Text="{Binding GpuName}" Style="{StaticResource SystemDetail}" TextWrapping="NoWrap"
                                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding GpuName}"/>
                                        </StackPanel>
                                    </DockPanel>
                                    <DockPanel Margin="0,12,0,12">
                                        <StackPanel DockPanel.Dock="Left" MinWidth="98" Margin="0,0,12,0">
                                            <TextBlock Text="{Binding GpuTempFormatted}" Style="{StaticResource Metric}" Foreground="{StaticResource GpuBrush}"/>
                                            <TextBlock Text="Temperatura" Style="{StaticResource Label}"/>
                                        </StackPanel>
                                        <c:Sparkline Values="{Binding GpuHistory}" Stroke="{StaticResource GpuBrush}" Height="45" MinRange="6" ClipToBounds="True"
                                                     AutomationProperties.Name="Histórico de temperatura da placa de vídeo"/>
                                    </DockPanel>
                                    <DockPanel Margin="0,0,0,6">
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding GpuLoadFormatted}" Style="{StaticResource SystemItemTitle}"/>
                                        <TextBlock Text="Uso da GPU" Style="{StaticResource SystemDetail}" Margin="0" VerticalAlignment="Center"/>
                                    </DockPanel>
                                    <ProgressBar Style="{StaticResource TelemetryMeter}" Foreground="{StaticResource GpuBrush}"
                                                 Value="{Binding Snapshot.GpuLoad, Mode=OneWay, TargetNullValue=0, FallbackValue=0}"
                                                 AutomationProperties.Name="Uso da GPU"/>
                                    <WrapPanel Margin="0,8,0,0">
                                        <TextBlock Text="{Binding GpuHotspotFormatted, StringFormat='Hotspot {0}'}" Style="{StaticResource SystemDetail}"
                                                   Margin="0,0,14,0" Visibility="{Binding Snapshot.GpuHotspot, Converter={StaticResource NullToVis}}"/>
                                        <TextBlock Text="{Binding GpuVramDetail}" Style="{StaticResource SystemDetail}" Margin="0"
                                                   Visibility="{Binding GpuVramDetail, Converter={StaticResource NullToVis}}"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Button>
                        </c:AdaptiveUniformGrid>

                        <c:AdaptiveUniformGrid MinItemWidth="190" MaxColumns="3" Margin="0,0,-12,0">
                            <Button Style="{StaticResource CardButton}" Command="{Binding OpenDetailCommand}" CommandParameter="ram"
                                    AutomationProperties.Name="Abrir detalhes da memória">
                                <StackPanel Margin="0,0,12,0">
                                    <TextBlock Text="Memória" Style="{StaticResource SystemItemTitle}"/>
                                    <TextBlock Text="{Binding RamUsageFormatted}" Style="{StaticResource Metric}" FontSize="24"
                                               Foreground="{StaticResource RamBrush}" Margin="0,4,0,0"/>
                                    <TextBlock Text="{Binding RamDetail}" Style="{StaticResource SystemDetail}"/>
                                    <ProgressBar Style="{StaticResource TelemetryMeter}" Foreground="{StaticResource RamBrush}" Margin="0,10,0,0"
                                                 Value="{Binding Snapshot.RamUsage, Mode=OneWay, TargetNullValue=0, FallbackValue=0}"
                                                 AutomationProperties.Name="Uso da memória"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource CardButton}" Command="{Binding OpenDetailCommand}" CommandParameter="fans"
                                    AutomationProperties.Name="Abrir detalhes das ventoinhas">
                                <StackPanel Margin="0,0,12,0">
                                    <TextBlock Text="Ventoinhas" Style="{StaticResource SystemItemTitle}"/>
                                    <TextBlock Text="{Binding AverageFanRpmFormatted}" Style="{StaticResource Metric}" FontSize="24"
                                               Foreground="{StaticResource AccentBrush}" Margin="0,4,0,0"/>
                                    <TextBlock Text="{Binding FanCountLabel}" Style="{StaticResource SystemDetail}"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource CardButton}" Command="{Binding OpenDetailCommand}" CommandParameter="coolant"
                                    Visibility="{Binding HasLiquidCooling, Converter={StaticResource BoolToVis}}"
                                    AutomationProperties.Name="Abrir detalhes do líquido e da bomba">
                                <StackPanel Margin="0,0,12,0">
                                    <TextBlock Text="Líquido e bomba" Style="{StaticResource SystemItemTitle}"/>
                                    <TextBlock Text="{Binding CoolantTempFormatted}" Style="{StaticResource Metric}" FontSize="24"
                                               Foreground="{StaticResource CoolantBrush}" Margin="0,4,0,0"/>
                                    <TextBlock Text="{Binding PumpRpmFormatted, StringFormat='Bomba · {0}'}" Style="{StaticResource SystemDetail}"/>
                                </StackPanel>
                            </Button>
                        </c:AdaptiveUniformGrid>

                        <c:AdaptiveUniformGrid MinItemWidth="360" MaxColumns="2" Margin="0,0,-12,0">
                            <Border Style="{StaticResource SystemPanel}" Margin="0,0,12,12">
                                <StackPanel>
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Content="Abrir Ventoinhas" Style="{StaticResource SystemLinkButton}"
                                                Command="{Binding NavigateCommand}" CommandParameter="1" Margin="8,-4,-6,0"/>
                                        <TextBlock Text="Perfis de ventoinhas" Style="{StaticResource SystemSectionTitle}" VerticalAlignment="Center"/>
                                    </DockPanel>
                                    <TextBlock Text="{Binding CurveStatus}" Style="{StaticResource SystemDetail}"/>
                                    <ItemsControl ItemsSource="{Binding PresetItems}" Margin="0,12,0,0">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <ToggleButton Style="{StaticResource Chip}" IsChecked="{Binding IsActive, Mode=OneWay}" ToolTip="{Binding Tooltip}"
                                                              Command="{Binding DataContext.ApplyPresetCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                              CommandParameter="{Binding Key}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Style="{StaticResource Icon}" Text="{Binding Icon}" FontSize="13" Margin="0,0,7,0"/>
                                                        <TextBlock Text="{Binding Label}"/>
                                                    </StackPanel>
                                                </ToggleButton>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <ItemsControl ItemsSource="{Binding Profiles}" Visibility="{Binding HasProfiles, Converter={StaticResource BoolToVis}}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <ToggleButton Style="{StaticResource Chip}" IsChecked="{Binding IsActive, Mode=OneWay}" Content="{Binding Name}"
                                                              Command="{Binding DataContext.ApplyProfileCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                              CommandParameter="{Binding Name}"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <DockPanel Margin="0,4,0,0">
                                        <TextBlock DockPanel.Dock="Left" Text="Potência" Style="{StaticResource Label}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding GlobalSpeedFormatted}" Style="{StaticResource SystemItemTitle}"
                                                   Foreground="{StaticResource AccentBrush}" Width="48" TextAlignment="Right" VerticalAlignment="Center"/>
                                        <Slider Minimum="25" Maximum="100" Value="{Binding GlobalSpeedPercent}"
                                                AutomationProperties.Name="Potência global" ToolTip="Ctrl+↑ / Ctrl+↓ ajusta 5%"/>
                                    </DockPanel>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource SystemPanel}" Margin="0,0,12,12">
                                <StackPanel>
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Content="{Binding AlertCenter.HistoryLabel}"
                                                Style="{StaticResource SystemLinkButton}" VerticalAlignment="Center"
                                                Click="OpenAlertHistory_Click" AutomationProperties.Name="Histórico de alertas"/>
                                        <TextBlock Text="Alertas" Style="{StaticResource SystemSectionTitle}" VerticalAlignment="Center"/>
                                    </DockPanel>
                                    <TextBlock Text="{Binding AlertCenter.PanelMessage}" Style="{StaticResource SystemDetail}" Margin="0,6,0,0"
                                               Visibility="{Binding AlertCenter.PanelMessage, Converter={StaticResource NullToVis}}"/>
                                    <ItemsControl x:Name="DashboardAlerts" ItemsSource="{Binding AlertCenter.Preview}">
                                        <ItemsControl.Style>
                                            <Style TargetType="ItemsControl">
                                                <Setter Property="Margin" Value="0,8,0,0"/>
                                                <Style.Triggers>
                                                    <Trigger Property="HasItems" Value="False">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ItemsControl.Style>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{Binding Severity, Converter={StaticResource SeverityToSoftBrush}}"
                                                        CornerRadius="8" Padding="12,7" Margin="0,0,0,6">
                                                    <DockPanel>
                                                        <Button DockPanel.Dock="Right" Style="{StaticResource DismissNoticeButton}" VerticalAlignment="Top"
                                                                Command="{Binding DataContext.AlertCenter.DismissCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}"/>
                                                        <TextBlock DockPanel.Dock="Left" Style="{StaticResource Icon}" Text="&#xE7BA;"
                                                                   VerticalAlignment="Top" Margin="0,2,10,0"
                                                                   Foreground="{Binding Severity, Converter={StaticResource SeverityToBrush}}"/>
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding Title}" Style="{StaticResource SystemItemTitle}" MaxHeight="36"
                                                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}"/>
                                                            <TextBlock Text="{Binding Message}" Style="{StaticResource SystemDetail}"
                                                                       TextTrimming="CharacterEllipsis" MaxHeight="34" ToolTip="{Binding Message}"/>
                                                        </StackPanel>
                                                    </DockPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Border Style="{StaticResource SystemRow}" Margin="0,12,0,0"
                                            Visibility="{Binding Snapshot.GpuName, Converter={StaticResource NullToVis}}">
                                        <StackPanel>
                                            <TextBlock Text="Ventoinhas da GPU" Style="{StaticResource SystemItemTitle}"/>
                                            <TextBlock Text="{Binding GpuFanModeText}" Style="{StaticResource SystemDetail}"/>
                                            <TextBlock Text="{Binding GpuFanRpmFormatted}" Style="{StaticResource SystemDetail}"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </c:AdaptiveUniformGrid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Rede e discos" Style="{StaticResource SystemTab}">
                <ScrollViewer Style="{StaticResource SystemScroll}">
                    <StackPanel Margin="0,0,0,24">
                        <c:AdaptiveUniformGrid MinItemWidth="275" MaxColumns="2" Margin="0,0,-12,0">
                            <Button Style="{StaticResource CardButton}" Command="{Binding OpenDetailCommand}" CommandParameter="net"
                                    AutomationProperties.Name="Abrir detalhes da rede">
                                <StackPanel Margin="0,0,14,0">
                                    <DockPanel>
                                        <Border DockPanel.Dock="Left" Style="{StaticResource SystemIconTile}" Margin="0,0,12,0">
                                            <TextBlock Text="&#xE701;" Style="{StaticResource SystemIcon}"/>
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Rede" Style="{StaticResource SystemItemTitle}"/>
                                            <TextBlock Text="{Binding NetAdapter}" Style="{StaticResource SystemDetail}" TextWrapping="NoWrap"
                                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding NetAdapter}"/>
                                        </StackPanel>
                                    </DockPanel>
                                    <TextBlock Text="{Binding NetDownFormatted}" Style="{StaticResource Metric}" Foreground="{StaticResource GpuBrush}" Margin="0,12,0,0"/>
                                    <TextBlock Text="Download" Style="{StaticResource Label}"/>
                                    <c:Sparkline Values="{Binding NetHistory}" Stroke="{StaticResource GpuBrush}" Height="40" MinRange="1"
                                                 ClipToBounds="True" Margin="0,6,0,10" AutomationProperties.Name="Histórico de download"/>
                                    <TextBlock Text="{Binding NetUpFormatted, StringFormat='Upload · {0}'}" Style="{StaticResource SystemDetail}"/>
                                    <TextBlock Text="{Binding NetLinkFormatted, StringFormat='Velocidade do link · {0}'}" Style="{StaticResource SystemDetail}"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource CardButton}" Command="{Binding OpenDetailCommand}" CommandParameter="disk"
                                    AutomationProperties.Name="Abrir detalhes dos discos">
                                <StackPanel Margin="0,0,14,0">
                                    <DockPanel>
                                        <Border DockPanel.Dock="Left" Style="{StaticResource SystemIconTile}" Margin="0,0,12,0">
                                            <TextBlock Text="&#xE8B7;" Style="{StaticResource SystemIcon}"/>
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Armazenamento" Style="{StaticResource SystemItemTitle}"/>
                                            <TextBlock Text="{Binding DiskMainDetail}" Style="{StaticResource SystemDetail}"/>
                                        </StackPanel>
                                    </DockPanel>
                                    <TextBlock Text="{Binding DiskMainFormatted}" Style="{StaticResource Metric}" Foreground="{StaticResource WarningBrush}" Margin="0,12,0,0"/>
                                    <TextBlock Text="Ocupação do volume principal" Style="{StaticResource Label}"/>
                                    <TextBlock Text="{Binding DiskActivityFormatted}" Style="{StaticResource SystemDetail}" Margin="0,8,0,0"/>
                                    <c:Sparkline Values="{Binding DiskHistory}" Stroke="{StaticResource WarningBrush}" Height="40" MinRange="10"
                                                 ClipToBounds="True" Margin="0,6,0,10" AutomationProperties.Name="Histórico de atividade dos discos"/>
                                </StackPanel>
                            </Button>
                        </c:AdaptiveUniformGrid>
                        <Border Style="{StaticResource SystemPanel}" Margin="0,4,0,0"
                                Visibility="{Binding Snapshot.Volumes.Count, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <TextBlock Text="Volumes locais" Style="{StaticResource SystemSectionTitle}" Margin="0,0,0,12"/>
                                <ItemsControl x:Name="DashboardVolumes" ItemsSource="{Binding Snapshot.Volumes}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource SystemRow}">
                                                <StackPanel>
                                                    <DockPanel>
                                                        <TextBlock DockPanel.Dock="Right" Text="{Binding UsedPercent, StringFormat='{}{0:0}% ocupado'}"
                                                                   Style="{StaticResource SystemDetail}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                                        <TextBlock Style="{StaticResource SystemItemTitle}">
                                                            <Run Text="{Binding Letter, Mode=OneWay}"/><Run Text=" "/><Run Text="{Binding Label, Mode=OneWay}"/>
                                                        </TextBlock>
                                                    </DockPanel>
                                                    <ProgressBar Style="{StaticResource TelemetryMeter}" Value="{Binding UsedPercent, Mode=OneWay}"
                                                                 AutomationProperties.Name="{Binding Letter, StringFormat='Uso do volume {0}'}" Margin="0,8,0,6"/>
                                                    <TextBlock Style="{StaticResource SystemDetail}">
                                                        <Run Text="{Binding FreeGb, Mode=OneWay, StringFormat='{}{0:0.#} GB livres'}"/><Run Text=" de "/><Run Text="{Binding TotalGb, Mode=OneWay, StringFormat='{}{0:0.#} GB'}"/>
                                                    </TextBlock>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
