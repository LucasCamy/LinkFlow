<UserControl x:Class="LinkFlow.App.Views.HardwarePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:LinkFlow.App.Controls">
    <UserControl.Resources>
        <DataTemplate x:Key="PartGroupCard">
            <Border Style="{StaticResource SystemPanel}" Margin="0,0,12,12">
                <StackPanel>
                    <DockPanel Margin="0,0,0,12">
                        <Border Style="{StaticResource SystemIconTile}" Width="34" Height="34" Margin="0,0,10,0">
                            <TextBlock Text="{Binding Icon}" Style="{StaticResource SystemIcon}" FontSize="15"/>
                        </Border>
                        <TextBlock Text="{Binding Category}" Style="{StaticResource SystemSectionTitle}" FontSize="15"
                                   VerticalAlignment="Center"/>
                    </DockPanel>
                    <ItemsControl ItemsSource="{Binding Parts}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource SystemRow}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource SystemItemTitle}"/>
                                        <TextBlock Text="{Binding Details}" Style="{StaticResource SystemDetail}"
                                                   Visibility="{Binding Details, Converter={StaticResource BoolToVis}}"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </DataTemplate>
        <ItemsPanelTemplate x:Key="PartGroupsPanel">
            <c:AdaptiveUniformGrid MinItemWidth="300" MaxColumns="2" StackColumns="True"/>
        </ItemsPanelTemplate>
    </UserControl.Resources>

    <Grid Margin="24,20,24,0" MaxWidth="1160">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,18">
            <TextBlock Text="Hardware" Style="{StaticResource SystemPageTitle}"/>
            <TextBlock Text="Especificações deste PC e compatibilidade com o LinkFlow." Style="{StaticResource SystemDetail}"/>
        </StackPanel>

        <TabControl x:Name="HardwareTabs" Grid.Row="1" Style="{StaticResource SystemTabs}" SelectedIndex="0">
            <TabItem Header="Meu PC" Style="{StaticResource SystemTab}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Style="{StaticResource SystemPanel}" Margin="0,0,8,14">
                        <StackPanel>
                            <DockPanel>
                                <Button x:Name="ScanButton" DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}"
                                        Content="Detectar hardware" Click="Scan_Click" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                <Border DockPanel.Dock="Left" Style="{StaticResource SystemIconTile}" Margin="0,0,12,0">
                                    <TextBlock Text="&#xE7F8;" Style="{StaticResource SystemIcon}"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Inventário do PC" Style="{StaticResource SystemSectionTitle}"/>
                                    <TextBlock x:Name="InventoryStatus" Text="Leia os componentes e suas especificações."
                                               Style="{StaticResource SystemDetail}" AutomationProperties.LiveSetting="Polite"/>
                                </StackPanel>
                            </DockPanel>
                            <Grid x:Name="InventoryFilterPanel" Margin="0,14,0,0" MaxWidth="480"
                                  HorizontalAlignment="Left" Visibility="Collapsed">
                                <TextBox x:Name="InventoryFilter" Style="{StaticResource SystemSearch}" Width="320"
                                         TextChanged="Filter_Changed" Tag="Filtrar por peça ou especificação"
                                         AutomationProperties.Name="Filtrar peças"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <ScrollViewer Grid.Row="1" Style="{StaticResource SystemScroll}">
                        <ItemsControl x:Name="DetectedParts" ItemsPanel="{StaticResource PartGroupsPanel}"
                                      ItemTemplate="{StaticResource PartGroupCard}" Margin="0,0,-12,12"/>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <TabItem Header="Compatibilidade" Style="{StaticResource SystemTab}">
                <ScrollViewer Style="{StaticResource SystemScroll}">
                    <ItemsControl x:Name="SupportedParts" ItemsPanel="{StaticResource PartGroupsPanel}"
                                  ItemTemplate="{StaticResource PartGroupCard}" Margin="0,0,-12,12"/>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
