<Window x:Class="LinkFlow.App.Views.DriverInstallDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:r="clr-namespace:LinkFlow.App.Resources"
        Title="{x:Static r:Strings.Drv_RevisarInstalacao}" Width="620" SizeToContent="Height" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextBrush}" FontFamily="{StaticResource UiFont}">
    <StackPanel Margin="24">
        <TextBlock Text="{x:Static r:Strings.Drv_InstalarAtualizacaoDriver}" Style="{StaticResource PageTitle}"/>
        <TextBlock x:Name="DriverTitle" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,12,0,0"/>
        <TextBlock Text="{x:Static r:Strings.Drv_WindowsUpdateVaiBaixar}"
                   Style="{StaticResource PageSubtitle}" Margin="0,6,0,0"/>
        <StackPanel x:Name="LicensePanel" Visibility="Collapsed" Margin="0,16,0,0">
            <TextBlock Text="{x:Static r:Strings.Drv_TermosLicenca}" Style="{StaticResource SectionTitle}" Margin="0,0,0,6"/>
            <TextBox x:Name="LicenseText" AutomationProperties.Name="{x:Static r:Strings.Drv_TermosLicenca}" Height="230" IsReadOnly="True"
                     TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="{x:Static r:Strings.Common_Cancel}" IsCancel="True" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"/>
            <Button x:Name="ConfirmButton" Content="{x:Static r:Strings.Drv_InstalarDriver}" Click="Confirm_Click" Style="{StaticResource PrimaryButton}"/>
        </StackPanel>
    </StackPanel>
</Window>
