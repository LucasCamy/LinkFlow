<Window x:Class="LinkFlow.App.Views.DriverInstallDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Revisar instalação" Width="620" SizeToContent="Height" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextBrush}" FontFamily="{StaticResource UiFont}">
    <StackPanel Margin="24">
        <TextBlock Text="Instalar atualização de driver?" Style="{StaticResource PageTitle}"/>
        <TextBlock x:Name="DriverTitle" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,12,0,0"/>
        <TextBlock Text="O Windows Update vai baixar e instalar este driver. O Windows pode pedir para reiniciar ao terminar."
                   Style="{StaticResource PageSubtitle}" Margin="0,6,0,0"/>
        <StackPanel x:Name="LicensePanel" Visibility="Collapsed" Margin="0,16,0,0">
            <TextBlock Text="Termos de licença" Style="{StaticResource SectionTitle}" Margin="0,0,0,6"/>
            <TextBox x:Name="LicenseText" AutomationProperties.Name="Termos de licença" Height="230" IsReadOnly="True"
                     TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Cancelar" IsCancel="True" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"/>
            <Button x:Name="ConfirmButton" Content="Instalar driver" Click="Confirm_Click" Style="{StaticResource PrimaryButton}"/>
        </StackPanel>
    </StackPanel>
</Window>
