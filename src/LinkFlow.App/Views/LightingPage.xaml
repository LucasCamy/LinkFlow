<UserControl x:Class="LinkFlow.App.Views.LightingPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:LinkFlow.App.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="8,8,20,24">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Iluminação" Style="{StaticResource PageTitle}"/>
                    <TextBlock Text="A cor é aplicada em tempo real em todos os dispositivos marcados." Style="{StaticResource PageSubtitle}"/>
                </StackPanel>
                <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Command="{Binding ResendRgbCommand}" VerticalAlignment="Center"
                        ToolTip="Reconecta e reenvia a cor para todos os dispositivos (útil após o iCUE ou outro app mudar as luzes)">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE72C;" FontSize="13" Margin="0,0,8,0"/>
                        <TextBlock Text="Reenviar para todos"/>
                    </StackPanel>
                </Button>
            </Grid>

            <c:AdaptiveUniformGrid MinItemWidth="400" MaxColumns="2" Margin="0,16,-12,0">
                <!-- Cor -->
                <Border Style="{StaticResource GridCard}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Cor" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Grid.Column="1" Text="{Binding RgbSyncStatus}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" MaxWidth="260"/>
                        </Grid>

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <!-- Quadro de cores: saturação (horizontal) × brilho (vertical) -->
                            <c:ColorSpectrum Height="210" MinWidth="200" Hue="{Binding Hue}" Saturation="{Binding ColorSaturation}" Value="{Binding ColorValue}"
                                             ToolTip="Clique ou arraste para escolher • setas para ajuste fino (Shift = passos maiores)"
                                             AutomationProperties.Name="Quadro de cores"/>
                            <StackPanel Grid.Column="1" Width="132" Margin="16,0,0,0">
                                <Border Height="92" CornerRadius="12" BorderThickness="2" BorderBrush="{StaticResource BorderBrush}"
                                        Background="{Binding CurrentRgbHex, Converter={StaticResource HexToBrush}}" ToolTip="Cor atual"/>
                                <TextBlock Text="Código" Style="{StaticResource Label}" Margin="0,12,0,4"/>
                                <TextBox Text="{Binding HexInput, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" FontSize="15"
                                         ToolTip="Digite #RRGGBB ou #RGB" AutomationProperties.Name="Código da cor">
                                    <TextBox.Style>
                                        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HexInvalid}" Value="True">
                                                    <Setter Property="BorderBrush" Value="{StaticResource DangerBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBox.Style>
                                </TextBox>
                                <TextBlock Style="{StaticResource Caption}" Margin="0,8,0,0" FontFamily="Consolas">
                                    <Run Text="R " Foreground="#F87171"/><Run Text="{Binding RgbR, Mode=OneWay}"/>
                                    <Run Text="  G " Foreground="#34D399"/><Run Text="{Binding RgbG, Mode=OneWay}"/>
                                    <Run Text="  B " Foreground="#60A5FA"/><Run Text="{Binding RgbB, Mode=OneWay}"/>
                                </TextBlock>
                            </StackPanel>
                        </Grid>

                        <Slider Style="{StaticResource HueSlider}" Minimum="0" Maximum="359.9" Value="{Binding Hue}" SmallChange="1" LargeChange="15"
                                Margin="0,14,0,0" ToolTip="Matiz" AutomationProperties.Name="Matiz"/>

                        <TextBlock Text="Cores rápidas" Style="{StaticResource Label}" Margin="0,16,0,8"/>
                        <ItemsControl ItemsSource="{Binding QuickColors}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Width="34" Height="34" Margin="0,0,8,8" ToolTip="{Binding Name}" AutomationProperties.Name="{Binding Name}"
                                            Command="{Binding DataContext.ApplyColorCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding Hex}" Cursor="Hand" FocusVisualStyle="{StaticResource FocusRing}">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="Sw" CornerRadius="17" BorderThickness="2" BorderBrush="{StaticResource BorderBrush}"
                                                        Background="{Binding Hex, Converter={StaticResource HexToBrush}}"/>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Sw" Property="BorderBrush" Value="{StaticResource TextBrush}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="Recentes" Style="{StaticResource Label}" Margin="0,8,0,8"/>
                        <ItemsControl ItemsSource="{Binding RecentColors}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Width="28" Height="28" Margin="0,0,8,8" ToolTip="{Binding}" Cursor="Hand"
                                            Command="{Binding DataContext.ApplyColorCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="Sw" CornerRadius="7" BorderThickness="1.5" BorderBrush="{StaticResource BorderBrush}"
                                                        Background="{Binding Converter={StaticResource HexToBrush}}"/>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Sw" Property="BorderBrush" Value="{StaticResource TextBrush}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="As cores que você usar aparecem aqui." Style="{StaticResource Caption}"
                                   Visibility="{Binding RecentColors.Count, Converter={StaticResource BoolToVisInverse}}"/>
                    </StackPanel>
                </Border>

                <!-- Ajuste fino e dispositivos -->
                <Border Style="{StaticResource GridCard}">
                    <StackPanel>
                        <TextBlock Text="Ajuste fino (RGB)" Style="{StaticResource SectionTitle}" Margin="0,0,0,12"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="72"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="44"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="34"/>
                                <RowDefinition Height="34"/>
                                <RowDefinition Height="34"/>
                                <RowDefinition Height="34"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="Vermelho" Foreground="#F87171" VerticalAlignment="Center"/>
                            <Slider Grid.Column="1" Minimum="0" Maximum="255" Value="{Binding RgbR}" Foreground="#F87171"/>
                            <TextBlock Grid.Column="2" Text="{Binding RgbR}" TextAlignment="Right" VerticalAlignment="Center" Foreground="{StaticResource TextMutedBrush}"/>

                            <TextBlock Grid.Row="1" Text="Verde" Foreground="#34D399" VerticalAlignment="Center"/>
                            <Slider Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="255" Value="{Binding RgbG}" Foreground="#34D399"/>
                            <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding RgbG}" TextAlignment="Right" VerticalAlignment="Center" Foreground="{StaticResource TextMutedBrush}"/>

                            <TextBlock Grid.Row="2" Text="Azul" Foreground="#60A5FA" VerticalAlignment="Center"/>
                            <Slider Grid.Row="2" Grid.Column="1" Minimum="0" Maximum="255" Value="{Binding RgbB}" Foreground="#60A5FA"/>
                            <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding RgbB}" TextAlignment="Right" VerticalAlignment="Center" Foreground="{StaticResource TextMutedBrush}"/>

                            <TextBlock Grid.Row="3" Text="Brilho" Foreground="{StaticResource WarningBrush}" VerticalAlignment="Center"/>
                            <Slider Grid.Row="3" Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding RgbBrightness}" Foreground="{StaticResource WarningBrush}"/>
                            <TextBlock Grid.Row="3" Grid.Column="2" Text="{Binding RgbBrightnessFormatted}" TextAlignment="Right" VerticalAlignment="Center" Foreground="{StaticResource TextMutedBrush}"/>
                        </Grid>

                        <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,16"/>

                        <TextBlock Text="Sincronizar com" Style="{StaticResource SectionTitle}" Margin="0,0,0,8"/>
                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding SyncHub}">
                            <StackPanel>
                                <TextBlock Text="Ventoinhas e bomba (iCUE LINK)"/>
                                <TextBlock Text="{Binding ConnectionStatus}" Style="{StaticResource Caption}"/>
                            </StackPanel>
                        </CheckBox>
                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding SyncLcd}">
                            <StackPanel>
                                <TextBlock Text="Display LCD da bomba"/>
                                <TextBlock Text="{Binding LcdStatus}" Style="{StaticResource Caption}"/>
                            </StackPanel>
                        </CheckBox>
                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding SyncGpu}">
                            <StackPanel>
                                <TextBlock Text="Placa de vídeo (ASUS Aura)"/>
                                <TextBlock Text="{Binding GpuRgbStatus}" Style="{StaticResource Caption}"/>
                            </StackPanel>
                        </CheckBox>
                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding SyncMotherboard}">
                            <StackPanel>
                                <TextBlock Text="Placa-mãe e saídas ARGB (MSI Mystic Light)"/>
                                <TextBlock Text="{Binding MotherboardRgbStatus}" Style="{StaticResource Caption}"/>
                            </StackPanel>
                        </CheckBox>
                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding SyncRam}">
                            <StackPanel>
                                <TextBlock Text="Memórias DDR5 (Corsair Vengeance RGB)"/>
                                <TextBlock Text="{Binding RamRgbStatus}" Style="{StaticResource Caption}"/>
                            </StackPanel>
                        </CheckBox>
                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding SyncPeripherals}">
                            <StackPanel>
                                <TextBlock Text="Periféricos (Logitech G915 X / Mouse / Headset)"/>
                                <TextBlock Text="{Binding PeripheralsRgbStatus}" Style="{StaticResource Caption}"/>
                            </StackPanel>
                        </CheckBox>
                    </StackPanel>
                </Border>
            </c:AdaptiveUniformGrid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
