<UserControl x:Class="LinkFlow.App.Views.WindowsNetworkPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:LinkFlow.App.Controls"
             Language="pt-BR">
    <UserControl.Resources>
        <Style x:Key="NetworkCard" TargetType="Border" BasedOn="{StaticResource SystemPanel}">
            <Setter Property="Margin" Value="0,0,12,12"/>
        </Style>
        <Style x:Key="MeasurementValue" TargetType="TextBlock" BasedOn="{StaticResource Metric}">
            <Setter Property="FontSize" Value="23"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,5,0,0"/>
        </Style>
        <Style x:Key="SpeedArc" TargetType="Path">
            <Setter Property="StrokeThickness" Value="10"/>
            <Setter Property="StrokeStartLineCap" Value="Round"/>
            <Setter Property="StrokeEndLineCap" Value="Round"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
        </Style>
    </UserControl.Resources>
    <ScrollViewer Style="{StaticResource SystemScroll}">
        <StackPanel Margin="0,0,0,24">
            <Border Style="{StaticResource SystemPanel}" Margin="0,0,0,12">
                <StackPanel>
                    <DockPanel>
                        <Border DockPanel.Dock="Left" Style="{StaticResource SystemIconTile}" Margin="0,0,12,0">
                            <TextBlock Text="&#xE701;" Style="{StaticResource SystemIcon}"/>
                        </Border>
                        <StackPanel>
                            <TextBlock Text="Teste de velocidade" Style="{StaticResource SystemSectionTitle}"/>
                            <TextBlock x:Name="NetworkMethod" Style="{StaticResource SystemDetail}"/>
                        </StackPanel>
                    </DockPanel>
                    <TextBlock x:Name="NetworkStatus" Text="Pronto para testar" Style="{StaticResource SystemItemTitle}"
                               TextAlignment="Center" Margin="0,20,0,0" AutomationProperties.LiveSetting="Polite"/>
                    <Viewbox MaxWidth="320" StretchDirection="DownOnly" Margin="0,8,0,0">
                        <Grid Width="320" Height="176">
                            <Path x:Name="GaugeTrack" Style="{StaticResource SpeedArc}" Stroke="{StaticResource BorderBrush}"/>
                            <Path x:Name="GaugeFill" Style="{StaticResource SpeedArc}" Stroke="{StaticResource AccentBrush}" Visibility="Collapsed"/>
                            <StackPanel VerticalAlignment="Bottom" Margin="0,0,0,36">
                                <TextBlock x:Name="GaugeRate" Text="—" Style="{StaticResource Metric}" FontSize="44" TextAlignment="Center"/>
                                <TextBlock x:Name="GaugeCaption" Text="Mbps" Style="{StaticResource SystemDetail}" TextAlignment="Center"/>
                            </StackPanel>
                            <Grid Width="272" VerticalAlignment="Bottom">
                                <TextBlock Text="0" Style="{StaticResource SystemDetail}" HorizontalAlignment="Left"/>
                                <TextBlock x:Name="GaugeMaximum" Style="{StaticResource SystemDetail}" HorizontalAlignment="Right"/>
                            </Grid>
                        </Grid>
                    </Viewbox>
                    <TextBlock x:Name="LiveTransferDetail" Style="{StaticResource SystemDetail}" TextAlignment="Center" MinHeight="18"
                               Margin="0,8,0,0" Visibility="Hidden"/>
                    <Grid HorizontalAlignment="Center" MinWidth="110" Margin="0,14,0,0">
                        <Button x:Name="StartNetworkButton" Content="Iniciar teste" Click="StartNetwork_Click" Style="{StaticResource PrimaryButton}"/>
                        <Button x:Name="CancelNetworkButton" Content="Cancelar" Click="CancelNetwork_Click" Style="{StaticResource SecondaryButton}"
                                Visibility="Collapsed"/>
                    </Grid>
                    <ProgressBar x:Name="NetworkProgress" Height="4" Maximum="1" Margin="0,12,0,0" Visibility="Hidden"
                                 Background="{StaticResource BorderBrush}" Foreground="{StaticResource AccentBrush}"
                                 AutomationProperties.Name="Progresso do teste de velocidade"/>
                </StackPanel>
            </Border>
            <c:AdaptiveUniformGrid MinItemWidth="178" MaxColumns="3" Margin="0,0,-12,0">
                <Border Style="{StaticResource NetworkCard}">
                    <StackPanel>
                        <TextBlock Text="Ping · Google" Style="{StaticResource SystemItemTitle}"/>
                        <TextBlock x:Name="LatencyValue" Text="—" Style="{StaticResource MeasurementValue}" Foreground="{StaticResource CpuBrush}"/>
                        <TextBlock x:Name="LatencyDetail" Style="{StaticResource SystemDetail}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource NetworkCard}">
                    <StackPanel>
                        <TextBlock Text="Download" Style="{StaticResource SystemItemTitle}"/>
                        <TextBlock x:Name="DownloadValue" Text="—" Style="{StaticResource MeasurementValue}" Foreground="{StaticResource GpuBrush}"/>
                        <TextBlock x:Name="DownloadDetail" Style="{StaticResource SystemDetail}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource NetworkCard}">
                    <StackPanel>
                        <TextBlock Text="Upload" Style="{StaticResource SystemItemTitle}"/>
                        <TextBlock x:Name="UploadValue" Text="—" Style="{StaticResource MeasurementValue}" Foreground="{StaticResource RamBrush}"/>
                        <TextBlock x:Name="UploadDetail" Style="{StaticResource SystemDetail}"/>
                    </StackPanel>
                </Border>
            </c:AdaptiveUniformGrid>
            <Border Style="{StaticResource SystemPanel}">
                <StackPanel>
                    <TextBlock Text="Adaptador em uso" Style="{StaticResource SystemSectionTitle}"/>
                    <TextBlock Text="{Binding NetAdapter}" Style="{StaticResource SystemItemTitle}" Margin="0,7,0,0"/>
                    <TextBlock Text="{Binding NetLinkFormatted, StringFormat='Velocidade do link · {0}'}" Style="{StaticResource SystemDetail}"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
