<Window x:Class="LinkFlow.App.Views.CalibrationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Calibrar ventoinhas" Width="580" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource SurfaceBrush}" Foreground="{StaticResource TextBrush}" FontFamily="{StaticResource UiFont}"
        UseLayoutRounding="True">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="0" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <Style x:Key="CalibrationMeter" TargetType="ProgressBar">
            <Setter Property="Height" Value="8"/>
            <Setter Property="Maximum" Value="100"/>
            <Setter Property="Background" Value="{StaticResource BgBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border x:Name="PART_Track" Background="{TemplateBinding Background}" CornerRadius="4"/>
                            <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" CornerRadius="4" HorizontalAlignment="Left"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Bullet" TargetType="TextBlock" BasedOn="{StaticResource SystemDetail}">
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
    </Window.Resources>

    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
        <StackPanel>
            <Grid Height="40">
                <TextBlock Text="Calibrar ventoinhas" FontWeight="SemiBold" Margin="18,0,0,0" VerticalAlignment="Center"/>
                <Button Style="{StaticResource CloseCaptionButton}" Content="&#xE8BB;" HorizontalAlignment="Right" Margin="0,0,4,0"
                        WindowChrome.IsHitTestVisibleInChrome="True" Click="Close_Click" AutomationProperties.Name="Fechar"/>
            </Grid>

            <StackPanel Margin="20,4,20,18">
                <!-- Introdução -->
                <StackPanel Visibility="{Binding IsIntro, Converter={StaticResource BoolToVis}}">
                    <TextBlock Style="{StaticResource Bullet}" Text="• Mede a rotação de cada ventoinha de 100% até 20%."/>
                    <TextBlock Style="{StaticResource Bullet}" Text="• Se alguma parar em potência baixa, descobre quanto ela precisa para voltar a girar e passa a mantê-la acima disso."/>
                    <TextBlock Style="{StaticResource Bullet}" Text="• Guarda uma referência: o LinkFlow avisa quando uma ventoinha passar a girar bem abaixo do normal (poeira ou rolamento gasto)."/>

                    <Border Background="{StaticResource BgBrush}" CornerRadius="10" Padding="14,10" Margin="0,8,0,0">
                        <StackPanel>
                            <TextBlock Text="{Binding FanCountText}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,0"
                                       Text="Leva cerca de 1 minuto. As ventoinhas aceleram ao máximo e depois desaceleram. Evite jogos e tarefas pesadas enquanto isso. Se a CPU, a GPU ou o líquido chegarem à temperatura de alerta, a calibração para e as ventoinhas voltam ao perfil."/>
                            <TextBlock Text="{Binding LastCalibration}" Style="{StaticResource Caption}" Margin="0,6,0,0"
                                       Visibility="{Binding LastCalibration, Converter={StaticResource NullToVis}}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Em andamento -->
                <StackPanel Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}" Margin="0,6,0,0">
                    <Grid Margin="0,0,0,10">
                        <TextBlock Text="{Binding Message}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,60,0"
                                   AutomationProperties.LiveSetting="Polite"/>
                        <TextBlock Text="{Binding Progress, StringFormat={}{0:0}%}" HorizontalAlignment="Right" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold"/>
                    </Grid>
                    <ProgressBar Style="{StaticResource CalibrationMeter}" Value="{Binding Progress, Mode=OneWay}" AutomationProperties.Name="Progresso da calibração"/>
                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,10,0,0"
                               Text="Pode fechar esta janela: a calibração é cancelada e as ventoinhas voltam ao perfil na hora."/>
                </StackPanel>

                <!-- Resultado -->
                <StackPanel Visibility="{Binding IsDone, Converter={StaticResource BoolToVis}}" Margin="0,6,0,0">
                    <DockPanel Margin="0,0,0,12">
                        <TextBlock DockPanel.Dock="Left" FontSize="18" Margin="0,0,12,0" VerticalAlignment="Top">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Icon}">
                                    <Setter Property="Text" Value="&#xE7BA;"/>
                                    <Setter Property="Foreground" Value="{StaticResource WarningBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Succeeded}" Value="True">
                                            <Setter Property="Text" Value="&#xE73E;"/>
                                            <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="{Binding Message}" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center"
                                   AutomationProperties.LiveSetting="Polite"/>
                    </DockPanel>
                    <ScrollViewer MaxHeight="340" Style="{StaticResource SystemScroll}" Visibility="{Binding HasResults, Converter={StaticResource BoolToVis}}">
                        <ItemsControl ItemsSource="{Binding Results}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,8">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding Detail}" Style="{StaticResource Caption}" VerticalAlignment="Top" Margin="12,1,0,0"/>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding Note}" TextWrapping="Wrap" FontSize="12" Margin="0,2,0,0"
                                                           Visibility="{Binding Note, Converter={StaticResource NullToVis}}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Warning}" Value="True">
                                                                    <Setter Property="Foreground" Value="{StaticResource WarningBrush}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>

                <!-- Botões -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                    <Button Style="{StaticResource SecondaryButton}" Content="Cancelar" Margin="0,0,8,0" Click="Close_Click" IsCancel="True"
                            Visibility="{Binding IsIntro, Converter={StaticResource BoolToVis}}"/>
                    <Button Style="{StaticResource PrimaryButton}" Content="Iniciar calibração" Command="{Binding StartCommand}" IsDefault="True"
                            Visibility="{Binding IsIntro, Converter={StaticResource BoolToVis}}"/>
                    <Button Style="{StaticResource DangerButton}" Content="Cancelar calibração" Command="{Binding CancelCommand}"
                            Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}"/>
                    <Button Style="{StaticResource SecondaryButton}" Content="Calibrar de novo" Margin="0,0,8,0" Command="{Binding StartCommand}"
                            Visibility="{Binding IsDone, Converter={StaticResource BoolToVis}}"/>
                    <Button Style="{StaticResource PrimaryButton}" Content="Fechar" Click="Close_Click" IsDefault="True"
                            Visibility="{Binding IsDone, Converter={StaticResource BoolToVis}}"/>
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
