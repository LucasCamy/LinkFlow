<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\LinkFlow.Core\LinkFlow.Core.csproj" />
    <InternalsVisibleTo Include="LinkFlow.Tests" />
    <None Include="..\..\THIRD-PARTY-NOTICES.txt" Link="THIRD-PARTY-NOTICES.txt"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- WinForms apenas para o NotifyIcon (ícone da bandeja) -->
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\linkflow.ico</ApplicationIcon>
    <!-- DPI é configurado no app.manifest (PerMonitorV2) para o WPF; o aviso WFO0003 é só do WinForms -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
    <AssemblyName>LinkFlow.App</AssemblyName>
    <Product>LinkFlow</Product>
    <Version>3.0.0</Version>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Company>LinkFlow</Company>
    <!-- Strings.resx é o português; os outros idiomas vão em assemblies satélite (en\LinkFlow.App.resources.dll) -->
    <NeutralLanguage>pt-BR</NeutralLanguage>
    <Description>LinkFlow - controle de ventoinhas, RGB e LCD para Corsair iCUE LINK</Description>
      <!-- Baixo consumo: sem GC em segundo plano (thread e memória extras) -->
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <TieredPGO>true</TieredPGO>
  </PropertyGroup>

  <ItemGroup>
    <!-- Evita ambiguidades WPF x WinForms (Application, Button, Color...) -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\linkflow.ico" />
    <Resource Include="Assets\linkflow.png" />
  </ItemGroup>

  <!--
    Textos da interface: Resources\Strings.resx (português, idioma neutro) e Strings.<idioma>.resx.
    A classe Strings é gerada em Resources\Strings.Designer.cs, que fica no código-fonte: o projeto
    temporário do WPF (wpftmp), que compila o C# antes do XAML, só enxerga arquivos que existem quando
    o projeto é avaliado. Por isso a geração é feita aqui, e não pelo CoreResGen (que a criaria em obj).
  -->
  <Target Name="GenerateStringsClass" BeforeTargets="BeforeBuild"
          Inputs="Resources\Strings.resx" Outputs="Resources\Strings.Designer.cs">
    <MakeDir Directories="$(IntermediateOutputPath)" />
    <GenerateResource Sources="Resources\Strings.resx" OutputResources="$(IntermediateOutputPath)Strings.accessor.resources"
                      StronglyTypedLanguage="C#" StronglyTypedNamespace="LinkFlow.App.Resources"
                      StronglyTypedClassName="Strings" StronglyTypedFileName="Resources\Strings.Designer.cs"
                      PublicClass="true" ExecuteAsTool="false" />
  </Target>

</Project>
