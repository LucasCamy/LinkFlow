<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\LinkFlow.Core\LinkFlow.Core.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- WinForms apenas para o NotifyIcon (ícone da bandeja) -->
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\linkflow.ico</ApplicationIcon>
    <!-- DPI é configurado no app.manifest (PerMonitorV2) para o WPF; o aviso WFO0003 é só do WinForms -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
    <AssemblyName>LinkFlow.App</AssemblyName>
    <Product>LinkFlow</Product>
    <Version>2.0.0</Version>
    <Company>LinkFlow</Company>
    <Description>LinkFlow - controle de ventoinhas, RGB e LCD para Corsair iCUE LINK</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- Evita ambiguidades WPF x WinForms (Application, Button, Color...) -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\linkflow.ico" />
    <Resource Include="Assets\linkflow.png" />
  </ItemGroup>

</Project>
