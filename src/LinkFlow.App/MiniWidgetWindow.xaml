<Window x:Class="LinkFlow.App.MiniWidgetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LinkFlow Mini" Height="84" Width="360"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" WindowStartupLocation="Manual"
        Icon="pack://application:,,,/Assets/linkflow.ico"
        ToolTip="Clique duplo para abrir o LinkFlow • arraste para mover"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Window.ContextMenu>
        <ContextMenu>
            <MenuItem Header="Abrir LinkFlow" Click="OpenMain_Click" FontWeight="Bold"/>
            <MenuItem Header="Ocultar widget" Click="HideWidget_Click"/>
        </ContextMenu>
    </Window.ContextMenu>
    
    <Border Background="#E60F172A" BorderBrush="#00F0FF" BorderThickness="1" CornerRadius="16" Margin="4">
        <Grid Margin="12,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- CPU -->
            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock Text="CPU" Foreground="#94A3B8" FontSize="11" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding CpuTempFormatted}" Foreground="#38BDF8" FontSize="15" FontWeight="Bold"/>
                <TextBlock Text="{Binding CpuLoadFormatted, StringFormat='{}Uso: {0}'}" Foreground="#64748B" FontSize="10"/>
            </StackPanel>

            <!-- GPU -->
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="GPU" Foreground="#94A3B8" FontSize="11" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding GpuTempFormatted}" Foreground="#34D399" FontSize="15" FontWeight="Bold"/>
                <TextBlock Text="{Binding GpuLoadFormatted, StringFormat='{}Uso: {0}'}" Foreground="#64748B" FontSize="10"/>
            </StackPanel>

            <!-- RAM -->
            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                <TextBlock Text="RAM" Foreground="#94A3B8" FontSize="11" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding RamUsageFormatted}" Foreground="#A78BFA" FontSize="15" FontWeight="Bold"/>
                <TextBlock Text="{Binding RamDetail}" Foreground="#64748B" FontSize="10"/>
            </StackPanel>

            <!-- FANS -->
            <StackPanel Grid.Column="3" VerticalAlignment="Center">
                <TextBlock Text="FANS" Foreground="#94A3B8" FontSize="11" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding AverageFanRpmFormatted}" Foreground="#00F0FF" FontSize="14" FontWeight="Bold"/>
                <TextBlock Text="{Binding GlobalSpeedFormatted, StringFormat='{}Potência: {0}'}" Foreground="#64748B" FontSize="10"/>
            </StackPanel>

            <!-- Close / Return -->
            <Button Grid.Column="4" Content="✕" Width="20" Height="20" Margin="4,0,0,0"
                    VerticalAlignment="Top" HorizontalAlignment="Right"
                    Background="Transparent" Foreground="#64748B" BorderThickness="0"
                    Cursor="Hand" Click="CloseWidget_Click"/>
        </Grid>
    </Border>
</Window>
