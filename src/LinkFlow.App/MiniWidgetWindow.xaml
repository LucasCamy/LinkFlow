<Window x:Class="LinkFlow.App.MiniWidgetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LinkFlow Mini" Height="82" SizeToContent="Width" MinWidth="260"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" WindowStartupLocation="Manual"
        Icon="pack://application:,,,/Assets/linkflow.ico"
        ToolTip="Clique duplo para abrir o LinkFlow • arraste para mover • botão direito para opções"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        Opacity="{Binding MiniOpacity}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <Style x:Key="MiniLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextSubtleBrush}"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="MiniValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </Window.Resources>

    <Window.ContextMenu>
        <ContextMenu>
            <MenuItem Header="Abrir LinkFlow" Click="OpenMain_Click" FontWeight="Bold"/>
            <Separator/>
            <MenuItem Header="Métricas no Widget">
                <MenuItem Header="Processador (CPU)" IsCheckable="True" IsChecked="{Binding MiniShowCpu}"/>
                <MenuItem Header="Placa de Vídeo (GPU)" IsCheckable="True" IsChecked="{Binding MiniShowGpu}"/>
                <MenuItem Header="Líquido AIO" IsCheckable="True" IsChecked="{Binding MiniShowCoolant}"/>
                <MenuItem Header="Ventoinhas (RPM)" IsCheckable="True" IsChecked="{Binding MiniShowFans}"/>
                <MenuItem Header="Memória RAM" IsCheckable="True" IsChecked="{Binding MiniShowRam}"/>
                <MenuItem Header="Bomba Titan (RPM)" IsCheckable="True" IsChecked="{Binding MiniShowPump}"/>
            </MenuItem>
            <MenuItem Header="Opacidade">
                <MenuItem Header="100%" Click="Opacity_100_Click"/>
                <MenuItem Header="85%" Click="Opacity_85_Click"/>
                <MenuItem Header="70%" Click="Opacity_70_Click"/>
                <MenuItem Header="50%" Click="Opacity_50_Click"/>
            </MenuItem>
            <Separator/>
            <MenuItem Header="Ocultar widget" Click="HideWidget_Click"/>
        </ContextMenu>
    </Window.ContextMenu>

    <Border Background="#F00B1120" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="14" Margin="2">
        <StackPanel Orientation="Horizontal" Margin="14,8,8,8" VerticalAlignment="Center">
            <!-- CPU -->
            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0" Visibility="{Binding MiniShowCpu, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="CPU" Style="{StaticResource MiniLabel}"/>
                <TextBlock Text="{Binding CpuTempFormatted}" Style="{StaticResource MiniValue}" Foreground="{StaticResource CpuBrush}"/>
                <TextBlock Text="{Binding CpuLoadFormatted}" Style="{StaticResource MiniLabel}" FontWeight="Normal"/>
            </StackPanel>

            <!-- GPU -->
            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0" Visibility="{Binding MiniShowGpu, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="GPU" Style="{StaticResource MiniLabel}"/>
                <TextBlock Text="{Binding GpuTempFormatted}" Style="{StaticResource MiniValue}" Foreground="{StaticResource GpuBrush}"/>
                <TextBlock Text="{Binding GpuLoadFormatted}" Style="{StaticResource MiniLabel}" FontWeight="Normal"/>
            </StackPanel>

            <!-- Líquido AIO -->
            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0" Visibility="{Binding MiniShowCoolant, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="LÍQUIDO" Style="{StaticResource MiniLabel}"/>
                <TextBlock Text="{Binding CoolantTempFormatted}" Style="{StaticResource MiniValue}" Foreground="{StaticResource CoolantBrush}"/>
                <TextBlock Text="Titan AIO" Style="{StaticResource MiniLabel}" FontWeight="Normal"/>
            </StackPanel>

            <!-- Ventoinhas -->
            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0" Visibility="{Binding MiniShowFans, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="VENTOINHAS" Style="{StaticResource MiniLabel}"/>
                <TextBlock Text="{Binding AverageFanRpmFormatted}" Style="{StaticResource MiniValue}" Foreground="{StaticResource AccentBrush}"/>
                <TextBlock Style="{StaticResource MiniLabel}" FontWeight="Normal" TextTrimming="CharacterEllipsis">
                    <Run Text="{Binding GlobalSpeedFormatted, Mode=OneWay}"/><Run Text=" • "/><Run Text="{Binding ActivePresetLabel, Mode=OneWay}"/>
                </TextBlock>
            </StackPanel>

            <!-- RAM -->
            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0" Visibility="{Binding MiniShowRam, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="RAM" Style="{StaticResource MiniLabel}"/>
                <TextBlock Text="{Binding RamUsageFormatted}" Style="{StaticResource MiniValue}" Foreground="#A855F7"/>
                <TextBlock Text="{Binding RamDetail}" Style="{StaticResource MiniLabel}" FontWeight="Normal"/>
            </StackPanel>

            <!-- Bomba Titan -->
            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0" Visibility="{Binding MiniShowPump, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="BOMBA" Style="{StaticResource MiniLabel}"/>
                <TextBlock Text="{Binding PumpRpmFormatted}" Style="{StaticResource MiniValue}" Foreground="{StaticResource AccentBrush}"/>
                <TextBlock Text="Bomba iCUE" Style="{StaticResource MiniLabel}" FontWeight="Normal"/>
            </StackPanel>

            <!-- Botão fechar -->
            <Button Style="{StaticResource IconButton}" Width="26" Height="26" FontSize="9" Content="&#xE8BB;"
                    VerticalAlignment="Center" Margin="4,0,0,0" Click="CloseWidget_Click" ToolTip="Fechar widget e abrir o LinkFlow" AutomationProperties.Name="Fechar widget"/>
        </StackPanel>
    </Border>
</Window>
