<Window x:Class="LinkFlow.App.MiniWidgetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:LinkFlow.App.Views"
        xmlns:r="clr-namespace:LinkFlow.App.Resources"
        Title="{x:Static r:Strings.Mini_Title}" SizeToContent="WidthAndHeight"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        Topmost="{Binding AlwaysOnTop}" ShowInTaskbar="False" WindowStartupLocation="Manual" ShowActivated="False"
        Icon="pack://application:,,,/Assets/linkflow.ico"
        Opacity="{Binding Opacity}"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        ToolTip="{x:Static r:Strings.Mini_Tip}">
    <Window.ContextMenu>
        <ContextMenu>
            <MenuItem Header="{x:Static r:Strings.Mini_Open}" Click="OpenMain_Click" FontWeight="Bold"/>
            <MenuItem Header="{x:Static r:Strings.Mini_Customize}" Click="Configure_Click"/>
            <Separator/>
            <MenuItem Header="{x:Static r:Strings.Mini_LockPosition}" IsCheckable="True" IsChecked="{Binding LockPosition}"/>
            <MenuItem Header="{x:Static r:Strings.Mini_AlwaysOnTop}" IsCheckable="True" IsChecked="{Binding AlwaysOnTop}"/>
            <MenuItem Header="{x:Static r:Strings.Mini_ClickThrough}" IsCheckable="True" IsChecked="{Binding ClickThrough}"
                      ToolTip="{x:Static r:Strings.Mini_ClickThroughTip}"/>
            <Separator/>
            <MenuItem Header="{x:Static r:Strings.Mini_Hide}" InputGestureText="Ctrl+Alt+M" Click="HideWidget_Click"/>
        </ContextMenu>
    </Window.ContextMenu>

    <views:WidgetView Margin="2"/>
</Window>
