<Window x:Class="LinkFlow.App.MiniWidgetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:LinkFlow.App.Views"
        Title="LinkFlow Widget" SizeToContent="WidthAndHeight"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        Topmost="{Binding AlwaysOnTop}" ShowInTaskbar="False" WindowStartupLocation="Manual" ShowActivated="False"
        Icon="pack://application:,,,/Assets/linkflow.ico"
        Opacity="{Binding Opacity}"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        ToolTip="Arraste para mover • clique duplo abre o LinkFlow • botão direito: opções">
    <Window.ContextMenu>
        <ContextMenu>
            <MenuItem Header="Abrir LinkFlow" Click="OpenMain_Click" FontWeight="Bold"/>
            <MenuItem Header="Personalizar widget..." Click="Configure_Click"/>
            <Separator/>
            <MenuItem Header="Travar posição" IsCheckable="True" IsChecked="{Binding LockPosition}"/>
            <MenuItem Header="Sempre no topo" IsCheckable="True" IsChecked="{Binding AlwaysOnTop}"/>
            <MenuItem Header="Clique atravessa o widget" IsCheckable="True" IsChecked="{Binding ClickThrough}"
                      ToolTip="Para voltar a clicar nele: Ctrl+Alt+M duas vezes ou a aba Widget"/>
            <Separator/>
            <MenuItem Header="Ocultar widget" InputGestureText="Ctrl+Alt+M" Click="HideWidget_Click"/>
        </ContextMenu>
    </Window.ContextMenu>

    <views:WidgetView Margin="2"/>
</Window>
